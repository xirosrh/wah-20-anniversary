
script WahRoomsShared_EventScript_Shop {
    special(OpenWahRoomsSharedMart)
    waitstate
    msgbox(format("Thanks for visiting. Have a great day!"), MSGBOX_AUTOCLOSE)
    return
}

script WahRoomsShared_EventScript_Pokebox {
    lock
    waitse
    playse(SE_PC_ON)
    setmetatile(VAR_TEMP_C, VAR_TEMP_D, VAR_TEMP_F, FALSE)
    special(DrawWholeMapView)
    waitse
    delay(10)
    if (flag(FLAG_WAH_CHALLENGE_COMPLETED) && !flag(FLAG_LOBBY_POKEBOX_POST_WAH_UPDATE_SEEN)) {
        playse(SE_PC_LOGIN)
        msgbox(WahRoomsShared_Text_Pokebox_SoftwareUpdate, MSGBOX_AUTOCLOSE_CENTER)
        waitse
        delay(10)
        playse(SE_USE_ITEM)
        msgbox(WahRoomsShared_Text_Pokebox_SoftwareUpdateExplanation, MSGBOX_AUTOCLOSE_CENTER)
        waitse
        delay(20)
        setflag(FLAG_LOBBY_POKEBOX_POST_WAH_UPDATE_SEEN)

    }
    goto(WahRoomsShared_EventScript_Pokebox_MainMenu)
}

script WahRoomsShared_EventScript_Pokebox_MainMenu {
    playse(SE_PC_LOGIN)
    message(WahRoomsShared_Text_Pokebox_MainPrompt)
    waitmessage
    dynmultipush(format("Access PC"), 0)
    dynmultipush(format("How does it work?"), 1)
    dynmultipush(format("Discord"), 2)
    dynmultipush(format("Exit"), 3)
    dynmultistack(0, 0, FALSE, 4, 0, 0, DYN_MULTICHOICE_CB_NONE)
    closemessage
    delay(10)
    switch(var(VAR_RESULT)) {
        case 0:
            callnative(StartPokeBoxFromField_CB2)
            waitstate
            goto(WahRoomsShared_EventScript_Pokebox_Shutdown)
        case 1:
            goto(WahRoomsShared_EventScript_Pokebox_HelpMenu)
        case 2:
            goto(WahRoomsShared_EventScript_Pokebox_Discord)
        default:
            goto(WahRoomsShared_EventScript_Pokebox_Shutdown)
    }
}

script WahRoomsShared_EventScript_Pokebox_Discord {
    msgbox(format("Scan this QR code to visit the Whack a Hack community (https://whackahack.com).\pThere you can report any bugs you've found while doing this challenge, share your feedback, and meet a great community."))
    load_field_pic(FP_WAH_QR, 120, 80)
    waitbuttonpress
    closemessage
    destroy_field_pic(FP_WAH_QR)
    goto(WahRoomsShared_EventScript_Pokebox_MainMenu)

}

script WahRoomsShared_EventScript_Pokebox_HelpMenu {
    message(WahRoomsShared_Text_Pokebox_HelpPrompt)
    waitmessage
    dynmultipush(format("How many Pokémon can I swap?"), 0)
    dynmultipush(format("How do I unlock new Pokémon?"), 1)
    dynmultipush(format("Back"), 2)
    dynmultistack(0, 0, FALSE, 3, 0, 0, DYN_MULTICHOICE_CB_NONE)
    closemessage
    delay(10)
    switch(var(VAR_RESULT)) {
        case 0:
            if(flag(FLAG_WAH_CHALLENGE_COMPLETED) == TRUE) {
                msgbox(WahRoomsShared_Text_Pokebox_HelpSwapsAfterChallenge, MSGBOX_AUTOCLOSE)
            } else {
                msgbox(WahRoomsShared_Text_Pokebox_HelpSwapsBeforeChallenge, MSGBOX_AUTOCLOSE)
            }
            delay(10)
            goto(WahRoomsShared_EventScript_Pokebox_HelpMenu)
        case 1:
            msgbox(WahRoomsShared_Text_Pokebox_HelpUnlock, MSGBOX_AUTOCLOSE)
            delay(10)
            goto(WahRoomsShared_EventScript_Pokebox_HelpMenu)
        default:
            goto(WahRoomsShared_EventScript_Pokebox_MainMenu)
    }
}

script WahRoomsShared_EventScript_Pokebox_Shutdown {
    playse(SE_PC_OFF)
    setmetatile(VAR_TEMP_C, VAR_TEMP_D, VAR_TEMP_E, FALSE)
    special(DrawWholeMapView)
    call(Achievements_EventScript_Eval_UnlockAllPokemon)
    release
    return
}

text WahRoomsShared_Text_Pokebox_SoftwareUpdate {
    format("The PC software has been updated!")
}

text WahRoomsShared_Text_Pokebox_SoftwareUpdateExplanation {
    format("You can now swap up to 3 Pokémon in your party with Pokémon from the box, instead of just 1.")
}

text WahRoomsShared_Text_Pokebox_MainPrompt {
    "What do you want to do?"
}

text WahRoomsShared_Text_Pokebox_HelpPrompt {
    "What do you want to know about?"
}

text WahRoomsShared_Text_Pokebox_HelpSwapsBeforeChallenge {
    format("You can replace only one of the predefined Pokémon in the selected team with one from the box.\pYou can do this as many times as you like, but you'll always have at least 5 Pokémon from the original team.")
}

text WahRoomsShared_Text_Pokebox_HelpSwapsAfterChallenge {
    format("You can replace up to 3 predefined Pokémon in the selected team with Pokémon from the box.\pYou can do this as many times as you like, but you'll always have at least 3 Pokémon from the original team.")
}

text WahRoomsShared_Text_Pokebox_HelpUnlock {
    format("Some Pokémon are unlocked by buying them in the PC.\pOthers are obtained by advancing in the game, getting Achievements, or from special events.\pTo find out how to unlock a Pokémon, press {COLOR RED}A{COLOR DARK_GRAY} on its silhouette.")
}

script WahRoomsShared_OpenDoor {
    applymovementandwait(LOCALID_PLAYER, Common_Movement_Delay32)
	playse(SE_DOOR)
	setmetatile(6, 2, METATILE_RoomGeneral_Door_Opening1, FALSE)
	special(DrawWholeMapView)
	delay(5)
	setmetatile(6, 2, METATILE_RoomGeneral_Door_Opening2, FALSE)
    special(DrawWholeMapView)
	delay(5)
    setmetatile(6, 2, METATILE_RoomGeneral_Door_Open, FALSE)
    special(DrawWholeMapView)
	return
}

script WahRoomsShared_CloseDoor {
    applymovementandwait(LOCALID_PLAYER, Common_Movement_Delay32)
    playse(SE_DOOR)
    setmetatile(6, 2, METATILE_RoomGeneral_Door_Opening2, FALSE)
    special(DrawWholeMapView)
    delay(5)
    setmetatile(6, 2, METATILE_RoomGeneral_Door_Opening1, FALSE)
    special(DrawWholeMapView)
    delay(5)
    setmetatile(6, 2, METATILE_RoomGeneral_Door_Closed, TRUE)
    special(DrawWholeMapView)
    return
}

script WahRoomsShared_SetDoorAsOpen {
    setmetatile(6, 2, METATILE_RoomGeneral_Door_Open, FALSE)
    return
}

script WahRoomsShared_SetPlayerTeleportGfxVars {
    checkplayergender
    if (var(VAR_RESULT) == MALE) {
        setvar(VAR_TEMP_D, OBJ_EVENT_GFX_BRENDAN_NORMAL)
        setvar(VAR_TEMP_E, OBJ_EVENT_GFX_BRENDAN_TELEPORTING_1)
        setvar(VAR_TEMP_F, OBJ_EVENT_GFX_BRENDAN_TELEPORTING_2)
    } else {
        setvar(VAR_TEMP_D, OBJ_EVENT_GFX_MAY_NORMAL)
        setvar(VAR_TEMP_E, OBJ_EVENT_GFX_MAY_TELEPORTING_1)
        setvar(VAR_TEMP_F, OBJ_EVENT_GFX_MAY_TELEPORTING_2)
    }
    return
}

script WahRoomsShared_UpdatePlayerSpriteNormal {
    setvar(VAR_0x8004, LOCALID_PLAYER)
    copyvar(VAR_0x8005, VAR_TEMP_D)
    special(UpdateObjectEventSprite)
    return
}

script WahRoomsShared_UpdatePlayerSpriteTeleporting1 {
    setvar(VAR_0x8004, LOCALID_PLAYER)
    copyvar(VAR_0x8005, VAR_TEMP_E)
    special(UpdateObjectEventSprite)
    return
}

script WahRoomsShared_UpdatePlayerSpriteTeleporting2 {
    setvar(VAR_0x8004, LOCALID_PLAYER)
    copyvar(VAR_0x8005, VAR_TEMP_F)
    special(UpdateObjectEventSprite)
    return
}

// Kecleon - Tile

script WahRoomsShared_Kecleon {
    lock
    faceplayer
    checkitem(ITEM_DEVON_SCOPE)
    if(var(VAR_RESULT))
    {
        msgbox(Kecleon_Text_WantToUseDevonScope, MSGBOX_YESNO)
        if(var(VAR_RESULT))
        {
            msgbox(format("{PLAYER} used the Devon Detector.\pA POKéMON that was invisible\nhas become completely visible!"), MSGBOX_AUTOCLOSE)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_FacePlayer)
            applymovementandwait(VAR_LAST_TALKED, Movement_KecleonAppears)
            waitse
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, moves(emote_exclamation_mark))
            waitse
            playmoncry(SPECIES_KECLEON, CRY_MODE_NORMAL)
            delay(40)
            waitmoncry
            call(WahRoomsShared_Kecleon_Recompensa)
            fadescreen(FADE_TO_BLACK)
            removeobject(VAR_LAST_TALKED)
            fadescreen(FADE_FROM_BLACK)
            delay(20)
            if (!flag(FLAG_FOUND_TILE_KECLEON)) {
                setflag(FLAG_FOUND_TILE_KECLEON)
                call(Achievements_EventScript_Eval_FoundTileKecleon)
            }
        }
    }
    else
    {
        msgbox(Kecleon_Text_SomethingUnseeable, MSGBOX_DEFAULT)
    }
    release
    end
}

script WahRoomsShared_DevonScope_UseFromBag {
    lockall
    msgbox(format("{PLAYER} used the Devon Detector."), MSGBOX_DEFAULT)
    specialvar(VAR_RESULT, HasInvisibleKecleonOnCurrentMap)
    if (var(VAR_RESULT)) {
        msgbox(WahRoomsShared_DevonScope_Text_Detected, MSGBOX_DEFAULT)
    } else {
        msgbox(WahRoomsShared_DevonScope_Text_NotDetected, MSGBOX_DEFAULT)
    }
    releaseall
    end
}

text WahRoomsShared_DevonScope_Text_Detected {
    format("The detector reacts!\pAn invisible Pokémon is nearby.")
}

text WahRoomsShared_DevonScope_Text_NotDetected {
    format("It doesn't detect any invisible Pokémon nearby.")
}

script WahRoomsShared_Kecleon_Recompensa {
    random(2)
    switch(var(VAR_RESULT))
    {
        case 0:
            call(WahRoomsShared_Kecleon_Dinero)
            break
        case 1:
            call(WahRoomsShared_Kecleon_KitObjetos)
            break
    }

    return
}

script WahRoomsShared_Kecleon_Dinero {
    random(10)
    showmoneybox(0, 0)
    switch(var(VAR_RESULT))
    {
        case 0:
        case 1:
        case 2:
        case 3:
            addmoney(5000)
            setvar(VAR_RESULT, 0)
            break
        case 4:
        case 5:
        case 6:
            addmoney(8000)
            setvar(VAR_RESULT, 1)
            break
        case 7:
        case 8:
            addmoney(10000)
            setvar(VAR_RESULT, 2)
            break
        case 9:
            addmoney(15000)
            setvar(VAR_RESULT, 3)
            break
    }
    delay(30)
    playse(SE_SHOP)
    updatemoneybox
    switch(var(VAR_RESULT))
    {
        case 0:
            msgbox(format("Tile handed you ¥5000!"), MSGBOX_AUTOCLOSE)
            break
        case 1:
            msgbox(format("Tile handed you ¥8000!"), MSGBOX_AUTOCLOSE)
            break
        case 2:
            msgbox(format("Tile handed you ¥10000!"), MSGBOX_AUTOCLOSE)
            break
        case 3:
            msgbox(format("Tile handed you ¥15000!"), MSGBOX_AUTOCLOSE)
            break
    }
    hidemoneybox
    return
}

script WahRoomsShared_Kecleon_KitObjetos_BagFull {
    msgbox("Your BAG is full!\nTile couldn't give you the rest of the package.", MSGBOX_DEFAULT)
    closemessage
    return
}

script WahRoomsShared_Kecleon_KitObjetos {
    msgbox(format("Tile handed you a package of items!"), MSGBOX_DEFAULT)
    closemessage
    delay(10)
    random(3)
    switch(var(VAR_RESULT))
    {
        case 0:
            giveitem(ITEM_ABILITY_CAPSULE, 1)
            if (var(VAR_RESULT) == FALSE) {
                call(WahRoomsShared_Kecleon_KitObjetos_BagFull)
                return
            }
            giveitem(ITEM_MAX_REVIVE, 1)
            if (var(VAR_RESULT) == FALSE) {
                call(WahRoomsShared_Kecleon_KitObjetos_BagFull)
                return
            }
            giveitem(ITEM_REVIVE, 2)
            if (var(VAR_RESULT) == FALSE) {
                call(WahRoomsShared_Kecleon_KitObjetos_BagFull)
                return
            }
            giveitem(ITEM_FULL_RESTORE, 3)
            closemessage
            if (var(VAR_RESULT) == FALSE) {
                call(WahRoomsShared_Kecleon_KitObjetos_BagFull)
                return
            }
            break
        case 1:
            giveitem(ITEM_ABILITY_PATCH, 1)
            if (var(VAR_RESULT) == FALSE) {
                call(WahRoomsShared_Kecleon_KitObjetos_BagFull)
                return
            }
            giveitem(ITEM_REVIVE, 2)
            if (var(VAR_RESULT) == FALSE) {
                call(WahRoomsShared_Kecleon_KitObjetos_BagFull)
                return
            }
            giveitem(ITEM_MAX_POTION, 2)
            if (var(VAR_RESULT) == FALSE) {
                call(WahRoomsShared_Kecleon_KitObjetos_BagFull)
                return
            }
            giveitem(ITEM_FULL_HEAL, 2)
            closemessage
            if (var(VAR_RESULT) == FALSE) {
                call(WahRoomsShared_Kecleon_KitObjetos_BagFull)
                return
            }
            break
        case 2:
            giveitem(ITEM_ABILITY_CAPSULE, 2)
            if (var(VAR_RESULT) == FALSE) {
                call(WahRoomsShared_Kecleon_KitObjetos_BagFull)
                return
            }
            giveitem(ITEM_ABILITY_PATCH, 2)
            closemessage
            if (var(VAR_RESULT) == FALSE) {
                call(WahRoomsShared_Kecleon_KitObjetos_BagFull)
                return
            }
            break
    }
    return
}

