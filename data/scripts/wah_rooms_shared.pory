script WahRoomsShared_EventScript_Shop {
	pokemart(WahRoomsShared_MartItems)
	msgbox(format("Gracias por tu visita. ¡Que tengas un buen día!"), MSGBOX_AUTOCLOSE)
	return
}

script WahRoomsShared_EventScript_Pokebox {
    lock
    waitse
    playse(SE_PC_ON)
    setmetatile(VAR_TEMP_C, VAR_TEMP_D, VAR_TEMP_F, FALSE)
    special(DrawWholeMapView)
    waitse
    delay(10)
    if (flag(FLAG_WAH_CHALLENGE_COMPLETED) && !flag(FLAG_LOBBY_POKEBOX_POST_WAH_UPDATE_SEEN)) {
        playse(SE_PC_LOGIN)
        msgbox(WahRoomsShared_Text_Pokebox_SoftwareUpdate, MSGBOX_AUTOCLOSE_CENTER)
        waitse
        delay(10)
        playse(SE_USE_ITEM)
        msgbox(WahRoomsShared_Text_Pokebox_SoftwareUpdateExplanation, MSGBOX_AUTOCLOSE_CENTER)
        waitse
        delay(20)
        setflag(FLAG_LOBBY_POKEBOX_POST_WAH_UPDATE_SEEN)

    }
    goto(WahRoomsShared_EventScript_Pokebox_MainMenu)
}

script WahRoomsShared_EventScript_Pokebox_MainMenu {
    playse(SE_PC_LOGIN)
    message(WahRoomsShared_Text_Pokebox_MainPrompt)
    waitmessage
    dynmultipush(format("Acceder a PC"), 0)
    dynmultipush(format("¿Cómo funciona?"), 1)
    dynmultipush(format("Salir"), 2)
    dynmultistack(0, 0, FALSE, 3, 0, 0, DYN_MULTICHOICE_CB_NONE)
    closemessage
    delay(10)
    switch(var(VAR_RESULT)) {
        case 0:
            callnative(StartPokeBoxFromField_CB2)
            waitstate
            goto(WahRoomsShared_EventScript_Pokebox_Shutdown)
        case 1:
            goto(WahRoomsShared_EventScript_Pokebox_HelpMenu)
        default:
            goto(WahRoomsShared_EventScript_Pokebox_Shutdown)
    }
}

script WahRoomsShared_EventScript_Pokebox_HelpMenu {
    message(WahRoomsShared_Text_Pokebox_HelpPrompt)
    waitmessage
    dynmultipush(format("¿Cuántos Pokémon puedo cambiar?"), 0)
    dynmultipush(format("¿Cómo desbloqueo nuevos Pokémon?"), 1)
    dynmultipush(format("Volver"), 2)
    dynmultistack(0, 0, FALSE, 3, 0, 0, DYN_MULTICHOICE_CB_NONE)
    closemessage
    delay(10)
    switch(var(VAR_RESULT)) {
        case 0:
            if(flag(FLAG_WAH_CHALLENGE_COMPLETED) == TRUE) {
                msgbox(WahRoomsShared_Text_Pokebox_HelpSwapsAfterChallenge, MSGBOX_AUTOCLOSE)
            } else {
                msgbox(WahRoomsShared_Text_Pokebox_HelpSwapsBeforeChallenge, MSGBOX_AUTOCLOSE)
            }
            delay(10)
            goto(WahRoomsShared_EventScript_Pokebox_HelpMenu)
        case 1:
            msgbox(WahRoomsShared_Text_Pokebox_HelpUnlock, MSGBOX_AUTOCLOSE)
            delay(10)
            goto(WahRoomsShared_EventScript_Pokebox_HelpMenu)
        default:
            goto(WahRoomsShared_EventScript_Pokebox_MainMenu)
    }
}

script WahRoomsShared_EventScript_Pokebox_Shutdown {
    playse(SE_PC_OFF)
    setmetatile(VAR_TEMP_C, VAR_TEMP_D, VAR_TEMP_E, FALSE)
    special(DrawWholeMapView)
    call(Achievements_EventScript_Eval_UnlockAllPokemon)
    release
    return
}

text WahRoomsShared_Text_Pokebox_SoftwareUpdate {
    format("¡El software de la PC se ha actualizado!")
}

text WahRoomsShared_Text_Pokebox_SoftwareUpdateExplanation {
    format("Ahora puedes cambiar hasta 3 Pokémon de tu equipo y sustituirlos por Pokémon de la caja, en lugar de solo 1.")
}

text WahRoomsShared_Text_Pokebox_MainPrompt {
    "¿Qué quieres hacer?"
}

text WahRoomsShared_Text_Pokebox_HelpPrompt {
    "¿Sobre qué quieres saber?"
}

text WahRoomsShared_Text_Pokebox_HelpSwapsBeforeChallenge {
    format("Puedes reemplazar solo uno de los Pokémon predefinidos del equipo seleccionado por uno de la caja.\pPuedes hacerlo las veces que quieras, pero siempre tendrás al menos 5 Pokémon del equipo original.")
}

text WahRoomsShared_Text_Pokebox_HelpSwapsAfterChallenge {
    format("Puedes reemplazar hasta 3 Pokémon predefinidos del equipo seleccionado por Pokémon de la caja.\pPuedes hacerlo las veces que quieras, pero siempre tendrás al menos 3 Pokémon del equipo original.")

}

text WahRoomsShared_Text_Pokebox_HelpUnlock {
    format("Algunos Pokémon se desbloquean comprándolos en la PC.\pOtros, se obtienen avanzando en el juego, consiguiendo Logros o con eventos especiales.\pPara descubrir cómo desbloquear un Pokémon, presiona {COLOR RED}A{COLOR DARK_GRAY} en su sombra.")
}

