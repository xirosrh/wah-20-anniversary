script WahRoomsShared_OpenDoor {
    applymovementandwait(LOCALID_PLAYER, Common_Movement_Delay32)
	playse(SE_DOOR)
	setmetatile(6, 2, METATILE_RoomGeneral_Door_Opening1, FALSE)
	special(DrawWholeMapView)
	delay(5)
	setmetatile(6, 2, METATILE_RoomGeneral_Door_Opening2, FALSE)
    special(DrawWholeMapView)
	delay(5)
    setmetatile(6, 2, METATILE_RoomGeneral_Door_Open, FALSE)
    special(DrawWholeMapView)
	return
}

script WahRoomsShared_CloseDoor {
    applymovementandwait(LOCALID_PLAYER, Common_Movement_Delay32)
    playse(SE_DOOR)
    setmetatile(6, 2, METATILE_RoomGeneral_Door_Opening2, FALSE)
    special(DrawWholeMapView)
    delay(5)
    setmetatile(6, 2, METATILE_RoomGeneral_Door_Opening1, FALSE)
    special(DrawWholeMapView)
    delay(5)
    setmetatile(6, 2, METATILE_RoomGeneral_Door_Closed, TRUE)
    special(DrawWholeMapView)
    return
}

script WahRoomsShared_SetDoorAsOpen {
    setmetatile(6, 2, METATILE_RoomGeneral_Door_Open, FALSE)
    return
}

script WahRoomsShared_SetPlayerTeleportGfxVars {
    checkplayergender
    if (var(VAR_RESULT) == MALE) {
        setvar(VAR_TEMP_D, OBJ_EVENT_GFX_BRENDAN_NORMAL)
        setvar(VAR_TEMP_E, OBJ_EVENT_GFX_BRENDAN_TELEPORTING_1)
        setvar(VAR_TEMP_F, OBJ_EVENT_GFX_BRENDAN_TELEPORTING_2)
    } else {
        setvar(VAR_TEMP_D, OBJ_EVENT_GFX_MAY_NORMAL)
        setvar(VAR_TEMP_E, OBJ_EVENT_GFX_MAY_TELEPORTING_1)
        setvar(VAR_TEMP_F, OBJ_EVENT_GFX_MAY_TELEPORTING_2)
    }
    return
}

script WahRoomsShared_UpdatePlayerSpriteNormal {
    setvar(VAR_0x8004, LOCALID_PLAYER)
    copyvar(VAR_0x8005, VAR_TEMP_D)
    special(UpdateObjectEventSprite)
    return
}

script WahRoomsShared_UpdatePlayerSpriteTeleporting1 {
    setvar(VAR_0x8004, LOCALID_PLAYER)
    copyvar(VAR_0x8005, VAR_TEMP_E)
    special(UpdateObjectEventSprite)
    return
}

script WahRoomsShared_UpdatePlayerSpriteTeleporting2 {
    setvar(VAR_0x8004, LOCALID_PLAYER)
    copyvar(VAR_0x8005, VAR_TEMP_F)
    special(UpdateObjectEventSprite)
    return
}

// Kecleon - Tile

script WahRoomsShared_Kecleon {
    lock
    faceplayer
    checkitem(ITEM_DEVON_SCOPE)
    if(var(VAR_RESULT))
    {
        msgbox(Kecleon_Text_WantToUseDevonScope, MSGBOX_YESNO)
        if(var(VAR_RESULT))
        {
            msgbox(format("{PLAYER} usó el Detector Devon.\p¡Un POKéMON que era invisible\nse ha vuelto completamente visible!"), MSGBOX_AUTOCLOSE)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_FacePlayer)
            applymovementandwait(VAR_LAST_TALKED, Movement_KecleonAppears)
            waitse
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, moves(emote_exclamation_mark))
            waitse
            playmoncry(SPECIES_KECLEON, CRY_MODE_NORMAL)
            delay(40)
            waitmoncry
            call(WahRoomsShared_Kecleon_Recompensa)
            fadescreen(FADE_TO_BLACK)
            removeobject(VAR_LAST_TALKED)
            fadescreen(FADE_FROM_BLACK)
            delay(20)
            if (!flag(FLAG_FOUND_TILE_KECLEON)) {
                setflag(FLAG_FOUND_TILE_KECLEON)
                call(Achievements_EventScript_Eval_FoundTileKecleon)
            }
        }
    }
    else
    {
        msgbox(Kecleon_Text_SomethingUnseeable, MSGBOX_DEFAULT)
    }
    release
    end
}

script WahRoomsShared_Kecleon_Recompensa {
    random(2)
    switch(var(VAR_RESULT))
    {
        case 0:
            call(WahRoomsShared_Kecleon_Dinero)
            break
        case 1:
            call(WahRoomsShared_Kecleon_KitCuracion)
            break
    }

    return
}

script WahRoomsShared_Kecleon_Dinero {
    random(10)
    showmoneybox(0, 0)
    switch(var(VAR_RESULT))
    {
        case 0:
        case 1:
        case 2:
        case 3:
            addmoney(5000)
            setvar(VAR_RESULT, 0)
            break
        case 4:
        case 5:
        case 6:
            addmoney(8000)
            setvar(VAR_RESULT, 1)
            break
        case 7:
        case 8:
            addmoney(10000)
            setvar(VAR_RESULT, 2)
            break
        case 9:
            addmoney(15000)
            setvar(VAR_RESULT, 3)
            break
    }
    delay(30)
    playse(SE_SHOP)
    updatemoneybox
    switch(var(VAR_RESULT))
    {
        case 0:
            msgbox(format("¡Tile te ha entregado 5000¥!"), MSGBOX_AUTOCLOSE)
            break
        case 1:
            msgbox(format("¡Tile te ha entregado 8000¥!"), MSGBOX_AUTOCLOSE)
            break
        case 2:
            msgbox(format("¡Tile te ha entregado 10000¥!"), MSGBOX_AUTOCLOSE)
            break
        case 3:
            msgbox(format("¡Tile te ha entregado 15000¥!"), MSGBOX_AUTOCLOSE)
            break
    }
    hidemoneybox
    return
}

script WahRoomsShared_Kecleon_KitCuracion_BagFull {
    msgbox("¡Tu MOCHILA está llena!\nTile no pudo dejarte el resto del kit.", MSGBOX_DEFAULT)
    closemessage
    return
}

script WahRoomsShared_Kecleon_KitCuracion {
    msgbox(format("¡Tile te ha entregado un kit de curación!"), MSGBOX_DEFAULT)
    closemessage
    delay(10)
    random(2)
    switch(var(VAR_RESULT))
    {
        case 0:
            giveitem(ITEM_MAX_REVIVE, 1)
            if (var(VAR_RESULT) == FALSE) {
                call(WahRoomsShared_Kecleon_KitCuracion_BagFull)
                return
            }
            giveitem(ITEM_REVIVE, 2)
            if (var(VAR_RESULT) == FALSE) {
                call(WahRoomsShared_Kecleon_KitCuracion_BagFull)
                return
            }
            giveitem(ITEM_FULL_RESTORE, 3)
            closemessage
            if (var(VAR_RESULT) == FALSE) {
                call(WahRoomsShared_Kecleon_KitCuracion_BagFull)
                return
            }
            break
        case 1:
            giveitem(ITEM_REVIVE, 2)
            if (var(VAR_RESULT) == FALSE) {
                call(WahRoomsShared_Kecleon_KitCuracion_BagFull)
                return
            }
            giveitem(ITEM_MAX_POTION, 2)
            if (var(VAR_RESULT) == FALSE) {
                call(WahRoomsShared_Kecleon_KitCuracion_BagFull)
                return
            }
            giveitem(ITEM_FULL_HEAL, 2)
            closemessage
            if (var(VAR_RESULT) == FALSE) {
                call(WahRoomsShared_Kecleon_KitCuracion_BagFull)
                return
            }
            break
    }
    return
}

