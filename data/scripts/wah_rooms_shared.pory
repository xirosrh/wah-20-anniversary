            setobjectxyperm(LOCALID_ZEROROOM_KECLEON, 3, 7)
            break
        case 2:
            setobjectxyperm(LOCALID_ZEROROOM_KECLEON, 2, 11)
            break
        case 3:
            setobjectxyperm(LOCALID_ZEROROOM_KECLEON, 9, 9)
            break
        default: 
            break
    }
    return
}

