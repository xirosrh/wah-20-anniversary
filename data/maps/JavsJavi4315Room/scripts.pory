const VAR_TEMP_2_JAVS_JAVI4315_ROOM_STATE = VAR_TEMP_2

mapscripts JavsJavi4315Room_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: JavsJavi4315Room_OnTransition
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_8, 0: JavsJavi4315Room_OnWarp_PlayerTurnNorth
    ]
    MAP_SCRIPT_ON_LOAD: JavsJavi4315Room_OnLoad
}

script JavsJavi4315Room_OnLoad {
    if(flag(FLAG_DEFEATED_ADMINS_JAVI4315_AND_JAVS)) {
        call(WahRoomsShared_SetDoorAsOpen)
    }
    end
}

script JavsJavi4315Room_OnTransition {
    call(WahRoomsShared_Kecleon_SetSala_JavsJavi)
    if(!flag(FLAG_DEFEATED_ADMINS_JAVI4315_AND_JAVS)) {
        setobjectxy(LOCALID_JAVSJAVIROOM_JAVI4315, 2, 3)
        setobjectxy(LOCALID_JAVSJAVIROOM_JAVS, 3, 3)
        setobjectxyperm(LOCALID_JAVSJAVIROOM_JAVI4315, 2, 3)
        setobjectxyperm(LOCALID_JAVSJAVIROOM_JAVS, 3, 3)
        setobjectmovementtype(LOCALID_JAVSJAVIROOM_JAVI4315, MOVEMENT_TYPE_FACE_UP)
        setobjectmovementtype(LOCALID_JAVSJAVIROOM_JAVS, MOVEMENT_TYPE_FACE_UP)
    } else {
        setobjectmovementtype(LOCALID_JAVSJAVIROOM_JAVI4315, MOVEMENT_TYPE_FACE_DOWN)
        setobjectmovementtype(LOCALID_JAVSJAVIROOM_JAVS, MOVEMENT_TYPE_FACE_DOWN)
    }
    end
}

script JavsJavi4315Room_OnWarp_PlayerTurnNorth {
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    end
}

script JavsJavi4315Room_EventScript_MainTrigger {
    lockall
    if(flag(FLAG_DEFEATED_ADMINS_JAVI4315_AND_JAVS)) {
        releaseall
        end
    }
    directmovementtopos(LOCALID_PLAYER, 6, 7)
    waitmovement(0)
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
    special(SpawnCameraObject)
    directcameramovementtopos(3, 4)
    waitmovement(0)
    msgbox(format("Dude… what amazing tiles they gave us in here!"), speaker = SP_NAME_JAVI4315)
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_JAVSJAVIROOM_JAVI4315, moves(lock_facing_direction, jump_in_place_up))
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_JAVSJAVIROOM_JAVI4315, moves(jump_in_place_up, unlock_facing_direction))
    waitse
    turnobject(LOCALID_JAVSJAVIROOM_JAVI4315, DIR_EAST)
    msgbox(format("They're super cool, right, Javier?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_JAVI4315)
    playse(SE_PIN)
    applymovementandwait(LOCALID_JAVSJAVIROOM_JAVS, Common_Movement_AngryWithDelay48)
    delay(30)
    turnobject(LOCALID_JAVSJAVIROOM_JAVS, DIR_WEST)
    msgbox(format("My name's not Javier…"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_JAVS)
    applymovementandwait(LOCALID_JAVSJAVIROOM_JAVS, Common_Movement_WalkInPlaceLeft)
    delay(30)
    turnobject(LOCALID_JAVSJAVIROOM_JAVI4315, DIR_NORTH)
    turnobject(LOCALID_JAVSJAVIROOM_JAVS, DIR_NORTH)
    msgbox(format("And that's not all - look at those palettes! So well contrasted and shaded… are they private?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_JAVI4315)
    playse(SE_PIN)
    applymovementandwait(LOCALID_JAVSJAVIROOM_JAVS, Common_Movement_AnnoyedWithDelay48)
    delay(50)
    applymovementandwait(LOCALID_PLAYER, Common_Movement_WalkInPlaceUp)
    turnobject(LOCALID_JAVSJAVIROOM_JAVI4315, DIR_SOUTH)
    turnobject(LOCALID_JAVSJAVIROOM_JAVS, DIR_SOUTH)
    playse(SE_PIN)
    applymovement(LOCALID_JAVSJAVIROOM_JAVI4315, Common_Movement_DoubleExclamationMarkWithDelay48)
    applymovement(LOCALID_JAVSJAVIROOM_JAVS, Common_Movement_DoubleExclamationMarkWithDelay48)
    waitmovement(0)
    waitse
    applymovement(LOCALID_JAVSJAVIROOM_JAVI4315, moves(walk_down, walk_right * 2, walk_right, walk_down, delay_16))
    applymovement(LOCALID_JAVSJAVIROOM_JAVS, moves(walk_down, walk_right * 4, walk_down ))
    waitmovement(0)
    setobjectxyperm(LOCALID_JAVSJAVIROOM_JAVI4315, 5, 5)
    setobjectxyperm(LOCALID_JAVSJAVIROOM_JAVS, 7, 5)
    directcameramovementtoposwithvars(VAR_TEMP_0, VAR_TEMP_1)
    waitmovement(0)
    special(RemoveCameraObject)
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_JAVSJAVIROOM_JAVI4315,moves(jump_in_place_down))
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_JAVSJAVIROOM_JAVI4315,moves(jump_in_place_down))
    waitse
    msgbox(format("Well… someone finally wandered in here!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_JAVI4315)
    applymovementandwait(LOCALID_JAVSJAVIROOM_JAVS, Common_Movement_WalkInPlaceDown)
    delay(20)
    msgbox(format("Did you know that, of all the misfortunes that could've happened to you today, landing on our floor was the worst?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_JAVS)
    delay(20)
    playbgm(MUS_ENCOUNTER_MAGMA, FALSE)
    applymovementandwait(LOCALID_JAVSJAVIROOM_JAVI4315, Common_Movement_WalkInPlaceDown)
    msgbox(format("You've never seen a team battle like ours, not even in your wildest dreams…\pAnd you won't see it again, so enjoy it!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_JAVI4315)
    delay(20)
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_JAVSJAVIROOM_JAVS, Common_Movement_JumpInPlaceDown)
    waitse
    msgbox(format("Here strategy rules - don't you forget it!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_JAVS)
    delay(20)
    applymovementandwait(LOCALID_JAVSJAVIROOM_JAVI4315, Common_Movement_WalkInPlaceDown)
    msgbox(format("Ready, Javs?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_JAVI4315)
    delay(10)
    applymovementandwait(LOCALID_JAVSJAVIROOM_JAVS, Common_Movement_WalkInPlaceDown)
    msgbox(format("Ready, Javi69!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_JAVS)
    turnobject(LOCALID_JAVSJAVIROOM_JAVI4315, DIR_EAST)
    playse(SE_PIN)
    applymovementandwait(LOCALID_JAVSJAVIROOM_JAVI4315, Common_Movement_QuestionMarkWithDelay48)
    waitse
    delay(20)
    turnobject(LOCALID_JAVSJAVIROOM_JAVI4315, DIR_SOUTH)
    delay(30)
    applymovement(LOCALID_JAVSJAVIROOM_JAVI4315, Common_Movement_WalkDown)
    applymovement(LOCALID_JAVSJAVIROOM_JAVS, Common_Movement_WalkDown)
    waitmovement(0)
    msgbox(format("Now!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_JAVS)
    playse(SE_LEDGE)
    applymovement(LOCALID_JAVSJAVIROOM_JAVI4315, moves(jump_in_place_down))
    applymovement(LOCALID_JAVSJAVIROOM_JAVS, moves(jump_in_place_down))
    waitmovement(0)
    waitse
    playse(SE_LEDGE)
    applymovement(LOCALID_JAVSJAVIROOM_JAVI4315, moves(jump_in_place_down, delay_16))
    applymovement(LOCALID_JAVSJAVIROOM_JAVS, moves(jump_in_place_down, delay_16))
    waitmovement(0)
    waitse
    playse(SE_PIN)
    applymovement(LOCALID_JAVSJAVIROOM_JAVI4315, moves(emote_versus))
    applymovement(LOCALID_JAVSJAVIROOM_JAVS, moves(emote_versus))
    waitmovement(0)
    waitse
    call(JavsJavi4315Room_EventScript_JavsJavi4315Battle)
    call(JavsJavi4315Room_EventScript_PostBattle)
    releaseall
    end
}

script JavsJavi4315Room_EventScript_JavsJavi4315Battle {
      if (!flag(FLAG_WAH_CHALLENGE_COMPLETED)) {
        trainerbattle_two_trainers(TRAINER_WAH_ADMIN_JAVI4315_MAIN, JavsJavi4315Room_Text_Javi4315Defeated , TRAINER_WAH_ADMIN_JAVS_MAIN, JavsJavi4315Room_Text_JavsDefeated)
    } else {
        setvar(VAR_0x8004, TEAM_INDEX_JAVI4315)
        special(ShouldUseAlternativeTeam)
        copyvar(VAR_0x8005, VAR_RESULT)
        setvar(VAR_0x8004, TEAM_INDEX_JAVS)
        special(ShouldUseAlternativeTeam)
        // VAR_0x8005 = Javi4315 team, VAR_RESULT = Javs team
        if (var(VAR_0x8005) == 0) {
            if (var(VAR_RESULT) == 0) {
                trainerbattle_two_trainers(TRAINER_WAH_ADMIN_JAVI4315_MAIN, JavsJavi4315Room_Text_Javi4315Defeated , TRAINER_WAH_ADMIN_JAVS_MAIN, JavsJavi4315Room_Text_JavsDefeated)
            } else {
                trainerbattle_two_trainers(TRAINER_WAH_ADMIN_JAVI4315_MAIN, JavsJavi4315Room_Text_Javi4315Defeated , TRAINER_WAH_ADMIN_JAVS_ALTERNATIVE, JavsJavi4315Room_Text_JavsDefeated)
            }
        } else {
            if (var(VAR_RESULT) == 0) {
                trainerbattle_two_trainers(TRAINER_WAH_ADMIN_JAVI4315_ALTERNATIVE, JavsJavi4315Room_Text_Javi4315Defeated , TRAINER_WAH_ADMIN_JAVS_MAIN, JavsJavi4315Room_Text_JavsDefeated)
            } else {
                trainerbattle_two_trainers(TRAINER_WAH_ADMIN_JAVI4315_ALTERNATIVE, JavsJavi4315Room_Text_Javi4315Defeated , TRAINER_WAH_ADMIN_JAVS_ALTERNATIVE, JavsJavi4315Room_Text_JavsDefeated)
            }
        }
    }
    return
}

text JavsJavi4315Room_Text_Javi4315Defeated {
    format("Did we actually lose, Javs?")
}

text JavsJavi4315Room_Text_JavsDefeated {
    format("How can this be? My strategy was foolproof!")
}

script JavsJavi4315Room_EventScript_PostBattle {
    playse(SE_PIN)
    applymovement(LOCALID_JAVSJAVIROOM_JAVS, moves(emote_surprise, lock_facing_direction, walk_up, unlock_facing_direction, face_down))
    applymovement(LOCALID_JAVSJAVIROOM_JAVI4315, moves(emote_surprise, lock_facing_direction, walk_up, unlock_facing_direction, face_down))
    waitmovement(0)
    delay(40)
    applymovementandwait(LOCALID_JAVSJAVIROOM_JAVS, Common_Movement_WalkInPlaceDown)
    msgbox(format("I spent weeks planning this strategy…\pI admit that hurt more than I expected."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_JAVS)
    playse(SE_PIN)
    applymovementandwait(LOCALID_JAVSJAVIROOM_JAVS, Common_Movement_SweatDropWithDelay48)
    waitse
    turnobject(LOCALID_JAVSJAVIROOM_JAVI4315, DIR_EAST)
    applymovementandwait(LOCALID_JAVSJAVIROOM_JAVI4315, Common_Movement_WalkInPlaceRight)
    msgbox(format("And I built my team exactly like you asked me to!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_JAVI4315)
    applymovementandwait(LOCALID_JAVSJAVIROOM_JAVS, Common_Movement_WalkUp)
    msgbox(format("The opening was perfect: sun up and pressure from turn one.\pWhat could I have done wrong?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_JAVS)
    playse(SE_PIN)
    applymovementandwait(LOCALID_JAVSJAVIROOM_JAVS, Common_Movement_ThinkingWithDelay48)
    delay(20)
    applymovementandwait(LOCALID_JAVSJAVIROOM_JAVS, moves(walk_down, delay_16, face_left))
    msgbox(format("The strategy was fine, but we simply had an opponent that was too strong."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_JAVS)
    delay(20)
    playse(SE_PIN)
    applymovementandwait(LOCALID_JAVSJAVIROOM_JAVI4315, moves(emote_happy))
    waitse
    msgbox(format("At least we had fun!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_JAVI4315)
    applymovementandwait(LOCALID_JAVSJAVIROOM_JAVI4315, moves(walk_in_place_right, delay_16 * 2))
    delay(20)
    turnobject(LOCALID_JAVSJAVIROOM_JAVI4315, DIR_SOUTH)
    turnobject(LOCALID_JAVSJAVIROOM_JAVS, DIR_SOUTH)
    delay(10)
    applymovementandwait(LOCALID_JAVSJAVIROOM_JAVS, Common_Movement_WalkInPlaceDown)
    msgbox(format("We'll open the door for you - you're less than halfway from the end now."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_JAVS)
    call(WahRoomsShared_OpenDoor)
    delay(30)
    applymovementandwait(LOCALID_JAVSJAVIROOM_JAVI4315, Common_Movement_WalkInPlaceDown)
    msgbox(format("We'll stay around here admiring the room."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_JAVI4315)
    setobjectmovementtype(LOCALID_JAVSJAVIROOM_JAVI4315, MOVEMENT_TYPE_FACE_DOWN)
    setobjectmovementtype2(LOCALID_JAVSJAVIROOM_JAVI4315, MOVEMENT_TYPE_FACE_DOWN)
    setobjectmovementtype(LOCALID_JAVSJAVIROOM_JAVS, MOVEMENT_TYPE_FACE_DOWN)
    setobjectmovementtype2(LOCALID_JAVSJAVIROOM_JAVS, MOVEMENT_TYPE_FACE_DOWN)
    setflag(FLAG_DEFEATED_ADMINS_JAVI4315_AND_JAVS)
    setvar(VAR_TEMP_2_JAVS_JAVI4315_ROOM_STATE, 1)
    call(WahRoomsShared_EventScript_AfterBattle)
    return
}

script JavsJavi4315Room_EventScript_Javi4315 {
    msgbox(format("I always wanted to create something that felt {COLOR GREEN}immortal{COLOR DARK_GRAY}.\pI guess that's why I'm still here, turning it all over in my head."), MSGBOX_NPC, speaker = SP_NAME_JAVI4315)
    end
}

script JavsJavi4315Room_EventScript_Javs {
    msgbox(format("Do you like how the room looks?\pDon't you dare copy its colors without my permission!"), MSGBOX_NPC, speaker = SP_NAME_JAVS)
    end
}

