mapscripts DriveKatherineRoom_MapScripts {
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_8, 0: DriveKatherineRoom_OnWarp_PlayerTurnNorth
    ]
    MAP_SCRIPT_ON_LOAD: DriveKatherineRoom_OnLoad
    MAP_SCRIPT_ON_TRANSITION : DriveKatherineRoom_OnTransition
}

script DriveKatherineRoom_OnLoad {
    if(flag(FLAG_DEFEATED_ADMINS_KATHERINE_AND_DRIVE)) {
        call(WahRoomsShared_SetDoorAsOpen)
    }
    end
}

script DriveKatherineRoom_OnWarp_PlayerTurnNorth {
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    end
}

script DriveKatherineRoom_OnTransition {
    call(WahRoomsShared_Kecleon_SetSala_DriveKatherine)
    end
}

script DriveKatherineRoom_EventScript_Katherine {
    if(flag(FLAG_DEFEATED_ADMINS_KATHERINE_AND_DRIVE)) {
        lock
        faceplayer
        msgbox(format("Those who feel welcome always come back.\pThanks for stopping by again."), MSGBOX_AUTOCLOSE, SP_NAME_KATHERINE)
        playse(SE_PIN)
        applymovementandwait(LOCALID_DRIVEKATHERINEROOM_KATHERINE, Common_Movement_HeartWithDelay48)
        msgbox(format("Meow revoir!"), MSGBOX_AUTOCLOSE, SP_NAME_KATHERINE)
        release
        end
    }
    lock
    faceplayer
        msgbox(format("Oh, hi there. Welcome to this room; here everything's set up to celebrate."), MSGBOX_AUTOCLOSE, SP_NAME_KATHERINE)
    playse(SE_PIN)
    applymovementandwait(LOCALID_DRIVEKATHERINEROOM_KATHERINE, Common_Movement_HappyWithDelay48)
    msgbox(format("So you want to beat this challenge?"), MSGBOX_AUTOCLOSE, SP_NAME_KATHERINE)
    call(DriveKatherineRoom_EventScript_PlayerWalkInPlace)
    delay(20)
    msgbox(format("Perfect. I'd be delighted to lend you a paw… I mean, a hand."), MSGBOX_AUTOCLOSE, SP_NAME_KATHERINE)
    playse(SE_PIN)
    applymovementandwait(LOCALID_DRIVEKATHERINEROOM_KATHERINE, Common_Movement_HeartWithDelay48)
    msgbox(format("But first, you should talk to Drive. He's got his speech ready… and believe me, he's dying to deliver it."), MSGBOX_AUTOCLOSE, SP_NAME_KATHERINE)
    turnobject(LOCALID_DRIVEKATHERINEROOM_KATHERINE, DIR_SOUTH)
    release
    end
}

script DriveKatherineRoom_EventScript_PlayerWalkInPlace {
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    switch(var(VAR_RESULT)) {
        case DIR_NORTH:
            applymovementandwait(LOCALID_PLAYER, Common_Movement_WalkInPlaceUp)
            break
        case DIR_SOUTH:
            applymovementandwait(LOCALID_PLAYER, Common_Movement_WalkInPlaceDown)
            break
        case DIR_WEST:
            applymovementandwait(LOCALID_PLAYER, Common_Movement_WalkInPlaceLeft)
            break
        case DIR_EAST:
            applymovementandwait(LOCALID_PLAYER, Common_Movement_WalkInPlaceRight)
            break
    }
    return
}

script DriveKatherineRoom_EventScript_Drive {
    if(flag(FLAG_DEFEATED_ADMINS_KATHERINE_AND_DRIVE)) {
        lock
        faceplayer
        msgbox(format("Ah, the guest of honor returns!"), MSGBOX_AUTOCLOSE, SP_NAME_DRIVE)
        playse(SE_PIN)
        applymovementandwait(LOCALID_DRIVEKATHERINEROOM_DRIVE, Common_Movement_HappyWithDelay48)
        msgbox(format("If you're here for another duel, I'm afraid the kitchen is already closed."), MSGBOX_AUTOCLOSE, SP_NAME_DRIVE)
        release
        end
    }
    lock
    faceplayer
    playse(SE_PIN)
    applymovementandwait(LOCALID_DRIVEKATHERINEROOM_DRIVE, moves(
        emote_double_exclamation_mark, 
        lock_facing_direction))
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_DRIVEKATHERINEROOM_DRIVE, moves(jump_in_place_down))
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_DRIVEKATHERINEROOM_DRIVE, moves(
        jump_in_place_down,
        unlock_facing_direction
        face_player))
    msgbox(format("Ah, at last a diner with an appetite for a party!"), MSGBOX_AUTOCLOSE, SP_NAME_DRIVE)
    delay(30)
    msgbox(format("Come, we've got a special seat for you."), MSGBOX_AUTOCLOSE, SP_NAME_DRIVE)
    call(DriveKatherineRoom_EventScript_WalkInPlaceDriveFacingPlayer)
    delay(10)
    turnobject(LOCALID_DRIVEKATHERINEROOM_DRIVE, DIR_SOUTH)
    delay(20)
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    switch(var(VAR_RESULT)) {
        case DIR_NORTH:
            applymovementandwait(LOCALID_PLAYER, moves(walk_down, walk_right))
            break
        case DIR_SOUTH:
            applymovementandwait(LOCALID_PLAYER, moves(walk_right, walk_down * 3))
            break
        case DIR_WEST:
            applymovementandwait(LOCALID_PLAYER, moves(walk_down * 2))
            break
        case DIR_EAST:
            applymovementandwait(LOCALID_PLAYER, moves(walk_down * 2, walk_right * 2))
            break
    }
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    delay(40)
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_DRIVEKATHERINEROOM_DRIVE, Common_Movement_JumpDown)
    waitse
    msgbox(format("Welcome to the grand restaurant of the celebration.\pHere we serve freshly made emotions and memories slow-cooked over low heat.\pMy name is Drive, and today I'll be your chef and maître d' of the banquet.\pToday, the main course is YOU!"), MSGBOX_AUTOCLOSE, SP_NAME_DRIVE)
    applymovementandwait(LOCALID_DRIVEKATHERINEROOM_DRIVE, Common_Movement_WalkInPlaceDown)
    delay(30)
    msgbox(format("Every dish tells a story, and every battle… a recipe for the soul!"), MSGBOX_AUTOCLOSE, SP_NAME_DRIVE)
    playse(SE_PIN)
    applymovementandwait(LOCALID_DRIVEKATHERINEROOM_DRIVE, moves(emote_smile))
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_DRIVEKATHERINEROOM_DRIVE, moves(jump_in_place_down))
    msgbox(format("We'll start with an appetizer of enthusiasm, a touch of curiosity, and a pinch of madness."), MSGBOX_AUTOCLOSE, SP_NAME_DRIVE)
    waitse
    playse(SE_PIN)
    applymovementandwait(LOCALID_DRIVEKATHERINEROOM_KATHERINE, Common_Movement_SurpriseWithDelay48)
    msgbox(format("Then, the main course: a delicious double duel."), MSGBOX_AUTOCLOSE, SP_NAME_DRIVE)
    applymovementandwait(LOCALID_DRIVEKATHERINEROOM_DRIVE, Common_Movement_WalkInPlaceDown)
    delay(30)
    turnobject(LOCALID_DRIVEKATHERINEROOM_DRIVE, DIR_EAST)
    msgbox(format("Katherine, are the ingredients ready?"), MSGBOX_AUTOCLOSE, SP_NAME_DRIVE)
    applymovementandwait(LOCALID_DRIVEKATHERINEROOM_DRIVE, Common_Movement_WalkInPlaceRight)
    delay(20)
    applymovementandwait(LOCALID_DRIVEKATHERINEROOM_KATHERINE, moves(walk_down, face_left))
    msgbox(format("All chopped and prepped, Drive."), MSGBOX_AUTOCLOSE, SP_NAME_KATHERINE)
    playse(SE_PIN)
    applymovementandwait(LOCALID_DRIVEKATHERINEROOM_KATHERINE, Common_Movement_HeartWithDelay48)
    delay(20)
    msgbox(format("But remember: it's not all about winning.\pWhat matters is moving with grace… and always landing on your feet.\pLet's welcome them as they deserve."), MSGBOX_AUTOCLOSE, SP_NAME_KATHERINE)
    applymovementandwait(LOCALID_DRIVEKATHERINEROOM_KATHERINE, Common_Movement_WalkInPlaceDown)
    turnobject(LOCALID_DRIVEKATHERINEROOM_DRIVE, DIR_SOUTH)
    msgbox(format("Then, let the banquet begin!"), MSGBOX_AUTOCLOSE, SP_NAME_DRIVE)
    applymovementandwait(LOCALID_DRIVEKATHERINEROOM_DRIVE, Common_Movement_WalkInPlaceDown)
    msgbox(format("Two chefs, one banquet, a new challenge.\pTo your stoves, Trainer!"), MSGBOX_AUTOCLOSE, SP_NAME_DRIVE)
    playse(SE_LEDGE)
    applymovement(LOCALID_DRIVEKATHERINEROOM_DRIVE, moves(emote_versus, jump_in_place_down))
    applymovement(LOCALID_DRIVEKATHERINEROOM_KATHERINE, moves(emote_versus, jump_in_place_down))
    waitmovement(0)
    waitse
    call(DriveKatherineRoom_EventScript_DriveKatherineBattle)
    playse(SE_PIN)
    applymovement(LOCALID_DRIVEKATHERINEROOM_DRIVE, DriveKatherineRoom_Movement_SurpriseAfterBattleEmote)
    applymovement(LOCALID_DRIVEKATHERINEROOM_KATHERINE, DriveKatherineRoom_Movement_SurpriseAfterBattleEmote)
    waitmovement(0)
    playse(SE_LEDGE)
    applymovement(LOCALID_DRIVEKATHERINEROOM_DRIVE, DriveKatherineRoom_Movement_SurpriseAfterBattleJump)
    applymovement(LOCALID_DRIVEKATHERINEROOM_KATHERINE, DriveKatherineRoom_Movement_SurpriseAfterBattleJump)
    waitmovement(0)
    delay(20)
    applymovementandwait(LOCALID_DRIVEKATHERINEROOM_DRIVE, Common_Movement_WalkDown)
    msgbox(format("An intense, balanced flavor… unforgettable…"), MSGBOX_AUTOCLOSE, SP_NAME_DRIVE)
    applymovementandwait(LOCALID_DRIVEKATHERINEROOM_DRIVE, Common_Movement_WalkInPlaceDown)
    delay(20)
    msgbox(format("If every celebration had this touch, the world would be an eternal feast."), MSGBOX_AUTOCLOSE, SP_NAME_DRIVE)
    playse(SE_PIN)
    applymovementandwait(LOCALID_DRIVEKATHERINEROOM_DRIVE, Common_Movement_HappyWithDelay48)
    delay(15)
    applymovementandwait(LOCALID_DRIVEKATHERINEROOM_KATHERINE, Common_Movement_WalkDown)
    msgbox(format("It was a perfect dance. In every step you could feel the joy of this day, almost as if the room were purring with emotion.\pThank you for sharing it with us."), MSGBOX_AUTOCLOSE, SP_NAME_KATHERINE)
    playse(SE_PIN)
    applymovementandwait(LOCALID_DRIVEKATHERINEROOM_KATHERINE, Common_Movement_HeartWithDelay48)
    delay(30)
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_DRIVEKATHERINEROOM_DRIVE, moves(jump_in_place_down))
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_DRIVEKATHERINEROOM_DRIVE, moves(jump_in_place_down))
    msgbox(format("I'll drink to that!"), MSGBOX_AUTOCLOSE, SP_NAME_DRIVE)
    delay(30)
    applymovementandwait(LOCALID_DRIVEKATHERINEROOM_KATHERINE, moves(walk_down, face_left))
    turnobject(LOCALID_PLAYER, DIR_EAST)
    msgbox(format("You've cleared this room with elegance. Keep enjoying the celebration… and until we meet again…"), MSGBOX_AUTOCLOSE, SP_NAME_KATHERINE)
    applymovementandwait(LOCALID_DRIVEKATHERINEROOM_KATHERINE, Common_Movement_WalkInPlaceLeft)
    delay(20)
    msgbox(format("Meow revoir!"), MSGBOX_AUTOCLOSE, SP_NAME_KATHERINE)
    call(WahRoomsShared_OpenDoor)
    applymovementandwait(LOCALID_DRIVEKATHERINEROOM_KATHERINE, moves (walk_up, face_down))
    setflag(FLAG_DEFEATED_ADMINS_KATHERINE_AND_DRIVE)
    call(WahRoomsShared_EventScript_AfterBattle)
    release
    end
}

movement DriveKatherineRoom_Movement_SurpriseAfterBattleEmote {
    emote_surprise
}

movement DriveKatherineRoom_Movement_SurpriseAfterBattleJump {
    lock_facing_direction
	jump_up
	unlock_facing_direction
    delay_16 * 3
}

script DriveKatherineRoom_EventScript_WalkInPlaceDriveFacingPlayer {
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    switch(var(VAR_RESULT)) {
        case DIR_NORTH:
            applymovementandwait(LOCALID_DRIVEKATHERINEROOM_DRIVE, Common_Movement_WalkInPlaceDown)
            break
        case DIR_SOUTH:
            applymovementandwait(LOCALID_DRIVEKATHERINEROOM_DRIVE, Common_Movement_WalkInPlaceUp)
            break
        case DIR_WEST:
            applymovementandwait(LOCALID_DRIVEKATHERINEROOM_DRIVE, Common_Movement_WalkInPlaceRight)
            break
        case DIR_EAST:
            applymovementandwait(LOCALID_DRIVEKATHERINEROOM_DRIVE, Common_Movement_WalkInPlaceLeft)
            break
    }
    return
}

script DriveKatherineRoom_EventScript_DriveKatherineBattle {
    if (!flag(FLAG_WAH_CHALLENGE_COMPLETED)) {
        trainerbattle_two_trainers(TRAINER_WAH_ADMIN_DRIVE_MAIN, DriveKatherineRoom_Text_DriveDefeated, TRAINER_WAH_ADMIN_KATHERINE_MAIN, DriveKatherineRoom_Text_KatherineDefeated)
    } else {
        setvar(VAR_0x8004, TEAM_INDEX_DRIVE)
        special(ShouldUseAlternativeTeam)
        copyvar(VAR_0x8005, VAR_RESULT)
        setvar(VAR_0x8004, TEAM_INDEX_KATHERINE)
        special(ShouldUseAlternativeTeam)
        // VAR_0x8005 = Drive team, VAR_RESULT = Katherine team
        if (var(VAR_0x8005) == 0) {
            if (var(VAR_RESULT) == 0) {
                trainerbattle_two_trainers(TRAINER_WAH_ADMIN_DRIVE_MAIN, DriveKatherineRoom_Text_DriveDefeated, TRAINER_WAH_ADMIN_KATHERINE_MAIN, DriveKatherineRoom_Text_KatherineDefeated)
            } else {
                trainerbattle_two_trainers(TRAINER_WAH_ADMIN_DRIVE_MAIN, DriveKatherineRoom_Text_DriveDefeated, TRAINER_WAH_ADMIN_KATHERINE_ALTERNATIVE, DriveKatherineRoom_Text_KatherineDefeated)
            }
        } else {
            if (var(VAR_RESULT) == 0) {
                trainerbattle_two_trainers(TRAINER_WAH_ADMIN_DRIVE_ALTERNATIVE, DriveKatherineRoom_Text_DriveDefeated, TRAINER_WAH_ADMIN_KATHERINE_MAIN, DriveKatherineRoom_Text_KatherineDefeated)
            } else {
                trainerbattle_two_trainers(TRAINER_WAH_ADMIN_DRIVE_ALTERNATIVE, DriveKatherineRoom_Text_DriveDefeated, TRAINER_WAH_ADMIN_KATHERINE_ALTERNATIVE, DriveKatherineRoom_Text_KatherineDefeated)
            }
        }
    }
    return
}

text DriveKatherineRoom_Text_DriveDefeated {
    format("Now THAT was a feast!")
}

text DriveKatherineRoom_Text_KatherineDefeated {
    format("Smooth, harmonious… I loved it.")
}

script DriveKatherineRoom_EventScript_Bottles {
    msgbox(format("Some bottles have names that are impossible to pronounce.\pThere's one called “Whack a Cola.”"), MSGBOX_SIGN)
    end
}

script DriveKatherineRoom_EventScript_Dispenser {
    msgbox(format("The water from the dispenser is incredibly cold."), MSGBOX_SIGN)
    end
}

script DriveKatherineRoom_EventScript_Trash {
    msgbox(format("The wastebasket gives off a faint smell of food."), MSGBOX_SIGN)
    end
}

script DriveKatherineRoom_EventScript_Cabinet {
    msgbox(format("The cabinet is full of plates, glasses, and cups.\pEverything's carefully organized by size and type."), MSGBOX_SIGN)
    end
}