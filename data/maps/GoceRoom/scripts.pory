mapscripts GoceRoom_MapScripts {
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
		VAR_TEMP_8, 0: GoceRoom_OnWarp_PlayerTurnNorth
    ]
    MAP_SCRIPT_ON_LOAD: GoceRoom_OnLoad
    MAP_SCRIPT_ON_TRANSITION : GoceRoom_OnTransition

}

script GoceRoom_OnLoad {
    if(flag(FLAG_DEFEATED_ADMIN_GOCE)){
        call(WahRoomsShared_SetDoorAsOpen)
    }
    end
}

script GoceRoom_OnWarp_PlayerTurnNorth {
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    end
}

script GoceRoom_OnTransition {
    call(WahRoomsShared_Kecleon_SetSala_Goce)
    end
}

script GoceRoom_EventScript_Goce {
    if(flag(FLAG_DEFEATED_ADMIN_GOCE)){
        msgbox(format("You may advance to the next challenge now.\pThere's still a long way to go."), MSGBOX_NPC, speaker = SP_NAME_GOCE)
        release
        end
    }
    else {
          lock
        faceplayer
        msgbox(format("Listen, little one. I wasn't the best known nor was I around for very long...\pI was but a spark trapped in {COLOR LIGHT_RED}amber{COLOR DARK_GRAY}.\pBut that spark was the start of all this, and today it's your turn to face it."), speaker = SP_NAME_GOCE)
        playse(SE_PIN)
        applymovement(LOCALID_GOCEROOM_GOCE, moves(emote_versus))
        waitmovement(0)
        waitse
        call(GoceRoom_EventScript_GoceBattle)
        delay(10)
        msgbox(format("That was a great battle! You managed to defeat the great founder. You must be proud."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GOCE)
        delay(20)
        playse(SE_PIN)
        applymovement(LOCALID_GOCEROOM_GOCE, Common_Movement_QuestionMarkWithDelay48)
        waitmovement(0)
        waitse
        msgbox(format("Huh, so you don't know who I am? They knew me as {COLOR RED}Goce{COLOR DARK_GRAY} and as {COLOR RED}Lance{COLOR DARK_GRAY}.\pEither way, what matters isn't my name, but that what began stays alive.\pYou've just proven to me that it is, kid.\pYou may continue."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GOCE)
        getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
        if(var(VAR_TEMP_0) == 5) {
            applymovementandwait(LOCALID_GOCEROOM_GOCE, 
            moves(lock_facing_direction, walk_right, unlock_facing_direction))
            setobjectxy(LOCALID_GOCEROOM_GOCE, 7, 5)
            setobjectxyperm(LOCALID_GOCEROOM_GOCE, 7, 5)
        } else {
            applymovementandwait(LOCALID_GOCEROOM_GOCE, 
            moves(face_right, lock_facing_direction, walk_left, unlock_facing_direction))
            setobjectxy(LOCALID_GOCEROOM_GOCE, 5, 5)
            setobjectxyperm(LOCALID_GOCEROOM_GOCE, 5, 5)
        }
        call(WahRoomsShared_OpenDoor)
        setflag(FLAG_DEFEATED_ADMIN_GOCE)
        call(WahRoomsShared_EventScript_AfterBattle)
        release
        end
    }
   
}

script GoceRoom_EventScript_GoceBattle {
    if (!flag(FLAG_WAH_CHALLENGE_COMPLETED)) {
        trainerbattle_no_intro(TRAINER_WAH_ADMIN_GOCE_MAIN, GoceRoom_Text_GoceDefeated)
    } else {
        setvar(VAR_0x8004, TEAM_INDEX_GOCE)
        special(ShouldUseAlternativeTeam)
        if (var(VAR_RESULT) == 0) {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_GOCE_MAIN, GoceRoom_Text_GoceDefeated)
        } else {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_GOCE_ALTERNATIVE, GoceRoom_Text_GoceDefeated)
        }
    }
    return
}

text GoceRoom_Text_GoceDefeated {
    format("It's incredible how they've evolved over these last 20 years…")
}

script GoceRoom_EventScript_Ambar {
    msgbox(format("There are small fragments of amber scattered across the floor."), MSGBOX_SIGN)
    end
}