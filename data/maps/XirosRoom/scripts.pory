const FLAG_TEMP_1_XIROSROOM_HIDE_POKEBALL = FLAG_TEMP_1
const FLAG_TEMP_2_XIROSROOM_HIDE_ELECTRODE = FLAG_TEMP_2

mapscripts XirosRoom_MapScripts {
    MAP_SCRIPT_ON_LOAD: XirosRoom_OnLoad
    MAP_SCRIPT_ON_TRANSITION: XirosRoom_OnTransition
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_8, 0: XirosRoom_OnWarp_PlayerTurnNorth
    ]
}

script XirosRoom_OnLoad {
    if(flag(FLAG_DEFEATED_ADMIN_XIROS)){
        call(WahRoomsShared_SetDoorAsOpen)
    }
    end
}

script XirosRoom_OnWarp_PlayerTurnNorth {
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    end
}

script XirosRoom_OnTransition {
    call(WahRoomsShared_Kecleon_SetSala_Xiros)
    setflag(FLAG_TEMP_1_XIROSROOM_HIDE_POKEBALL)
    setflag(FLAG_TEMP_2_XIROSROOM_HIDE_ELECTRODE)
    end
}

script XirosRoom_EventScript_Xiros {
    if(flag(FLAG_DEFEATED_ADMIN_XIROS)) {
        lock
        faceplayer
        msgbox(format("Still here? Well, since you are, let me tell you one more thing."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_XIROS)
        playse(SE_PIN)
        applymovementandwait(LOCALID_XIROSROOM_XIROS, Common_Movement_ThinkingWithDelay48)
        msgbox(format("Don't get too obsessed with comparing yourself all the time, because sometimes you'll feel ahead, and other times that you've fallen behind."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_XIROS)
        playse(SE_LEDGE)
        applymovementandwait(LOCALID_XIROSROOM_XIROS, moves(lock_facing_direction, jump_in_place_down, unlock_facing_direction, face_player))
        msgbox(format("In the end, the road is long, and the real race is always against yourself."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_XIROS)
        playse(SE_PIN)
        applymovementandwait(LOCALID_XIROSROOM_XIROS, Common_Movement_ThinkingWithDelay48)
        playse(SE_LEDGE)
        applymovementandwait(LOCALID_XIROSROOM_XIROS, moves(delay_16 * 2, lock_facing_direction, jump_in_place_down))
        waitse
        playse(SE_LEDGE)
        applymovementandwait(LOCALID_XIROSROOM_XIROS, moves(jump_in_place_down, unlock_facing_direction, face_player))
        msgbox(format("Now keep going, at your own pace, but always moving forward."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_XIROS)
        playse(SE_PIN)
        applymovementandwait(LOCALID_XIROSROOM_XIROS, Common_Movement_HappyWithDelay48)
        turnobject(LOCALID_XIROSROOM_XIROS, DIR_SOUTH)
        release
        end
    }
    lock
    faceplayer
    msgbox(format("So you made it here, to room number twenty!\pA place you don't reach by chance."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_XIROS)
    playse(SE_PIN)
    applymovementandwait(LOCALID_XIROSROOM_XIROS, Common_Movement_HappyWithDelay48)
    msgbox(format("I'll try to be briefer than Zero in my speech, but I like to reflect too, so I can't promise anything…"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_XIROS)
    playse(SE_PIN)
    applymovementandwait(LOCALID_XIROSROOM_XIROS, Common_Movement_SweatDropWithDelay48)
    fadescreen(FADE_TO_BLACK)
    turnobject(LOCALID_XIROSROOM_XIROS, DIR_SOUTH)
    directmovementtopos(LOCALID_PLAYER, 6, 6)
    waitmovement(0)
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    fadescreen(FADE_FROM_BLACK)
    msgbox(format("Along the way you crossed paths with many people, some familiar, others you'd maybe only heard mentioned once, but all of them left something on this journey."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_XIROS)
    applymovementandwait(LOCALID_XIROSROOM_XIROS, Common_Movement_WalkInPlaceDown)
    delay(20)
    msgbox(format("Every encounter, every chat, and every battle is part of a bigger story, even if we don't always notice it in the moment."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_XIROS)
    playse(SE_PIN)
    applymovementandwait(LOCALID_XIROSROOM_XIROS, Common_Movement_HeartWithDelay48)
    delay(20)
    special(SpawnCameraObject)
    applymovement(LOCALID_XIROSROOM_XIROS, Common_Movement_WalkUp2)
    applymovement(LOCALID_CAMERA, Common_Movement_WalkUp2)
    waitmovement(0)
    playse(SE_PIN)
    applymovementandwait(LOCALID_XIROSROOM_XIROS, Common_Movement_ThinkingWithDelay48)
    msgbox(format("It's normal for things to seem hard or even impossible at some point, because no one is born knowing, nor starts a big challenge or project with all the answers."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_XIROS)
    applymovementandwait(LOCALID_XIROSROOM_XIROS, Common_Movement_WalkInPlaceDown)
    msgbox(format("What matters isn't knowing everything, but daring to search, because when you truly search, someone willing to help always turns up."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_XIROS)
    applymovement(LOCALID_XIROSROOM_XIROS, Common_Movement_WalkDown2)
    applymovement(LOCALID_CAMERA, Common_Movement_WalkDown2)
    waitmovement(0)
    special(RemoveCameraObject)
    msgbox(format("That's the beautiful thing about this community, don't you think?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_XIROS)
    playse(SE_PIN)
    applymovementandwait(LOCALID_XIROSROOM_XIROS, Common_Movement_HappyWithDelay48)
    applymovementandwait(LOCALID_XIROSROOM_XIROS, moves(
        lock_facing_direction
        walk_up
        unlock_facing_direction
    ))
    clearflag(FLAG_TEMP_1_XIROSROOM_HIDE_POKEBALL)
    addobject(LOCALID_XIROSROOM_POKEBALL)
    showobjectat(LOCALID_XIROSROOM_POKEBALL, MAP_XIROS_ROOM)
    applymovementandwait(LOCALID_XIROSROOM_POKEBALL, Common_Movement_WalkDiagSouthEast)
	playse(SE_BALL_OPEN)
	fadescreen(FADE_TO_WHITE)
    removeobject(LOCALID_XIROSROOM_POKEBALL)
    setflag(FLAG_TEMP_1_XIROSROOM_HIDE_POKEBALL)
    clearflag(FLAG_TEMP_2_XIROSROOM_HIDE_ELECTRODE)
    addobject(LOCALID_XIROSROOM_ELECTRODE)
    waitse
    fadescreen(FADE_FROM_WHITE)
    release
    delay(30)
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_XIROSROOM_ELECTRODE, moves(jump_in_place_down))
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_XIROSROOM_ELECTRODE, moves(jump_in_place_down))
    waitse
    playmoncry(SPECIES_ELECTRODE, CRY_MODE_NORMAL)
    waitmoncry
    applymovementandwait(LOCALID_XIROSROOM_ELECTRODE, moves(walk_left, walk_up, walk_in_place_right))
    release
    turnobject(LOCALID_XIROSROOM_XIROS, DIR_WEST)
    msgbox(format("This is Watermelon Electrode, a symbol of an era many remember with fondness and nostalgia, when everything seemed simpler."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_XIROS)
    playse(SE_PIN)
    applymovementandwait(LOCALID_XIROSROOM_XIROS, Common_Movement_ThinkingWithDelay48)
    turnobject(LOCALID_XIROSROOM_XIROS, DIR_SOUTH)
    turnobject(LOCALID_XIROSROOM_ELECTRODE, DIR_SOUTH)
    msgbox(format("Personally, I never believed the golden age was a moment left behind in time."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_XIROS)
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_XIROSROOM_XIROS, Common_Movement_JumpInPlaceDown)
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_XIROSROOM_XIROS, Common_Movement_JumpInPlaceDown)
    msgbox(format("For me, the golden age is today, and it'll be tomorrow too, as long as there are still people eager to motivate, help, and push things a little further forward."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_XIROS)
    applymovementandwait(LOCALID_XIROSROOM_XIROS, Common_Movement_WalkInPlaceLeft)
    turnobject(LOCALID_XIROSROOM_ELECTRODE, DIR_EAST)
    playse(SE_BALL_OPEN)
    fadescreen(FADE_TO_WHITE)
    removeobject(LOCALID_XIROSROOM_ELECTRODE)
    setflag(FLAG_TEMP_2_XIROSROOM_HIDE_ELECTRODE)
    delay(30)
    fadescreen(FADE_FROM_WHITE)
    delay(20)
    applymovementandwait(LOCALID_XIROSROOM_XIROS, Common_Movement_WalkDown)
    msgbox(format("Let's make this moment count too."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_XIROS)
    playse(SE_PIN)
    applymovementandwait(LOCALID_XIROSROOM_XIROS, moves(emote_versus, delay_16, walk_in_place_down, delay_16))
    call(XirosRoom_EventScript_XirosBattle)
    playse(SE_PIN)
    applymovementandwait(LOCALID_XIROSROOM_XIROS, moves(emote_happy))
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_XIROSROOM_XIROS, moves(jump_in_place_down))
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_XIROSROOM_XIROS, moves(jump_in_place_down))
    msgbox(format("Wow! What a great battle! I love your battling style.\pEspecially the passion you put into every move!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_XIROS)
    delay(20)
    applymovementandwait(LOCALID_XIROSROOM_XIROS, Common_Movement_WalkInPlaceDown)
    msgbox(format("You've still got one last showdown, and if you know a bit of this place's history, you can probably already imagine who's waiting for you.\pMake the most of it - not everyone is lucky enough to find him."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_XIROS)
    call(WahRoomsShared_OpenDoor)
    msgbox(format("Now keep going, at your own pace, but always moving forward."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_XIROS)
    playse(SE_PIN)
    applymovementandwait(LOCALID_XIROSROOM_XIROS, Common_Movement_HappyWithDelay48)
    setflag(FLAG_DEFEATED_ADMIN_XIROS)
    call(WahRoomsShared_EventScript_AfterBattle)
    release
    end
}

script XirosRoom_EventScript_XirosBattle {
    if (!flag(FLAG_WAH_CHALLENGE_COMPLETED)) {
        trainerbattle_no_intro(TRAINER_WAH_ADMIN_XIROS_MAIN, XirosRoom_Text_XirosDefeated)
    } else {
        setvar(VAR_0x8004, TEAM_INDEX_XIROS)
        special(ShouldUseAlternativeTeam)
        if (var(VAR_RESULT) == 0) {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_XIROS_MAIN, XirosRoom_Text_XirosDefeated)
        } else {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_XIROS_ALTERNATIVE, XirosRoom_Text_XirosDefeated)
        }
    }
    return
}

text XirosRoom_Text_XirosDefeated {
    format("Great battle!")
}

script XirosRoom_EventScript_Tanque {
    msgbox(format("It's a tank full of a liquid that doesn't look like water.\pThere's bubbling inside it."), MSGBOX_SIGN)
    end
}

script XirosRoom_EventScript_Holograma {
    msgbox(format("It's a hologram of a cube floating in the air."), MSGBOX_SIGN)
    end
}

script XirosRoom_EventScript_Lampara {
    msgbox(format("It's a futuristic lamp that glows with blue light."), MSGBOX_SIGN)
    end
}

script XirosRoom_EventScript_Server {
    msgbox(format("The blinking lights show it's running quantum calculations."), MSGBOX_SIGN)
    end
}

script XirosRoom_EventScript_Pantalla {
    msgbox(format("It seems to show very complex calculations and graphs."), MSGBOX_SIGN)
    end
}

script XirosRoom_EventScript_Unknown {
    msgbox(format("This is a...\nWhat is this?"), MSGBOX_SIGN)
    end
}