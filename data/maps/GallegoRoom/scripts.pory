const VAR_TEMP_0_BIN = VAR_TEMP_0

mapscripts GallegoRoom_MapScripts {
     MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
		VAR_TEMP_8, 0: GallegoRoom_OnWarp_PlayerTurnNorth
    ]
    MAP_SCRIPT_ON_LOAD: GallegoRoom_OnLoad
    MAP_SCRIPT_ON_TRANSITION : GallegoRoom_OnTransition
}

script GallegoRoom_OnLoad {
    if(flag(FLAG_DEFEATED_ADMIN_GALLEGO)){
        call(WahRoomsShared_SetDoorAsOpen)
        setobjectmovementtype(LOCALID_GALLEGOROOM_GALLEGO, MOVEMENT_TYPE_FACE_DOWN)
    }
    end
}

script GallegoRoom_OnWarp_PlayerTurnNorth {
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    end
}

script GallegoRoom_OnTransition {
    call(WahRoomsShared_Kecleon_SetSala_Gallego)
    end
}

script GallegoRoom_EventScript_Gallego {
    if(flag(FLAG_DEFEATED_ADMIN_GALLEGO)) {
        lock
        faceplayer
        msgbox(format("The spark that rekindled my dream has lit a flame that grows by the moment."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GALLEGO)
        playse(SE_PIN)
        applymovementandwait(LOCALID_GALLEGOROOM_GALLEGO, Common_Movement_HappyWithDelay48)
        msgbox(format("Keep chasing yours, and we'll meet again on the road!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GALLEGO)
        release
        end
    }
    lock
    special(HideMapNamePopUpWindow)
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    switch(var(VAR_RESULT)){
        case DIR_SOUTH:
            applymovementandwait(LOCALID_PLAYER, moves(
                walk_left
                walk_down * 2
                walk_right
                face_up
            ))
            break
        case DIR_EAST:
            applymovementandwait(LOCALID_PLAYER, moves(
                walk_down
                walk_right
                face_up
            ))
    }
    applymovementandwait(LOCALID_GALLEGOROOM_GALLEGO, moves(reveal_trainer, walk_in_place_up))
    msgbox(format("Oh no, I think they saw me… I can't let them find me yet…\pWhat if I keep very still? Could I manage to slip away?"), MSGBOX_AUTOCLOSE_TOP)
    playse(SE_PIN)
    applymovementandwait(LOCALID_GALLEGOROOM_GALLEGO, moves(
        emote_thinking,
        delay_16 * 3,
        face_left,
        delay_16 * 2,
        face_right,
        delay_16 * 2,
        face_down,
        delay_16,
        face_up,
        delay_16 * 2
    ))
    msgbox(format("Well, I'll have to accept it, I guess I couldn't hide forever."), MSGBOX_AUTOCLOSE_TOP)
    playse(SE_PIN)
    applymovementandwait(LOCALID_GALLEGOROOM_GALLEGO, Common_Movement_SweatDropWithDelay48)
    faceplayer
    delay(30)
    applymovementandwait(LOCALID_GALLEGOROOM_GALLEGO, Common_Movement_WalkInPlaceDown)
    msgbox(format("Hi! I'm Gallego13, and for years I've watched from the shadows.\pYou could almost say I didn't leave, I just hid.\pNow and then I'd peek in on our dear community, saying nothing, watching the progress and how it evolved…\pI never meant it to last so long, but studies and then life made me lose all track of time.\pBefore I knew it, I'd gotten used to watching this world from a distance."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GALLEGO)
    delay(30)
    playse(SE_PIN)
    applymovement(LOCALID_GALLEGOROOM_GALLEGO, moves(emote_double_exclamation_mark))
    waitmovement(0)
    waitse
    msgbox(format("And look at that, twenty years… twenty!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GALLEGO)
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_GALLEGOROOM_GALLEGO, moves(
        lock_facing_direction,
        jump_in_place_up
    ))
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_GALLEGOROOM_GALLEGO, moves(
        jump_in_place_up,
        unlock_facing_direction,
        face_player
    ))
    delay(40)
    msgbox(format("The anniversary caught me completely by surprise.\pIt's even been ten years since I was last seen!\pAnd even so, that piece of my life I remember like it was yesterday."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GALLEGO)
    playse(SE_PIN)
    applymovementandwait(LOCALID_GALLEGOROOM_GALLEGO, Common_Movement_HeartWithDelay48)
    msgbox(format("I always dreamed of making a game that captured the soul of the second generation, with that look and that “certain something” I've always been in love with.\pI spent years grinding away in hex bytes and ASM routines, shoving graphics and music into the ROM by brute force…"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GALLEGO)
    special(SpawnCameraObject)
    applymovement(LOCALID_GALLEGOROOM_GALLEGO, Common_Movement_WalkUp2)
    applymovement(LOCALID_CAMERA, Common_Movement_WalkUp2)
    waitmovement(0)
    msgbox(format("But it was driving me crazy, all of it… too hard, and the bugs sprouted like weeds with every change."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GALLEGO)
    applymovementandwait(LOCALID_GALLEGOROOM_GALLEGO, Common_Movement_FacePlayer)
    msgbox(format("And right when I quit, when I gave up, the modern tools appeared.\pThe disassembly, the engines… all I would've needed back then showed up, almost like a mockery of my effort."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GALLEGO)
    playse(SE_PIN)
    applymovementandwait(LOCALID_GALLEGOROOM_GALLEGO, Common_Movement_SweatDropWithDelay48)
    applymovement(LOCALID_GALLEGOROOM_GALLEGO, Common_Movement_WalkDown2)
    applymovement(LOCALID_CAMERA, Common_Movement_WalkDown2)
    waitmovement(0)
    special(RemoveCameraObject)
    delay(50)
    applymovementandwait(LOCALID_GALLEGOROOM_GALLEGO, moves(
        walk_left
        walk_down * 3
        walk_right
    ))
    turnobject(LOCALID_PLAYER, DIR_SOUTH)
    msgbox(format("As you can see, I still keep my old Game Boy Colors."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GALLEGO)
    applymovementandwait(LOCALID_PLAYER, moves(walk_down, face_right))
    playse(SE_PIN)
    applymovementandwait(LOCALID_PLAYER, Common_Movement_SurpriseWithDelay48)
    turnobject(LOCALID_GALLEGOROOM_GALLEGO, DIR_NORTH)
    turnobject(LOCALID_PLAYER, DIR_SOUTH)
    msgbox(format("Some don't even turn on, but they're still here.\pIn spite of it all, after so much time, my dream still lives on…\pThe dream has no end: the gears in my head still haven't stopped…"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GALLEGO)
    delay(30)
    applymovementandwait(LOCALID_GALLEGOROOM_GALLEGO, Common_Movement_WalkInPlaceUp)
    msgbox(format("Anyway, enough reflecting for now."), MSGBOX_AUTOCLOSE, speaker= SP_NAME_GALLEGO)
    applymovementandwait(LOCALID_GALLEGOROOM_GALLEGO, moves(
        walk_left
        walk_up * 3
        walk_right
        face_down
    ))
    applymovementandwait(LOCALID_PLAYER, Common_Movement_WalkUp)
    msgbox(format("Let's see if I still remember how to battle after all this time."), MSGBOX_AUTOCLOSE,speaker = SP_NAME_GALLEGO)
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_GALLEGOROOM_GALLEGO, moves(
        lock_facing_direction,
        jump_in_place_down,
        delay_16,
        unlock_facing_direction,
        face_player
    ))
    waitse
    msgbox(format("Show me how much the new generation has evolved!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GALLEGO)
    playse(SE_PIN)
    applymovement(LOCALID_GALLEGOROOM_GALLEGO, moves(emote_versus))
    waitmovement(0)
    waitse
    call(GallegoRoom_EventScript_GallegoBattle)
    msgbox(format("Looks like the new generations of trainers are a much tougher nut to crack.\pBut watching you battle brings back the old spark."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GALLEGO)
    playse(SE_PIN)
    applymovementandwait(LOCALID_GALLEGOROOM_GALLEGO, Common_Movement_HappyWithDelay48)
    delay(60)
    msgbox(format("Funny… I quit right before everything got easier, and even so, I keep thinking of coming back.\pI can't deny I'm a hopeless stubborn fool…"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GALLEGO)
    playse(SE_PIN)
    applymovementandwait(LOCALID_GALLEGOROOM_GALLEGO, Common_Movement_SweatDropWithDelay48)
    delay(30)
    msgbox(format("I guess some dreams just don't burn out."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GALLEGO)
    playse(SE_LEDGE)
    applymovement(LOCALID_GALLEGOROOM_GALLEGO, moves(
        lock_facing_direction,
        jump_in_place_up
    ))
    waitmovement(0)
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_GALLEGOROOM_GALLEGO, moves(
        jump_in_place_up,
        unlock_facing_direction,
        face_player
    ))
    msgbox(format("Go on, keep going, chase your dream and hold it tight!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GALLEGO)
    call(WahRoomsShared_OpenDoor)
    msgbox(format("I'll stay here a little longer… remembering my old attempts and dreaming of a new and exciting beginning."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GALLEGO)
    setflag(FLAG_DEFEATED_ADMIN_GALLEGO)
    call(WahRoomsShared_EventScript_AfterBattle)
    release
    end
}

script GallegoRoom_EventScript_TV {
    msgbox(format("Looks like there's a half-finished game of the original Castlevania.\pA curious way to blow off steam."), MSGBOX_SIGN)
    end
}

script GallegoRoom_EventScript_Monkfear {
    msgbox("Looks like a fakémon design with\na second-generation look.\pIt has a data sheet:\nType: Water/Dark.\lSpecies: Aquaterror.\pEvolution line: Monkfear doesn't evolve.", MSGBOX_SIGN)
    end
}

script GallegoRoom_EventScript_Saturnape {
    msgbox("Looks like a fakémon design with\na second-generation look.\pIt has a data sheet:\nType: Psychic.\lSpecies: Alien Monkey.\pEvolution line: Marskey (LV. 30) >\nSaturnape.", MSGBOX_SIGN)
    end
}

script GallegoRoom_EventScript_Gameboy1 {
    msgbox(format("It's a Game Boy Color.\pLooks like there's a game in progress deep inside a huge forest.\pOkay, I'll step out and… it just crashed. Great."), MSGBOX_SIGN)
    end
}

script GallegoRoom_EventScript_Gameboy2 {
    msgbox(format("It's a Game Boy Color.\pThe game's saved right before the starter-selection scene in a game I don't recognize…\pOops! It just reset the moment the battle began.\pWhat a letdown."), MSGBOX_SIGN)
    end
}

script GallegoRoom_EventScript_DrawingsAndCoffee {
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    if(var(VAR_RESULT) == DIR_NORTH) {
        msgbox(format("A half-drunk latte.\pLooks like someone left it half-finished in a hurry."), MSGBOX_SIGN)
    } else {
        goto(GallegoRoom_EventScript_Drawings)
    }
    end
}

script GallegoRoom_EventScript_Drawings {
    msgbox(format("They look like designs of various fakémon and Pokémon from generations after the second, in the Game Boy Color style.\pThey're mixed in with very old university notes.\pLooks like no one's tidied up here in a decade."), MSGBOX_SIGN)
    end
}

script GallegoRoom_EventScript_Shelf {
    msgbox(format("It's a collection of books and notes from university mixed with volumes of manga.\pIt doesn't look very organized."), MSGBOX_SIGN)
    end
}

script GallegoRoom_EventScript_Library {
    msgbox(format("There's a huge row of black hardcover volumes.\pOn the spine you can read “Berserk” in red letters."), MSGBOX_SIGN)
    end
}

script GallegoRoom_EventScript_Drawer {
    msgbox(format("It's a cabinet full of consoles and video games from different eras, stacked in various compartments.\pYou can't see the back of it."), MSGBOX_SIGN)
    end
}

script GallegoRoom_EventScript_NES {
    msgbox(format("It's an NES, a little dusty, but it works perfectly.\pSo retro!"), MSGBOX_SIGN)
    end
}

script GallegoRoom_EventScript_Bin {
    switch(var(VAR_TEMP_0_BIN)) {
        case 0:
            msgbox(format("Nothing, just junk here… I think."), MSGBOX_SIGN)
            setvar(VAR_TEMP_0_BIN, 1)
        case 1:
            msgbox(format("I told you there's only junk here. Stop searching."), MSGBOX_SIGN)
            setvar(VAR_TEMP_0_BIN, 2)
        case 2:
            msgbox(format("At the bottom you find a strange image. It's clearly a second- generation design, but you're sure it's Flamigo, a recent Pokémon.\pWhat sense does this make?"), MSGBOX_SIGN)
    }
    end
}

script GallegoRoom_EventScript_GallegoBattle {
    if (!flag(FLAG_WAH_CHALLENGE_COMPLETED)) {
        trainerbattle_no_intro(TRAINER_WAH_ADMIN_GALLEGO_MAIN, GallegoRoom_Text_GallegoDefeated)
    } else {
        setvar(VAR_0x8004, TEAM_INDEX_GALLEGO)
        special(ShouldUseAlternativeTeam)
        if (var(VAR_RESULT) == 0) {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_GALLEGO_MAIN, GallegoRoom_Text_GallegoDefeated)
        } else {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_GALLEGO_ALTERNATIVE, GallegoRoom_Text_GallegoDefeated)
        }
    }
    return
}

text GallegoRoom_Text_GallegoDefeated {
    format("Phew… I really have fallen behind the times.")
}