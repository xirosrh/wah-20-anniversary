const VAR_TEMP_0_AGUIAR_ROOM_STATE = VAR_TEMP_0
const FLAG_TEMP_1_HIDE_AGUIAR = FLAG_TEMP_1
const FLAG_TEMP_2_HIDE_AGUIAR_SMOKING = FLAG_TEMP_2

mapscripts AguiarRoom_MapScripts {
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_8, 0: AguiarRoom_OnWarp_PlayerTurnNorth
    ]
    MAP_SCRIPT_ON_LOAD: AguiarRoom_OnLoad
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_0_AGUIAR_ROOM_STATE, 0: AguiarRoom_OnFrame
    ]
    MAP_SCRIPT_ON_TRANSITION : AguiarRoom_OnTransition
}


script AguiarRoom_OnFrame {
    special(ShowMapNamePopup)
    setflag(FLAG_TEMP_2_HIDE_AGUIAR_SMOKING)
    removeobject(LOCALID_AGUIARROOM_AGUIAR_SMOKING)
    getplayerxy(VAR_TEMP_A, VAR_TEMP_B)
    special(SpawnCameraObject)
    directcameramovementtopos(10, 6)
    waitmovement(0)
    special(HideMapNamePopUpWindow)
    msgbox(format("What a great show! Today really is a quiet day."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_AGUIAR)
    playse(SE_PIN)
    applymovement(LOCALID_AGUIARROOM_AGUIAR, Common_Movement_HappyWithDelay48)
    waitmovement(0)
    delay(20)
    msgbox(format("Well, time for a couple of drags."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_AGUIAR)
    call(AguiarRoom_EventScript_TurnOffTV)
    delay(30)
    applymovementandwait(LOCALID_AGUIARROOM_AGUIAR, moves(walk_down, walk_left * 4, walk_up, face_down))
    addobject(LOCALID_AGUIARROOM_AGUIAR_SMOKING)
    clearflag(FLAG_TEMP_2_HIDE_AGUIAR_SMOKING)
    removeobject(LOCALID_AGUIARROOM_AGUIAR)
    setflag(FLAG_TEMP_1_HIDE_AGUIAR)
    directcameramovementtoposwithvars(VAR_TEMP_A, VAR_TEMP_B)
    waitmovement(0)
    special(RemoveCameraObject)
    setvar(VAR_TEMP_0_AGUIAR_ROOM_STATE, 1)
    release
    end
}

script AguiarRoom_OnLoad {
    if(var(VAR_TEMP_0_AGUIAR_ROOM_STATE) == 0){
        call(AguiarRoom_EventScript_TurnOnTV)
    }
    if(flag(FLAG_DEFEATED_ADMIN_AGUIAR)){
        call(WahRoomsShared_SetDoorAsOpen)
    }
    end
}

script AguiarRoom_OnWarp_PlayerTurnNorth {
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    end
}

script AguiarRoom_OnTransition {
    call(WahRoomsShared_Kecleon_SetSala_Aguiar)
    end
}

script AguiarRoom_EventScript_TurnOffTV {
    setmetatile(9, 2, METATILE_room_aguiar_TV_OFF_LEFT, TRUE)
    setmetatile(10, 2, METATILE_room_aguiar_TV_OFF_RIGHT, TRUE)
    special(DrawWholeMapView)
    return
}

script AguiarRoom_EventScript_TurnOnTV {
    setmetatile(9, 2, METATILE_room_aguiar_TV_ON_LEFT, TRUE)
    setmetatile(10, 2, METATILE_room_aguiar_TV_ON_RIGHT, TRUE)
    special(DrawWholeMapView)
    return
}

script AguiarRoom_EventScript_Aguiar {
    if(flag(FLAG_DEFEATED_ADMIN_AGUIAR)){
        lock
        specialvar(VAR_RESULT, GetPlayerFacingDirection)
        if(var(VAR_RESULT) != DIR_NORTH){
            updateobjectsprite(LOCALID_AGUIARROOM_AGUIAR_SMOKING, OBJ_EVENT_GFX_AGUIAR)
        }
        faceplayer
        msgbox(format("Here I am, same as always: relaxed, smoking, and waiting to see who shows up."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_AGUIAR)
        if(var(VAR_RESULT) != DIR_NORTH){
            turnobject(LOCALID_AGUIARROOM_AGUIAR_SMOKING, DIR_SOUTH)
            updateobjectsprite(LOCALID_AGUIARROOM_AGUIAR_SMOKING, OBJ_EVENT_GFX_AGUIAR_SMOKING)
        }
        release
        end
    }
    lock
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    if(var(VAR_RESULT) != DIR_NORTH){
        updateobjectsprite(LOCALID_AGUIARROOM_AGUIAR_SMOKING, OBJ_EVENT_GFX_AGUIAR)
        faceplayer
        fadescreen(FADE_TO_BLACK)
        directmovementtopos(LOCALID_PLAYER, 6, 6)
        waitmovement(0)
        turnobject(LOCALID_PLAYER, DIR_NORTH)
        turnobject(LOCALID_AGUIARROOM_AGUIAR_SMOKING, DIR_SOUTH)
        updateobjectsprite(LOCALID_AGUIARROOM_AGUIAR_SMOKING, OBJ_EVENT_GFX_AGUIAR_SMOKING)
        fadescreen(FADE_FROM_BLACK)
    }
    faceplayer
    setobjectmovementtype2(LOCALID_AGUIARROOM_AGUIAR_SMOKING, MOVEMENT_TYPE_FACE_DOWN)
    msgbox(format("Well, look at you! You made it all the way here after all.\pAnd here I was thinking I'd spend the day lazing around with a cigarette and little else…"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_AGUIAR)
    applymovement(LOCALID_AGUIARROOM_AGUIAR_SMOKING, Common_Movement_SmokeCigarette)
    playse(SE_REPEL)
    waitmovement(0)
    delay(20)
    msgbox(format("I wasn't expecting company, but hey, it works out great: gives me something to do for a while."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_AGUIAR)
    playse(SE_PIN)
    applymovementandwait(LOCALID_AGUIARROOM_AGUIAR_SMOKING, Common_Movement_HappyWithDelay48)
    waitse
    msgbox(format("Everyone here takes it so seriously, as if this were a matter of life or death.\pI'd rather laugh, take a couple of drags, and see what whoever shows up has to offer."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_AGUIAR)
    applymovement(LOCALID_AGUIARROOM_AGUIAR_SMOKING, Common_Movement_SmokeCigarette)
    playse(SE_REPEL)
    waitmovement(0)
    delay(20)
    msgbox(format("I'm not going to give you epic speeches or grandpa advice - there are others for that.\pIf you want to fight, great. If I lose, well, I'll just light up another.\pAnd if I win… well, I'm not going to make a poster of your face, eh?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_AGUIAR)
    playse(SE_PIN)
    applymovementandwait(LOCALID_AGUIARROOM_AGUIAR_SMOKING, Common_Movement_HappyWithDelay48)
    waitse
    msgbox(format("So come on, let's not overthink it. Send out your Pokémon - I'm curious to see if you can at least make me set the cigarette down for a bit.\pHere we go!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_AGUIAR)
    playse(SE_PIN)
    applymovementandwait(LOCALID_AGUIARROOM_AGUIAR_SMOKING, moves(emote_versus))
    waitse
    call(AguiarRoom_EventScript_AguiarBattle)
    delay(10)
    msgbox(format("Well, you sure got me! And here I was thinking it'd be another walk in the park…"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_AGUIAR)
    applymovement(LOCALID_AGUIARROOM_AGUIAR_SMOKING, Common_Movement_SmokeCigarette)
    playse(SE_REPEL)
    waitmovement(0)
    delay(20)
    msgbox(format("Not bad, not bad at all. You can go ahead and keep moving."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_AGUIAR)
    call(WahRoomsShared_OpenDoor)
    setflag(FLAG_DEFEATED_ADMIN_AGUIAR)
    setobjectmovementtype2(LOCALID_AGUIARROOM_AGUIAR_SMOKING, MOVEMENT_TYPE_SMOKING_LOOP)
    call(WahRoomsShared_EventScript_AfterBattle)
    release
    end
}

script AguiarRoom_EventScript_AguiarBattle {
    if (!flag(FLAG_WAH_CHALLENGE_COMPLETED)) {
        trainerbattle_no_intro(TRAINER_WAH_ADMIN_AGUIAR_MAIN, AguiarRoom_Text_AguiarDefeated)
    } else {
        setvar(VAR_0x8004, TEAM_INDEX_AGUIAR)
        special(ShouldUseAlternativeTeam)
        if (var(VAR_RESULT) == 0) {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_AGUIAR_MAIN, AguiarRoom_Text_AguiarDefeated)
        } else {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_AGUIAR_ALTERNATIVE, AguiarRoom_Text_AguiarDefeated)
        }
    }
    return
}

text AguiarRoom_Text_AguiarDefeated {
    format("What a battle! I had a great\ntime.")
}

