const VAR_TEMP_0_BARO_ROOM_STATE = VAR_TEMP_0
const FLAG_TEMP_1_BARO_ROOM_HIDE_BARO = FLAG_TEMP_1

mapscripts BaroRoom_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_0_BARO_ROOM_STATE, 0: BaroRoom_OnFrame
	]
     MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_8, 0: BaroRoom_OnWarp_PlayerTurnNorth
    ]
    MAP_SCRIPT_ON_LOAD: BaroRoom_OnLoad
    MAP_SCRIPT_ON_TRANSITION : BaroRoom_OnTransition
}


script BaroRoom_OnLoad {
    if(flag(FLAG_DEFEATED_ADMIN_BARO)){
        call(WahRoomsShared_SetDoorAsOpen)
    }
    end
}

script BaroRoom_OnWarp_PlayerTurnNorth {
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    end
}

script BaroRoom_OnTransition {
    call(WahRoomsShared_Kecleon_SetSala_Baro)
    end
}

script BaroRoom_OnFrame {
    special(ShowMapNamePopup)
    applymovementandwait(LOCALID_PLAYER, moves(
        walk_up * 5, 
        face_right
        delay_16
        face_left
        delay_16
        face_up
        delay_16
        face_down
        delay_16))
    playse(SE_PIN)
    applymovementandwait(LOCALID_PLAYER, Common_Movement_QuestionMarkWithDelay48)
    special(SpawnCameraObject)
    applymovementandwait(LOCALID_CAMERA, Common_Movement_WalkRight2)
    waitmovement(0)
    call(BaroRoom_EventScript_OpenSideDoor)
    showobjectat(LOCALID_BAROROOM_BARO, MAP_BARO_ROOM)
    setobjectmovementtype(LOCALID_BAROROOM_BARO, MOVEMENT_TYPE_FACE_LEFT)
    setobjectmovementtype2(LOCALID_BAROROOM_BARO, MOVEMENT_TYPE_FACE_LEFT)
    applymovementandwait(LOCALID_BAROROOM_BARO, Common_Movement_WalkInPlaceLeft)
    applymovementandwait(LOCALID_PLAYER, Common_Movement_FaceRight)
    playse(SE_PIN)
    applymovementandwait(LOCALID_PLAYER, Common_Movement_ExclamationMarkWithDelay48)
    delay(10)
    msgbox(format("Erm… You're {PLAYER}, right? Nice to meet you, I'm Baro."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_BARO)
    applymovementandwait(LOCALID_BAROROOM_BARO, Common_Movement_WalkLeft)
    call(BaroRoom_EventScript_CloseSideDoor)
    applymovement(LOCALID_CAMERA, Common_Movement_WalkLeft2)
    applymovement(LOCALID_BAROROOM_BARO, Common_Movement_WalkLeft2)
    waitmovement(0)
    applymovementandwait(LOCALID_BAROROOM_BARO, moves(walk_up, walk_left *2, face_down))
    applymovementandwait(LOCALID_PLAYER, Common_Movement_FaceUp)
    special(RemoveCameraObject)
    msgbox(format("Anyway… the messes one gets into… "), MSGBOX_AUTOCLOSE, speaker = SP_NAME_BARO)
    playse(SE_PIN)
    applymovementandwait(LOCALID_BAROROOM_BARO, Common_Movement_SweatDropWithDelay48)
    msgbox(format("I was in a community? For real? A Pokémon one?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_BARO)
    delay(20)
    setspeaker(SP_NAME_BARO)
    playse(SE_PIN)
    applymovement(LOCALID_BAROROOM_BARO, moves(delay_16, emote_surprise, delay_16 * 3))
    message(format("Wow."))
    waitmovement(0)
    closemessage
    delay(20)
    msgbox(format("What times those were… anyway."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_BARO)
    delay(20)
    msgbox(format("I suppose reminiscing about the past fits the moment.\lYour journey and all that.\pAnyway, they asked me to swing by here for a little scrap with you. Shall we?"), speaker = SP_NAME_BARO)
    applymovementandwait(LOCALID_BAROROOM_BARO, Common_Movement_WalkInPlaceDown)
    playse(SE_PIN)
    applymovementandwait(LOCALID_BAROROOM_BARO, moves(emote_versus))
    waitse
    call(BaroRoom_EventScript_BaroBattle)
    msgbox(format("You didn't see the Pikachu coming, huh?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_BARO)
    playse(SE_PIN)
    applymovementandwait(LOCALID_BAROROOM_BARO, Common_Movement_HappyWithDelay48)
    delay(20)
    msgbox(format("Well, that's that. Duty done. Bye."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_BARO)
    special(SpawnCameraObject)
    applymovementandwait(LOCALID_BAROROOM_BARO, moves(
        walk_right * 2, walk_down
    ))
    applymovement(LOCALID_CAMERA, Common_Movement_WalkRight2)
    applymovement(LOCALID_BAROROOM_BARO, Common_Movement_WalkRight2)
    waitmovement(0)
    delay(20)
    applymovement(LOCALID_PLAYER, Common_Movement_FaceRight)
    applymovement(LOCALID_BAROROOM_BARO, Common_Movement_FaceLeft)
    waitmovement(0)
    msgbox(format("Well, good luck and all that."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_BARO)
    delay(20)
    applymovementandwait(LOCALID_BAROROOM_BARO, Common_Movement_FaceRight)
    call(BaroRoom_EventScript_OpenSideDoor)
    applymovementandwait(LOCALID_BAROROOM_BARO, moves(walk_right, walk_in_place_right, set_invisible))
    removeobject(LOCALID_BAROROOM_BARO)
    setflag(FLAG_TEMP_1_BARO_ROOM_HIDE_BARO)
    call(BaroRoom_EventScript_CloseSideDoor)
    applymovementandwait(LOCALID_CAMERA, Common_Movement_WalkLeft2)
    special(RemoveCameraObject)
    applymovementandwait(LOCALID_PLAYER, Common_Movement_FaceUp)
    delay(20)
    call(WahRoomsShared_OpenDoor)
    setvar(VAR_TEMP_0_BARO_ROOM_STATE, 1)
    setflag(FLAG_DEFEATED_ADMIN_BARO)
    call(WahRoomsShared_EventScript_AfterBattle)
    release
    end
 }


 script BaroRoom_EventScript_OpenSideDoor {
    playse(SE_RG_DOOR)
    setmetatile(11, 7,  METATILE_Room_Baro_DOOR_OPENING_1_UP, 0)
    setmetatile(11, 8,  METATILE_Room_Baro_DOOR_OPENING_1_DOWN, 0)
    special(DrawWholeMapView)
    delay(5)
    setmetatile(11, 7,  METATILE_Room_Baro_DOOR_OPENING_2_UP, 0)
    setmetatile(11, 8,  METATILE_Room_Baro_DOOR_OPENING_2_DOWN, 0)
    special(DrawWholeMapView)
    delay(5)
    setmetatile(11, 7,  METATILE_Room_Baro_DOOR_OPENING_3_UP, 0)
    setmetatile(11, 8,  METATILE_Room_Baro_DOOR_OPENING_3_DOWN, 0)
    special(DrawWholeMapView)
    delay(5)
    setmetatile(11, 7,  METATILE_Room_Baro_DOOR_OPEN_UP, 0)
    setmetatile(11, 8,  METATILE_Room_Baro_DOOR_OPEN_DOWN, 0)
    special(DrawWholeMapView)
    return
 }

  script BaroRoom_EventScript_CloseSideDoor {
    playse(SE_FU_ZAKU)
    setmetatile(11, 7,  METATILE_Room_Baro_DOOR_OPENING_3_UP, 0)
    setmetatile(11, 8,  METATILE_Room_Baro_DOOR_OPENING_3_DOWN, 0)
    special(DrawWholeMapView)
    delay(5)
    setmetatile(11, 7,  METATILE_Room_Baro_DOOR_OPENING_2_UP, 0)
    setmetatile(11, 8,  METATILE_Room_Baro_DOOR_OPENING_2_DOWN, 0)
    special(DrawWholeMapView)
    delay(5)
    setmetatile(11, 7,  METATILE_Room_Baro_DOOR_OPENING_1_UP, 0)
    setmetatile(11, 8,  METATILE_Room_Baro_DOOR_OPENING_1_DOWN, 0)
    special(DrawWholeMapView)
    delay(5)
    setmetatile(11, 7,  METATILE_Room_Baro_DOOR_CLOSED_UP, 0)
    setmetatile(11, 8,  METATILE_Room_Baro_DOOR_CLOSED_DOWN, 0)
    special(DrawWholeMapView)
    return
 }

 script BaroRoom_EventScript_BaroBattle {
    if (!flag(FLAG_WAH_CHALLENGE_COMPLETED)) {
        trainerbattle_no_intro(TRAINER_WAH_ADMIN_BARO_MAIN, BaroRoom_Text_BaroDefeated)
        setflag(FLAG_POKEBOX_WON_BARO_MAIN)
    } else {
        setvar(VAR_0x8004, TEAM_INDEX_BARO)
        special(ShouldUseAlternativeTeam)
        if (var(VAR_RESULT) == 0) {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_BARO_MAIN, BaroRoom_Text_BaroDefeated)
            setflag(FLAG_POKEBOX_WON_BARO_MAIN)
        } else {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_BARO_ALTERNATIVE, BaroRoom_Text_BaroDefeated)
            setflag(FLAG_POKEBOX_WON_BARO_ALTERNATIVE)
        }
    }
    return
 }

 text BaroRoom_Text_BaroDefeated {
    format("Anyway…")
 }

 script BaroRoom_EventScript_PlugOink {
    lock
    applymovement(LOCALID_BAROROOM_PLUGOINK, moves(face_player, lock_facing_direction, jump_in_place_down * 2, unlock_facing_direction, face_player))
    waitmovement(0)
    playmoncry(SPECIES_PLUGOINK, CRY_MODE_NORMAL)
    msgbox(format("Oink, oink, oink…"), MSGBOX_DEFAULT)
    waitmoncry
    closemessage
    if (!flag(FLAG_MET_BARO_ROOM_PLUGOINK)) {
         setflag(FLAG_MET_BARO_ROOM_PLUGOINK)
         call(Pokebox_EventScript_ShowUnlocks)
    }
    release
    end
 }	

 script BaroRoom_EventScript_Sever {
    lock
    faceplayer
    playmoncry(SPECIES_POOCHYENA, CRY_MODE_NORMAL)
    msgbox(format("Sever!"), MSGBOX_DEFAULT)
    waitmoncry
    closemessage
    release
    end
 }

 script BaroRoom_EventScript_Seeg {
    lock
    faceplayer
    playmoncry(SPECIES_TREECKO, CRY_MODE_NORMAL)
    msgbox(format("See, see."), MSGBOX_DEFAULT)
    waitmoncry
    closemessage
    release
    end
 }

 script BaroRoom_EventScript_Poster {
    msgbox(format("A corner of the poster has already started peeling off the wall."), MSGBOX_SIGN)
    end
 }

