const VAR_TEMP_0_REONEKY_ROOM_STATE = VAR_TEMP_0
const FLAG_TEMP_1_REONEKYROOM_HIDE_TYPHLOSION = FLAG_TEMP_1
const FLAG_TEMP_2_REONEKYROOM_HIDE_FIRE = FLAG_TEMP_2
const FLAG_TEMP_3_REONEKYROOM_HIDE_HAUNTER = FLAG_TEMP_3

mapscripts ReonekyRoom_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_0_REONEKY_ROOM_STATE, 0: ReonekyRoom_OnFrame
    ]
    MAP_SCRIPT_ON_TRANSITION: ReonekyRoom_OnTransition
     MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
		VAR_TEMP_8, 0: ReonekyRoom_OnWarp_PlayerTurnNorth
    ]
    MAP_SCRIPT_ON_LOAD: ReonekyRoom_OnLoad
}

script ReonekyRoom_OnLoad {
    if(flag(FLAG_DEFEATED_ADMIN_REONEKY)){
        call(WahRoomsShared_SetDoorAsOpen)
    }
    end
}

script ReonekyRoom_OnWarp_PlayerTurnNorth {
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    end
}


script ReonekyRoom_OnTransition {
    call(WahRoomsShared_Kecleon_SetSala_Reoneky)
    if(var(VAR_TEMP_0_REONEKY_ROOM_STATE) == 0) {
        setflag(FLAG_TEMP_2_REONEKYROOM_HIDE_FIRE)
        setflag(FLAG_TEMP_3_REONEKYROOM_HIDE_HAUNTER)
    }
    if(var(VAR_TEMP_0_REONEKY_ROOM_STATE) == 1) {
        setobjectmovementtype2(LOCALID_REOROOM_REONEKY, MOVEMENT_TYPE_FACE_DOWN)
        setobjectmovementtype(LOCALID_REOROOM_REONEKY, MOVEMENT_TYPE_FACE_DOWN)
        setobjectxy(LOCALID_REOROOM_REONEKY, 6, 4)
        setobjectxyperm(LOCALID_REOROOM_REONEKY, 6, 4)
    }
    end
}

script ReonekyRoom_OnFrame {
    playbgm(MUS_TEAM_ORIGEN_TO, FALSE)
    special(ShowMapNamePopup)
    release
    applymovementandwait(LOCALID_PLAYER, Common_Movement_WalkUp2)
    special(SpawnCameraObject)
    directcameramovementtopos(6, 7)
    waitmovement(0)
    applymovementandwait(LOCALID_REOROOM_REONEKY, Common_Movement_WalkInPlaceRight)
    special(HideMapNamePopUpWindow)
    msgbox(format("Spitfire, keep your distance!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_REONEKY)
    playse(SE_PIN)
    applymovementandwait(LOCALID_REOROOM_TYPHLOSION, Common_Movement_DoubleExclamationMark)
    release
    playmoncry(SPECIES_TYPHLOSION, CRY_MODE_NORMAL)
    waitmoncry
    msgbox(format("That possessed tow truck is the embodiment of bureaucratic injustice!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_REONEKY)
    playse(SE_PIN)
    playmoncry(SPECIES_HAUNTER, CRY_MODE_ENCOUNTER)
    applymovementandwait(LOCALID_REOROOM_CRANE, moves(
        emote_xd
        jump_in_place_left * 2
        delay_16
        jump_in_place_left))
    playse(SE_PIN)
    applymovement(LOCALID_REOROOM_REONEKY, moves(emote_angry))
    waitmovement(0)
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_REOROOM_REONEKY, moves(jump_in_place_right))
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_REOROOM_REONEKY, moves(jump_in_place_right))
    msgbox(format("Laughing, huh? Amateur…"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_REONEKY)
    delay(60)
    msgbox(format("I was parked perfectly - I won't give in to this unjust fine!"), speaker = SP_NAME_REONEKY)
    applymovementandwait(LOCALID_REOROOM_REONEKY, Common_Movement_WalkInPlaceRight)
    msgbox(format("Spitfire, Zen Headbutt!"))
    playse(SE_PIN)
    applymovementandwait(LOCALID_REOROOM_TYPHLOSION, Common_Movement_Versus)
    waitse
    playmoncry(SPECIES_TYPHLOSION, CRY_MODE_ENCOUNTER)
    waitmoncry
    playse(SE_M_THUNDERBOLT2)
    applymovementandwait(LOCALID_REOROOM_TYPHLOSION, moves(
        lock_facing_direction
        walk_fast_right
        jump_in_place_right
        walk_fast_left
        unlock_facing_direction
    ))
    playse(SE_EFFECTIVE)
    applymovementandwait(LOCALID_REOROOM_CRANE, moves(
        emote_x
        lock_facing_direction
        walk_in_place_left
        walk_right
        delay_16
        unlock_facing_direction))
    release
    delay(30)
    applymovementandwait(LOCALID_REOROOM_REONEKY, Common_Movement_WalkLeftLockFacingDirection)
    msgbox(format("Now's our chance! Flame Wheel!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_REONEKY)
    delay(20)
    applymovementandwait(LOCALID_REOROOM_TYPHLOSION, Common_Movement_JumpLeftLockFacingDirection)
    playse(SE_M_FLAME_WHEEL)
    clearflag(FLAG_TEMP_2_REONEKYROOM_HIDE_FIRE)
    addobject(LOCALID_REOROOM_FIREATTACK)
    showobjectat(LOCALID_REOROOM_FIREATTACK, MAP_REONEKY_ROOM)
	setobjectsubpriority(LOCALID_REOROOM_FIREATTACK, MAP_REONEKY_ROOM, 0)
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_REOROOM_TYPHLOSION, Common_Movement_JumpInPlaceRight)
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_REOROOM_TYPHLOSION, Common_Movement_JumpInPlaceRight)
    playse(SE_M_FIRE_PUNCH)
    applymovementandwait(LOCALID_REOROOM_FIREATTACK, Common_Movement_WalkRight3)
    release
    delay(30)
    playse(SE_M_FLAME_WHEEL2)
    applymovementandwait(LOCALID_REOROOM_CRANE, Common_Movement_CraneStartBurning)
    setobjectmovementtype2(LOCALID_REOROOM_CRANE, MOVEMENT_TYPE_CRANE_BURNING_UP)
    waitse
    playse(SE_SUPER_EFFECTIVE)
    fadescreen(FADE_TO_WHITE)
    playmoncry(SPECIES_HAUNTER, CRY_MODE_ENCOUNTER)
    setflag(FLAG_TEMP_2_REONEKYROOM_HIDE_FIRE)
    removeobject(LOCALID_REOROOM_FIREATTACK)
    turnobject(LOCALID_REOROOM_CRANE, DIR_SOUTH)
    clearflag(FLAG_TEMP_3_REONEKYROOM_HIDE_HAUNTER)
    addobject(LOCALID_REOROOM_HAUNTER)
    showobjectat(LOCALID_REOROOM_HAUNTER, MAP_REONEKY_ROOM)
    delay(30)
    release
    fadescreen(FADE_FROM_WHITE)
    playse(SE_PIN)
    applymovementandwait(LOCALID_REOROOM_HAUNTER, moves(
        emote_cry
        walk_in_place_fast_right
        walk_fast_down
        walk_fast_left * 5
        delay_16
    ))
    waitse
    playse(SE_M_FAINT_ATTACK)
    applymovementandwait(LOCALID_REOROOM_HAUNTER, moves(
        set_invisible
        delay_8
        set_visible
        delay_8
        set_invisible
        delay_16
        set_visible
        delay_8
        set_invisible
        delay_16
        set_visible
        delay_8
        set_invisible
    ))
    waitse
    setflag(FLAG_TEMP_3_REONEKYROOM_HIDE_HAUNTER)
    removeobject(LOCALID_REOROOM_HAUNTER)
    fadedefaultbgm
    playse(SE_LEDGE)
    applymovement(LOCALID_REOROOM_REONEKY, Common_Movement_JumpInPlaceRight)
    waitmovement(0)
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_REOROOM_REONEKY, Common_Movement_JumpInPlaceRight)
    msgbox(format("There, off you go!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_REONEKY)
    delay(20)
    applymovementandwait(LOCALID_REOROOM_TYPHLOSION, Common_Movement_WalkInPlaceLeft)
    release
    msgbox(format("You rock, you rule, buddy! We shook off the ghost of the fine!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_REONEKY)
    playse(SE_PIN)
    applymovement(LOCALID_REOROOM_REONEKY, Common_Movement_HappyWithDelay48)
    applymovement(LOCALID_REOROOM_TYPHLOSION, moves(emote_happy, walk_in_place_fast_left * 3))
    waitmovement(LOCALID_REOROOM_REONEKY)
    release
    msgbox(format("Good thing J15 said he had it under control, what a mess…\pI really should have listened to Keltill… He drives his tuned-up Miata and never gets fined, they only pull him over to take photos with it…"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_REONEKY)
    playse(SE_PIN)
    applymovementandwait(LOCALID_REOROOM_REONEKY, Common_Movement_SweatDropWithDelay48)
    delay(20)
    release
    msgbox(format("Anyway… you did great, buddy, time to rest!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_REONEKY)
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_REOROOM_TYPHLOSION, Common_Movement_JumpInPlaceLeft)
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_REOROOM_TYPHLOSION, Common_Movement_JumpInPlaceLeft)
    playmoncry(SPECIES_TYPHLOSION, CRY_MODE_NORMAL)
    waitmoncry
    playse(SE_BALL_OPEN)
    fadescreen(FADE_TO_WHITE)
    setflag(FLAG_TEMP_1_REONEKYROOM_HIDE_TYPHLOSION)
    removeobject(LOCALID_REOROOM_TYPHLOSION)
    fadescreen(FADE_FROM_WHITE)
    setvar(VAR_TEMP_0_REONEKY_ROOM_STATE, 1)
    applymovementandwait(LOCALID_REOROOM_REONEKY, moves(walk_right * 2, walk_up, walk_right * 2, walk_up * 2, face_down ))
    directcameramovementtopos(6, 10)
    waitmovement(0)
    setobjectxyperm(LOCALID_REOROOM_REONEKY, 6, 4)
    setobjectmovementtype2(LOCALID_REOROOM_REONEKY, MOVEMENT_TYPE_FACE_DOWN)
    special(RemoveCameraObject)
    release
    end
}

script ReonekyRoom_EventScript_Reoneky {
    if(flag(FLAG_DEFEATED_ADMIN_REONEKY)) {
        lock
        release
        faceplayer
        msgbox(format("A stroke of luck happens when you seize a good opportunity!\pDon't let anyone stop you… and above all, enjoy the moment."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_REONEKY)
        playse(SE_PIN)
        applymovementandwait(LOCALID_REOROOM_REONEKY, Common_Movement_HappyWithDelay48)
        release
        end
    }
    lock
    release
    faceplayer
    msgbox(format("Hey! Quite a show you just witnessed, huh?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_REONEKY)
    playse(SE_PIN)
    applymovementandwait(LOCALID_REOROOM_REONEKY, Common_Movement_SmileWithDelay48)
    delay(30)
    msgbox(format("By now you probably know what I do here, so let me introduce myself.\pI'm Reoneky, expert at carrying the prefix “ex,” in both my work and my career."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_REONEKY)
    delay(20)
    msgbox(format("I might look like an emo, but I consider myself more introspective than anything."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_REONEKY)
    playse(SE_PIN)
    applymovementandwait(LOCALID_REOROOM_REONEKY, Common_Movement_ThinkingWithDelay48)
    msgbox(format("I was nobody… I felt like I was nobody… and WaH changed that.\pSo enough with the sentimentality and introductions - let's get to it.\pCool head, warm heart, that's how the game is played."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_REONEKY)
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_REOROOM_REONEKY, moves(
        lock_facing_direction
        jump_in_place_down))
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_REOROOM_REONEKY, moves(
        jump_in_place_down
        unlock_facing_direction
        face_player))
    msgbox(format("Let's give it everything!"), speaker = SP_NAME_REONEKY)
    playse(SE_PIN)
    applymovementandwait(LOCALID_REOROOM_REONEKY, moves(emote_versus))
    waitse
    call(ReonekyRoom_EventScript_ReonekyBattle)
    msgbox(format("You show promise. Talent has limits; effort and passion don't."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_REONEKY)
    playse(SE_PIN)
    applymovementandwait(LOCALID_REOROOM_REONEKY, Common_Movement_HappyWithDelay48)
    delay(20)
    msgbox(format("A stroke of luck happens when you seize a good opportunity!\pDon't let anyone stop you… and above all, enjoy the moment."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_REONEKY)
    call(WahRoomsShared_OpenDoor)
    delay(30)
    setflag(FLAG_DEFEATED_ADMIN_REONEKY)
    call(WahRoomsShared_EventScript_AfterBattle)
    release
    end
}

script ReonekyRoom_EventScript_ReonekyBattle {
    if (!flag(FLAG_WAH_CHALLENGE_COMPLETED)) {
        trainerbattle_no_intro(TRAINER_WAH_ADMIN_REONEKY_MAIN, ReonekyRoom_Text_ReonekyDefeated)
    } else {
        setvar(VAR_0x8004, TEAM_INDEX_REONEKY)
        special(ShouldUseAlternativeTeam)
        if (var(VAR_RESULT) == 0) {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_REONEKY_MAIN, ReonekyRoom_Text_ReonekyDefeated)
        } else {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_REONEKY_ALTERNATIVE, ReonekyRoom_Text_ReonekyDefeated)
        }
    }
    return
}

text ReonekyRoom_Text_ReonekyDefeated {
    format("Good battle - I had fun like a kid.")
}


script ReonekyRoom_EventScript_Trash {
    msgbox(format("The wastebasket is completely empty.\pPeople may have thrown their trash out on the street."), MSGBOX_SIGN)
    end
}

script ReonekyRoom_EventScript_Hydrant {
    msgbox(format("It's a small hydrant painted bright red."), MSGBOX_SIGN)
    end
}

script ReonekyRoom_EventScript_Bidon {
    msgbox(format("It's a drum filled to the top with used oil."), MSGBOX_SIGN)
    end
}