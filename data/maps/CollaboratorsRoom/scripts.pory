const VAR_TEMP_1_COLLABORATORS_ALEXMAD_PUZZLE_SWAP_FEEDBACK_PENDING = VAR_TEMP_1
const COLLABORATOR_NO_FAINT_BIT_KAKTUS = 0
const COLLABORATOR_NO_FAINT_BIT_GAMEBOYCL = 1
const COLLABORATOR_NO_FAINT_BIT_ERKEY = 2
const COLLABORATOR_NO_FAINT_BIT_MICOLO = 3
const COLLABORATOR_NO_FAINT_BIT_MRNIGHTOLOGY = 4
const COLLABORATOR_NO_FAINT_BIT_GOSUTO = 5
const COLLABORATOR_NO_FAINT_BIT_ACIMUT = 6
const COLLABORATOR_NO_FAINT_BIT_ALEXMAD = 7
const COLLABORATOR_NO_FAINT_BIT_RYUZAKI = 8
const COLLABORATOR_NO_FAINT_BIT_CACO = 9

mapscripts CollaboratorsRoom_MapScripts {
    MAP_SCRIPT_ON_RETURN_TO_FIELD: CollaboratorsRoom_OnReturnToField
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_1_COLLABORATORS_ALEXMAD_PUZZLE_SWAP_FEEDBACK_PENDING, 1: CollaboratorsRoom_EventScript_AlexmadPuzzleSwapFeedback
    ]
}

script CollaboratorsRoom_OnReturnToField {
    special(QueueAlexmadPartySwapFeedbackIfNeeded)
    end
}

script CollaboratorsRoom_EventScript_AfterBattleCollaborators {
    special(Special_UpdateCollaboratorsNoFaintProgress)
    call(Achievements_EventScript_Eval_DefeatAllCollaborators)
    call(Achievements_EventScript_Eval_DefeatAllCollaboratorsNoFaints)
    call(WahRoomsShared_EventScript_AfterBattle)
    return
}


script CollaboratorsRoom_EventScript_Kaktus_IntroFirstBattle {
    msgbox("Well, well…\nSo you completed the challenge?", MSGBOX_AUTOCLOSE, speaker = SP_NAME_INMORTAL_KAKTUS)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_SurpriseWithDelay48)
    msgbox(format("Then you're no rookie anymore... let's see if you can apply what you've learned.\pOne battle, no shortcuts, no tricks. Ready?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_INMORTAL_KAKTUS)
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    switch(var(VAR_RESULT)) {
        case DIR_NORTH:
            applymovementandwait(LOCALID_PLAYER, Common_Movement_WalkInPlaceUp)
        case DIR_SOUTH:
            applymovementandwait(LOCALID_PLAYER, Common_Movement_WalkInPlaceDown)
        case DIR_WEST:
            applymovementandwait(LOCALID_PLAYER, Common_Movement_WalkInPlaceLeft)
        case DIR_EAST:
            applymovementandwait(LOCALID_PLAYER, Common_Movement_WalkInPlaceRight)
    }
    return
}

script CollaboratorsRoom_EventScript_Kaktus_TalkOnly {
    msgbox(format("You know? A lot of people in the community started out watching my tutorials."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_INMORTAL_KAKTUS)
    delay(20)
    call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
    msgbox(format("Though to be honest… the first one I made was so embarrassing that I deleted it."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_INMORTAL_KAKTUS)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_SweatDropWithDelay48)
    goto(CollaboratorsRoom_EventScript_Kaktus_OnFinishEvent)
}

script CollaboratorsRoom_EventScript_Kaktus_IntroRematch {
    msgbox(format("Hey, how's it going? My Ludicolo still feels like dancing."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_INMORTAL_KAKTUS)
    delay(20)
    setspeaker(SP_NAME_INMORTAL_KAKTUS)
    message(format("Another round?"))
    waitmessage
    dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, CollaboratorsRoom_RematchMultichoice_Rematch, CollaboratorsRoom_RematchMultichoice_TalkOnly, CollaboratorsRoom_RematchMultichoice_Exit)
    closemessage
    delay(20)
    switch(var(VAR_RESULT)) {
        case 0:
            msgbox(format("Let's go!"), speaker = SP_NAME_INMORTAL_KAKTUS)
            return
        case 1:
            goto(CollaboratorsRoom_EventScript_Kaktus_TalkOnly)
        default:
            msgbox(format("Another time, then!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_INMORTAL_KAKTUS)
            goto(CollaboratorsRoom_EventScript_Kaktus_OnFinishEvent)
    }
}

script CollaboratorsRoom_EventScript_Kaktus_OnFinishEvent {
    turnobject(VAR_LAST_TALKED, DIR_EAST)
    release
    end
}

script CollaboratorsRoom_EventScript_Kaktus {
    lock
    faceplayer
    if(flag(FLAG_WAH_CHALLENGE_COMPLETED) == TRUE){
         if(flag(FLAG_DEFEATED_COLLABORATORS_ROOM_KAKTUS)) {
            call(CollaboratorsRoom_EventScript_Kaktus_IntroRematch)
        } else {
            call(CollaboratorsRoom_EventScript_Kaktus_IntroFirstBattle)
        }
        
        playse(SE_PIN)
        applymovement(LOCALID_PLAYER, Common_Movement_VersusWithDelay48)
        applymovement(VAR_LAST_TALKED, Common_Movement_VersusWithDelay48)
        waitmovement(0)
        setflag(B_FLAG_NO_WHITEOUT)
        trainerbattle_no_intro(TRAINER_WAH_COLLABORATOR_KAKTUS, format("Did I just lose?"))
        clearflag(B_FLAG_NO_WHITEOUT)
        specialvar(VAR_RESULT, GetBattleOutcome)
        if (var(VAR_RESULT) == B_OUTCOME_WON) {
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_XWithDelay48)
            msgbox(format("Ha… I lost."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_INMORTAL_KAKTUS)
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_ThinkingWithDelay48)
            call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
            msgbox(format("But this is the beautiful thing about this community.\pThere's always someone new who surprises you."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_INMORTAL_KAKTUS)
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_HeartWithDelay48)
            call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
            msgbox(format("Congrats, champ."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_INMORTAL_KAKTUS)
            setflag(FLAG_DEFEATED_COLLABORATORS_ROOM_KAKTUS)
        } else {
            msgbox(format("You're good, but you still need to train to be able to beat me."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_INMORTAL_KAKTUS)
            playse(SE_LEDGE)
            applymovementandwait(VAR_LAST_TALKED, moves(lock_facing_direction, jump_in_place_down))
            playse(SE_LEDGE)
            applymovement(VAR_LAST_TALKED, moves(jump_in_place_down, unlock_facing_direction, face_player))
            waitmovement(0)
            msgbox(format("Looking forward to a rematch soon!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_INMORTAL_KAKTUS)
        }
        setvar(VAR_0x8004, COLLABORATOR_NO_FAINT_BIT_KAKTUS)
        call(CollaboratorsRoom_EventScript_AfterBattleCollaborators)
        goto(CollaboratorsRoom_EventScript_Kaktus_OnFinishEvent)
    } else {
        goto(CollaboratorsRoom_EventScript_Kaktus_TalkOnly)
    }
}

script CollaboratorsRoom_EventScript_Gameboycl_IntroFirstBattle {
    delay(20)
    msgbox(format("I'm not competitive or ambitious."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GAMEBOY_CL)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_ThinkingWithDelay48)
    msgbox(format("I'm more of a mediocre person, really."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GAMEBOY_CL)
    delay(20)
    call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
    msgbox(format("That can work against me."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GAMEBOY_CL)
    return
}

script CollaboratorsRoom_EventScript_Gameboycl_TalkOnly {
    msgbox("A ROM hack is like architecture:\nyou build on what already exists.", MSGBOX_AUTOCLOSE, speaker = SP_NAME_GAMEBOY_CL)
    call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
    msgbox("The art here isn't what you change,\nbut what you want to convey.", MSGBOX_AUTOCLOSE, speaker = SP_NAME_GAMEBOY_CL)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_HeartWithDelay48)
    delay(20)
    goto(CollaboratorsRoom_EventScript_Gameboycl_OnFinishEvent)
}

script CollaboratorsRoom_EventScript_Gameboycl_IntroRematch {
    msgbox(format("Kanto and Johto meet in the same blue; water remembers no borders."),MSGBOX_AUTOCLOSE, speaker = SP_NAME_GAMEBOY_CL)
    delay(20)
    setspeaker(SP_NAME_GAMEBOY_CL)
    message(format("Want to battle one of my 3 teams?"))
    waitmessage
    dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, CollaboratorsRoom_RematchMultichoice_Rematch, CollaboratorsRoom_RematchMultichoice_TalkOnly, CollaboratorsRoom_RematchMultichoice_Exit)
    closemessage
    delay(20)
    switch(var(VAR_RESULT)) {
        case 0:
            call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
            return
        case 1:
            goto(CollaboratorsRoom_EventScript_Gameboycl_TalkOnly)
        default:
            msgbox(format("The best thing in life isn't competing, but sharing."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GAMEBOY_CL)
            goto(CollaboratorsRoom_EventScript_Gameboycl_OnFinishEvent)
    }
}

script CollaboratorsRoom_EventScript_Gameboycl_OnFinishEvent {
    turnobject(VAR_LAST_TALKED, DIR_WEST)
    release
    end
}


script CollaboratorsRoom_EventScript_Gameboycl {
    lock
    faceplayer
    if(flag(FLAG_WAH_CHALLENGE_COMPLETED) == TRUE){
        if(flag(FLAG_DEFEATED_COLLABORATORS_ROOM_GAMEBOYCL)) {
            call(CollaboratorsRoom_EventScript_Gameboycl_IntroRematch)
        } else {
            call(CollaboratorsRoom_EventScript_Gameboycl_IntroFirstBattle)
        }
        delay(20)
        playse(SE_PIN)
        applymovement(VAR_LAST_TALKED, Common_Movement_VersusWithDelay48)
        applymovement(LOCALID_PLAYER, Common_Movement_VersusWithDelay48)
        waitmovement(0)
        random(3)
        setflag(B_FLAG_NO_WHITEOUT)
        switch(var(VAR_RESULT)) {
            case 0:
                trainerbattle_no_intro(TRAINER_WAH_COLLABORATOR_GAMEBOY_CL_1, CollaboratorsRoom_Text_Gameboycl_OnDefeat)
            case 1:
                trainerbattle_no_intro(TRAINER_WAH_COLLABORATOR_GAMEBOY_CL_2, CollaboratorsRoom_Text_Gameboycl_OnDefeat)
            case 2:
                trainerbattle_no_intro(TRAINER_WAH_COLLABORATOR_GAMEBOY_CL_3, CollaboratorsRoom_Text_Gameboycl_OnDefeat)
        }
        clearflag(B_FLAG_NO_WHITEOUT)
        specialvar(VAR_RESULT, GetBattleOutcome)
        if (var(VAR_RESULT) == B_OUTCOME_WON) {
            call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
            msgbox(format("I definitely prefer sharing over competing."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GAMEBOY_CL)
            playse(SE_PIN)
            applymovement(VAR_LAST_TALKED, Common_Movement_HappyWithDelay48)
            waitmovement(0)
            setflag(FLAG_DEFEATED_COLLABORATORS_ROOM_GAMEBOYCL)
        } else {
            msgbox(format("When you feel ready, come back and we'll test our teams in a duel."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GAMEBOY_CL)
        }
        setvar(VAR_0x8004, COLLABORATOR_NO_FAINT_BIT_GAMEBOYCL)
        call(CollaboratorsRoom_EventScript_AfterBattleCollaborators)
        goto(CollaboratorsRoom_EventScript_Gameboycl_OnFinishEvent)
    } else {
        goto(CollaboratorsRoom_EventScript_Gameboycl_TalkOnly)
    }
}

text CollaboratorsRoom_Text_Gameboycl_OnDefeat {
    format("To evolve is also to look back.")
}

script CollaboratorsRoom_EventScript_Erkey_IntroFirstBattle {
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_ThinkingWithDelay48)
    msgbox(format("The strong will be weak. The weak will be decisive.\pGet ready for an {COLOR RED}inverse battle{COLOR DARK_GRAY}!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ERKEY)
    call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
    return
}

script CollaboratorsRoom_EventScript_Erkey_TalkOnly {
    msgbox(format("Here, every battle teaches something."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ERKEY)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_ThinkingWithDelay48)
    msgbox(format("If you pay attention."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ERKEY)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_WinkWithDelay48)
    goto(CollaboratorsRoom_EventScript_Erkey_OnFinishEvent)
}

script CollaboratorsRoom_EventScript_Erkey_IntroRematch {
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_QuestionMarkWithDelay48)
    msgbox(format("Again?\nThe rules are still reversed… just in case."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ERKEY)
    delay(20)
    setspeaker(SP_NAME_ERKEY)
    message(format("Want to battle again?"))
    waitmessage
    dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, CollaboratorsRoom_RematchMultichoice_Rematch, CollaboratorsRoom_RematchMultichoice_TalkOnly, CollaboratorsRoom_RematchMultichoice_Exit)
    closemessage
    delay(20)
    switch(var(VAR_RESULT)) {
        case 0:
            msgbox(format("Perfect. Let's see if this time you master it."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ERKEY)
            playse(SE_PIN)
            applymovement(VAR_LAST_TALKED, Common_Movement_SmileWithDelay48)
            waitmovement(0)
            delay(30)
            return
        case 1:
            goto(CollaboratorsRoom_EventScript_Erkey_TalkOnly)
        default:
            msgbox(format("Come back whenever you want.\nHere, nothing goes back to normal."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ERKEY)
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_WinkWithDelay48)
            goto(CollaboratorsRoom_EventScript_Erkey_OnFinishEvent)
    }
}

script CollaboratorsRoom_EventScript_Erkey_OnFinishEvent {
    turnobject(VAR_LAST_TALKED, DIR_WEST)
    release
    end
}

script CollaboratorsRoom_EventScript_Erkey {
    lock
    faceplayer
    if(flag(FLAG_WAH_CHALLENGE_COMPLETED) == TRUE) {
        if(flag(FLAG_DEFEATED_COLLABORATORS_ROOM_ERKEY)) {
            call(CollaboratorsRoom_EventScript_Erkey_IntroRematch)
        } else {
            call(CollaboratorsRoom_EventScript_Erkey_IntroFirstBattle)
        }
        playse(SE_PIN)
        applymovement(LOCALID_PLAYER, Common_Movement_VersusWithDelay48)
        applymovement(VAR_LAST_TALKED, Common_Movement_VersusWithDelay48)
        waitmovement(0)
        setflag(B_FLAG_NO_WHITEOUT)
        setflag(FLAG_INVERSE_BATTLE)
        trainerbattle_no_intro(TRAINER_WAH_COLLABORATOR_ERKEY, format("You handled it perfectly."))
        clearflag(FLAG_INVERSE_BATTLE)
        clearflag(B_FLAG_NO_WHITEOUT)
        specialvar(VAR_RESULT, GetBattleOutcome)
        if(var(VAR_RESULT) == B_OUTCOME_WON) {
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_SmileWithDelay48)
            msgbox(format("Well played."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ERKEY)
            call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
            delay(20)
            msgbox(format("When the rules change, you adapted.\pThat's the spirit of Whack a Hack."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ERKEY)
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_HeartWithDelay48)
            setflag(FLAG_DEFEATED_COLLABORATORS_ROOM_ERKEY)
        } else {
            msgbox(format("Habit weighs more than it seems.\nHere it costs you dearly."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ERKEY)
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_SweatDropWithDelay48)
        }
        setvar(VAR_0x8004, COLLABORATOR_NO_FAINT_BIT_ERKEY)
        call(CollaboratorsRoom_EventScript_AfterBattleCollaborators)
        goto(CollaboratorsRoom_EventScript_Erkey_OnFinishEvent)
    } else {
        goto(CollaboratorsRoom_EventScript_Erkey_TalkOnly)
    }
}

script CollaboratorsRoom_EventScript_Micolo_IntroFirstBattle {
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_DoubleExclamationMark)
    waitse
    playse(SE_LEDGE)
    applymovement(VAR_LAST_TALKED, moves(lock_facing_direction,jump_in_place_down, unlock_facing_direction, face_player))
    waitmovement(0)
    msgbox(format("Well, you've beaten the room challenge.\pLet's see, then, if you're good with the Pokémon I've bred and trained."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MICOLO)
    call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
    call(CollaboratorsRoom_EventScript_Micolo_ExplainPartyLimit)
    return
}

script CollaboratorsRoom_EventScript_Micolo_TalkOnly {
    call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
    msgbox(format("Most of the folks in the rooms I don't know - only three of them.\pThe rest, until I handed them their Pokémon, I had no idea who they were."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MICOLO)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_SweatDropWithDelay48)
    msgbox(format("Yes, most of the Pokémon in this building I bred myself, including all the ones you might get to use.\pAll trained by me and ready to battle."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MICOLO)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_HappyWithDelay48)
    msgbox(format("I also helped the building's architect get the Pokémon of his dreams.\pYou wouldn't believe how tiresome he was going on about how thrilled he'd be, even showing it off in his room like a hypocrite while wiping the drool off his chin."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MICOLO)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_AnnoyedWithDelay48)
    msgbox(format("What he doesn't know is I gave him a near-perfect specimen; the perfect one I've kept, ready to help you when you pick his team."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MICOLO)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_XD)
    playse(SE_LEDGE)
    applymovementandwait(VAR_LAST_TALKED, moves(lock_facing_direction, jump_in_place_down))
    playse(SE_LEDGE)
    applymovement(VAR_LAST_TALKED, moves(jump_in_place_down, unlock_facing_direction, face_player, delay_16))
    waitmovement(0)
    msgbox(format("The rest were the labor that built this place."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MICOLO)
    delay(30)
    goto(CollaboratorsRoom_EventScript_Micolo_OnFinishEvent)
}

script CollaboratorsRoom_EventScript_Micolo_IntroRematch {
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_QuestionMarkWithDelay48)
    msgbox(format("Another battle? I'll again pick a Pokémon from my team at random."), MSGBOX_AUTOCLOSE,speaker = SP_NAME_MICOLO)
    delay(20)
    setspeaker(SP_NAME_MICOLO)
    message(format("You dare?"))
    waitmessage
    dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, CollaboratorsRoom_RematchMultichoice_Rematch, CollaboratorsRoom_RematchMultichoice_TalkOnly, CollaboratorsRoom_RematchMultichoice_Exit)
    closemessage
    delay(20)
    switch(var(VAR_RESULT)) {
        case 0:
            call(CollaboratorsRoom_EventScript_Micolo_ExplainPartyLimit)
            return
        case 1:
            goto(CollaboratorsRoom_EventScript_Micolo_TalkOnly)
        default:
            msgbox(format("Whenever you like… My specimens won't get any worse for waiting."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MICOLO)
            goto(CollaboratorsRoom_EventScript_Micolo_OnFinishEvent)
    }
}

script CollaboratorsRoom_EventScript_Micolo_ExplainPartyLimit {
    switch(var(VAR_DIFFICULTY)) {
        case DIFFICULTY_EASY:
            msgbox(format("Pick two Pokémon to battle. I'll choose one of my specimens at random to face you."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MICOLO)
            break
        case DIFFICULTY_NORMAL:
            msgbox(format("Pick two Pokémon to battle. I'll choose one of my specimens at random to face you."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MICOLO)
            break
        default:
            msgbox(format("Let's battle with one Pokémon each. Pick yours; I'll choose one from my team at random!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MICOLO)
            break
    }
    return
}

script CollaboratorsRoom_EventScript_Micolo_OnFinishEvent {
    turnobject(VAR_LAST_TALKED, DIR_WEST)
    releaseall
    end
}

script CollaboratorsRoom_EventScript_Micolo {
    lock
    faceplayer
    if(flag(FLAG_WAH_CHALLENGE_COMPLETED) == TRUE) {
        if(flag(FLAG_DEFEATED_COLLABORATORS_ROOM_MICOLO)) {
            call(CollaboratorsRoom_EventScript_Micolo_IntroRematch)
        } else {
            call(CollaboratorsRoom_EventScript_Micolo_IntroFirstBattle)
        }
        special(SavePlayerParty)
        setvar(VAR_FRONTIER_FACILITY, FRONTIER_FACILITY_TOWER)
        setvar(VAR_0x8004, FRONTIER_LVL_OPEN)
        switch(var(VAR_DIFFICULTY)) {
            case DIFFICULTY_EASY:
                setvar(VAR_0x8005, 2)
                break
            case DIFFICULTY_NORMAL:
                setvar(VAR_0x8005, 2)
                break
            default:
                setvar(VAR_0x8005, 1)
                break
        }
        fadescreen(FADE_TO_BLACK)
        special(ChoosePartyForBattleFrontier)
        waitstate
        lockall
        if(var(VAR_RESULT) == 0) {
            special(LoadPlayerParty)
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_SweatDropWithDelay48)
            msgbox(format("Afraid to face one of my specimens? After how hard it was to clear the rooms…"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MICOLO)
            call(CollaboratorsRoom_EventScript_Micolo_OnFinishEvent)
            end
        }
        playse(SE_PIN)
        applymovement(VAR_LAST_TALKED, Common_Movement_VersusWithDelay48)
        applymovement(LOCALID_PLAYER, Common_Movement_VersusWithDelay48)
        waitmovement(0)
        special(ReducePlayerPartyToSelectedMons)
        setflag(B_FLAG_NO_WHITEOUT)
        trainerbattle_no_intro(TRAINER_WAH_COLLABORATOR_MICOLO, format("Well, you beat me."))
        clearflag(B_FLAG_NO_WHITEOUT)
        specialvar(VAR_RESULT, GetBattleOutcome)
        special(LoadPlayerParty)
        if(var(VAR_RESULT) == B_OUTCOME_WON) {
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_SurpriseWithDelay48)
            msgbox(format("I admit you're good; if I'd had my little one, I'd surely have beaten you, congratulations."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MICOLO)
            call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
            setflag(FLAG_DEFEATED_COLLABORATORS_ROOM_MICOLO)
        } else {
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_SweatDropWithDelay48)
            msgbox(format("You're not bad, but you'll have to do a whole lot better if you want to beat me."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MICOLO)
            playse(SE_LEDGE)
            applymovementandwait(VAR_LAST_TALKED, moves(lock_facing_direction, jump_in_place_down))
            playse(SE_LEDGE)
            applymovementandwait(VAR_LAST_TALKED, moves(jump_in_place_down, unlock_facing_direction, face_player))
        }
        setvar(VAR_0x8004, COLLABORATOR_NO_FAINT_BIT_MICOLO)
        call(CollaboratorsRoom_EventScript_AfterBattleCollaborators)
        goto(CollaboratorsRoom_EventScript_Micolo_OnFinishEvent)
    } else {
        goto(CollaboratorsRoom_EventScript_Micolo_TalkOnly)
    }
}

script CollaboratorsRoom_EventScript_Lillipup {
    lock
    faceplayer
    playmoncry(SPECIES_LILLIPUP, CRY_MODE_NORMAL)
    msgbox(format("Pup, pup, pup."), MSGBOX_AUTOCLOSE)
    waitmoncry
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_HeartWithDelay48)
    turnobject(VAR_LAST_TALKED, DIR_EAST)
    release
    end
}

script CollaboratorsRoom_EventScript_MrNightology_IntroFirstBattle {
    msgbox(format("Looking for trouble?\nThen listen to our motto!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MRNIGHTOLOGY)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, moves(emote_exclamation_mark))
    waitse
    msgbox(format("Oops, my mistake!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MRNIGHTOLOGY)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, moves(emote_sweat_drop))
    waitse
    msgbox(format("Sorry, force of habit, heh heh…\pWell, from what I can see you've completed the challenge.\pCongratulations!\pBut… not for long!\nThe time has come to put you to the test once more!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MRNIGHTOLOGY)
    return
}

script CollaboratorsRoom_EventScript_MrNightology_TalkOnly {
    faceplayer
    msgbox(format("Oh, if only I could tell you…\pI released Beta 1 of my hack in 2010 and 15 years later, I finally finished it."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MRNIGHTOLOGY)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, moves(emote_sad))
    waitse
    msgbox(format("A long journey, only for people to end up asking you what the cheat for infinite Rare Candies is."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MRNIGHTOLOGY)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, moves(emote_annoyed))
    waitse
    msgbox(format("Does that seem right to you?\nAnyway… the life of a ROM hacker."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MRNIGHTOLOGY)
    goto(CollaboratorsRoom_EventScript_MrNightology_OnFinishEvent)
}

script CollaboratorsRoom_EventScript_MrNightology_IntroRematch {
    msgbox(format("You again!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MRNIGHTOLOGY)
    delay(20)
    setspeaker(SP_NAME_MRNIGHTOLOGY)
    message(format("Still hungry for more?"))
    waitmessage
    dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, CollaboratorsRoom_RematchMultichoice_Rematch, CollaboratorsRoom_RematchMultichoice_TalkOnly, CollaboratorsRoom_RematchMultichoice_Exit)
    closemessage
    switch(var(VAR_RESULT)) {
        case 0:
            msgbox(format("Ha! I figured as much…"), speaker = SP_NAME_MRNIGHTOLOGY)
            return
        case 1:
            goto(CollaboratorsRoom_EventScript_MrNightology_TalkOnly)
        default:
            msgbox(format("No?\nWell… you'll be back."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MRNIGHTOLOGY)
            goto(CollaboratorsRoom_EventScript_MrNightology_OnFinishEvent)
    }
}

script CollaboratorsRoom_EventScript_MrNightology_OnFinishEvent {
    turnobject(VAR_LAST_TALKED, DIR_SOUTH)
    release
    end
}

script CollaboratorsRoom_EventScript_MrNightology {
    lock
    if(flag(FLAG_WAH_CHALLENGE_COMPLETED)) {
        specialvar(VAR_RESULT, GetPlayerFacingDirection)
        switch(var(VAR_RESULT)){
            case DIR_WEST:
                fadescreen(FADE_TO_BLACK)
                applymovementandwait(LOCALID_PLAYER, moves(walk_down, walk_left, face_up))
                fadescreen(FADE_FROM_BLACK)
                break
            case DIR_EAST:
                fadescreen(FADE_TO_BLACK)
                applymovementandwait(LOCALID_PLAYER, moves(walk_down, walk_right, face_up))
                fadescreen(FADE_FROM_BLACK)
                break
        }

        if(flag(FLAG_DEFEATED_COLLABORATORS_ROOM_MRNIGHTOLOGY)) {
            call(CollaboratorsRoom_EventScript_MrNightology_IntroRematch)
        }
        else {
            call(CollaboratorsRoom_EventScript_MrNightology_IntroFirstBattle)
        }

        msgbox(format("I've got a brilliant plan to beat you, and for that I'll battle with a friend.\pSo…\nlet the special guest appear!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MRNIGHTOLOGY)
        applymovementandwait(VAR_LAST_TALKED, moves(face_up))
        playse(SE_POKENAV_ON)
        waitse
        applymovementandwait(VAR_LAST_TALKED, moves(walk_in_place_up))
        msgbox(format("Are you ready?\nYes? Great.\pGet over here!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MRNIGHTOLOGY)
        playse(SE_POKENAV_HANG_UP)
        waitse
        applymovementandwait(LOCALID_COLLABORATORS_ROOM_MRNIGHTOLOGY, moves(walk_in_place_down))
        playse(SE_WARP_OUT)
        setobjectxy(LOCALID_COLLABORATORS_ROOM_REONEKY, 11, 3)
        updateobjectsprite(LOCALID_COLLABORATORS_ROOM_REONEKY, OBJ_EVENT_GFX_REONEKY_TELEPORTING_1)
        showobjectat(LOCALID_COLLABORATORS_ROOM_REONEKY, MAP_COLLABORATORS_ROOM)
        turnobject(LOCALID_COLLABORATORS_ROOM_REONEKY, DIR_SOUTH)
        release
        delay(30)
        updateobjectsprite(LOCALID_COLLABORATORS_ROOM_REONEKY, OBJ_EVENT_GFX_REONEKY_TELEPORTING_2)
        release
        delay(30)
        updateobjectsprite(LOCALID_COLLABORATORS_ROOM_REONEKY, OBJ_EVENT_GFX_REONEKY)
        release
        playse(SE_PIN)
        applymovementandwait(LOCALID_COLLABORATORS_ROOM_MRNIGHTOLOGY, moves(emote_exclamation_mark, walk_in_place_right))
        waitse
        msgbox(format("Whoa!\nHow did you do that?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MRNIGHTOLOGY)
        applymovementandwait(LOCALID_COLLABORATORS_ROOM_REONEKY, moves(walk_in_place_left))
        msgbox(format("Damn! Instant Transmission, bro.\nI didn't spend all this time training on planet Yardrat for nothing!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_REONEKY)
        msgbox(format("Ah, how nice! That's perfect so next time I don't end up wrecked from so many hours on the bus!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MRNIGHTOLOGY)
        applymovement(LOCALID_COLLABORATORS_ROOM_MRNIGHTOLOGY, moves(walk_in_place_down))
        applymovement(LOCALID_COLLABORATORS_ROOM_REONEKY, moves(walk_in_place_down))
        waitmovement(0)
        msgbox(format("Surprised, huh?\nWell, the time has come…\pGet ready to battle!"), MSGBOX_DEFAULT, speaker = SP_NAME_MRNIGHTOLOGY)
        closemessage
        playse(SE_PIN)
        applymovement(LOCALID_COLLABORATORS_ROOM_REONEKY, Common_Movement_VersusWithDelay48)
        applymovement(VAR_LAST_TALKED, Common_Movement_VersusWithDelay48)
        waitmovement(0)
        waitse
        setflag(B_FLAG_NO_WHITEOUT)
        trainerbattle_two_trainers(TRAINER_WAH_COLLABORATOR_MRNIGHTOLOGY, format("What? But it was a brilliant plan!"), TRAINER_WAH_COLLABORATOR_REONEKY, format("Did I lose again?"))
        clearflag(B_FLAG_NO_WHITEOUT)
        specialvar(VAR_RESULT, GetBattleOutcome)
        if (var(VAR_RESULT) == B_OUTCOME_WON) {
            playse(SE_M_EXPLOSION)
            applymovement(VAR_LAST_TALKED, CollaboratorsRoom_Movement_MrNightology_Despegue)
            applymovement(LOCALID_COLLABORATORS_ROOM_REONEKY, CollaboratorsRoom_Movement_MrNightology_Despegue)
            waitmovement(0)
            waitse
            msgbox(format("Team Rocket's blasting off agaaaain…!"), MSGBOX_AUTOCLOSE_TOP)
            playse(SE_FALL)
            applymovementandwait(VAR_LAST_TALKED, moves(face_down, slide_down * 8))
            playse(SE_NOT_EFFECTIVE)
            waitse
            msgbox(format("What a landing!"), MSGBOX_DEFAULT, speaker = SP_NAME_MRNIGHTOLOGY)
            closemessage
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, moves(emote_question_mark))
            waitse
            applymovementandwait(VAR_LAST_TALKED, moves(walk_in_place_right, delay_16, walk_in_place_left, delay_16, walk_in_place_down))
            msgbox(format("And ReoNeky?\nI hope he landed in his room."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MRNIGHTOLOGY)
            setflag(FLAG_DEFEATED_COLLABORATORS_ROOM_MRNIGHTOLOGY)
        }
        else {
            msgbox(format("You did everything you could, but it's not enough."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MRNIGHTOLOGY)
            delay(20)
            call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
            msgbox(format("Rethink your strategy and…\pDon't keep us waiting long for the rematch!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_MRNIGHTOLOGY)
            fadescreen(FADE_TO_BLACK)
            setobjectxy(LOCALID_COLLABORATORS_ROOM_REONEKY, 11, -3)
            fadescreen(FADE_FROM_BLACK)
        }
        setvar(VAR_0x8004, COLLABORATOR_NO_FAINT_BIT_MRNIGHTOLOGY)
        call(CollaboratorsRoom_EventScript_AfterBattleCollaborators)
        goto(CollaboratorsRoom_EventScript_MrNightology_OnFinishEvent)
    } else {
        goto(CollaboratorsRoom_EventScript_MrNightology_TalkOnly)
    }
}

movement CollaboratorsRoom_Movement_MrNightology_Despegue{
    face_left
    delay_4
    face_down
    delay_4
    face_right
    delay_4
    face_up
    slide_up * 8
    step_end
}

script CollaboratorsRoom_EventScript_Gosuto_IntroFirstBattle {
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_SurpriseWithDelay48)
    msgbox(format("Oh! Looks like you've beaten the room challenge.\pHow about we put you to the test and see what you're capable of?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GOSUTO)
    call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
    msgbox(format("Shall we make this a bit more fun?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GOSUTO)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_FaceAwayPlayer)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_ThinkingWithDelay48)
    delay(20)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_FacePlayer)
    msgbox(format("Or rather - how about we make it twice as fun!?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GOSUTO)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_Happy)
    waitse
    playse(SE_LEDGE)
    applymovementandwait(VAR_LAST_TALKED, moves(lock_facing_direction, jump_in_place_down))
    waitse
    playse(SE_LEDGE)
    applymovementandwait(VAR_LAST_TALKED, moves(jump_in_place_down, unlock_facing_direction, face_player, delay_16))
    msgbox(format("All right, step into the world of darkness with me…"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GOSUTO)
    return
}

script CollaboratorsRoom_EventScript_Gosuto_TalkOnly {
    msgbox(format("Maybe you know me, maybe not, but I don't blame you; I pass like a shadow through the darkness."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GOSUTO)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_ThinkingWithDelay48)
    call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
    msgbox(format("But despite lurking in the shadows, I've contributed to great projects, doing my small part."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GOSUTO)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_HeartWithDelay48)
    call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
    msgbox(format("Enough said - back to processing pixels!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GOSUTO)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_HappyWithDelay48)
    goto(CollaboratorsRoom_EventScript_Gosuto_OnFinishEvent)
}

script CollaboratorsRoom_EventScript_Gosuto_IntroRematch {
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_QuestionMarkWithDelay48)
    setspeaker(SP_NAME_GOSUTO)
    message(format("Another battle? Are you sure you're ready to enter the world of darkness?"))
    waitmessage
    dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, CollaboratorsRoom_RematchMultichoice_Rematch, CollaboratorsRoom_RematchMultichoice_TalkOnly, CollaboratorsRoom_RematchMultichoice_Exit)
    closemessage
    delay(20)
    switch(var(VAR_RESULT)) {
        case 0:
            msgbox(format("Okay, let's see if this time you overcome your fears."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GOSUTO)
            return
        case 1:
            goto(CollaboratorsRoom_EventScript_Gosuto_TalkOnly)
        default:
            msgbox(format("Good thinking; though you can come back whenever you want."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GOSUTO)
            goto(CollaboratorsRoom_EventScript_Gosuto_OnFinishEvent)
    }
}

script CollaboratorsRoom_EventScript_Gosuto_OnFinishEvent {
    turnobject(VAR_LAST_TALKED, DIR_NORTH)
    release
    end
}

script CollaboratorsRoom_EventScript_Gosuto {
    lock
    faceplayer
    if(flag(FLAG_WAH_CHALLENGE_COMPLETED) == TRUE) {
        if(flag(FLAG_DEFEATED_COLLABORATORS_ROOM_GOSUTO)) {
            call(CollaboratorsRoom_EventScript_Gosuto_IntroRematch)
        } else {
            call(CollaboratorsRoom_EventScript_Gosuto_IntroFirstBattle)
        }
        playse(SE_PIN)
        applymovement(LOCALID_PLAYER, Common_Movement_VersusWithDelay48)
        applymovement(VAR_LAST_TALKED, Common_Movement_VersusWithDelay48)
        waitmovement(0)
        setflag(B_FLAG_NO_WHITEOUT)
        trainerbattle_no_intro(TRAINER_WAH_COLLABORATOR_GOSUTO, format("I think you've already overcome your fears and conquered the shadows."))
        clearflag(B_FLAG_NO_WHITEOUT)
        specialvar(VAR_RESULT, GetBattleOutcome)
        if(var(VAR_RESULT) == B_OUTCOME_WON) {
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_ThinkingWithDelay48)
            call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
            msgbox(format("Well, looks like you found a spark of luck.\pMake the most of that light while you can, because shadows are patient and the darkness always wins in the end."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GOSUTO)
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_WinkWithDelay48)
            setflag(FLAG_DEFEATED_COLLABORATORS_ROOM_GOSUTO)
        } else {
            msgbox(format("Don't feel bad; not everyone survives my darkness."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_GOSUTO)
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_WinkWithDelay48)
        }
        setvar(VAR_0x8004, COLLABORATOR_NO_FAINT_BIT_GOSUTO)
        call(CollaboratorsRoom_EventScript_AfterBattleCollaborators)
        goto(CollaboratorsRoom_EventScript_Gosuto_OnFinishEvent)
    } else {
        goto(CollaboratorsRoom_EventScript_Gosuto_TalkOnly)
    }
}


script CollaboratorsRoom_EventScript_Acimut_IntroFirstBattle {
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_MusicNote)
    msgbox(format("Wait! Do you hear that?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ACIMUT)
    waitse
    applymovementandwait(VAR_LAST_TALKED, moves(delay_16 * 3))
    msgbox(format("It's the sound of battle!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ACIMUT)
    return
}

script CollaboratorsRoom_EventScript_Acimut_TalkOnly {
    msgbox(format("One day I started decompiling Pokémon FireRed in Spanish to get the original ROM by compiling pokefirered."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ACIMUT)
    call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
    msgbox(format("It took two years to find motivation in the 30-day challenge on the WaH forum.\pDuring that time I managed to reach a 100% match."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ACIMUT)
    playse(SE_LEDGE)
    applymovementandwait(VAR_LAST_TALKED, moves(lock_facing_direction, jump_in_place_down))
    waitse
    playse(SE_LEDGE)
    applymovementandwait(VAR_LAST_TALKED, moves(jump_in_place_down, unlock_facing_direction, face_player, delay_16))
    waitse
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_HappyWithDelay48)
    msgbox(format("It was the best day of my life in the world of ROM hacking, beating a personal challenge that meant a lot to me."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ACIMUT)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_HeartWithDelay48)
    waitse
    delay(30)
    msgbox(format("By the way, the music here sounds better in stereo."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ACIMUT)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_MusicNoteWithDelay48)
    waitse
    goto(CollaboratorsRoom_EventScript_Acimut_OnFinishEvent)
}

text CollaboratorsRoom_RematchMultichoice_Rematch {
    format("Let's battle again!")
}

text CollaboratorsRoom_RematchMultichoice_TalkOnly {
    format("I'd rather just talk.")
}

text CollaboratorsRoom_RematchMultichoice_Exit {
    format("No, thanks.")
}

script CollaboratorsRoom_EventScript_Acimut_IntroRematch {
    msgbox(format("Music is math and pure feeling.\pJust like Pokémon battles!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ACIMUT)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_MusicNoteWithDelay48)
    setspeaker(SP_NAME_ACIMUT)
    message(format("Ready for the rematch?"))
    waitmessage
    dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, CollaboratorsRoom_RematchMultichoice_Rematch, CollaboratorsRoom_RematchMultichoice_TalkOnly, CollaboratorsRoom_RematchMultichoice_Exit)
    closemessage
    delay(20)
    switch(var(VAR_RESULT)) {
        case 0:
            call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
            return
        case 1:
            fadedefaultbgm()
            goto(CollaboratorsRoom_EventScript_Acimut_TalkOnly)
        default:
            fadedefaultbgm()
            msgbox(format("Come back anytime. There's always good music here to battle to."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ACIMUT)
            goto(CollaboratorsRoom_EventScript_Acimut_OnFinishEvent)
    }
}

script CollaboratorsRoom_EventScript_Acimut_OnFinishEvent {
    turnobject(VAR_LAST_TALKED, DIR_NORTH)
    release
    end
}

script CollaboratorsRoom_EventScript_Acimut {
    lock
    faceplayer
    if(flag(FLAG_WAH_CHALLENGE_COMPLETED) == TRUE) {
        playbgm(MUS_ENCOUNTER_COOL, FALSE)
        if(flag(FLAG_DEFEATED_COLLABORATORS_ROOM_ACIMUT)) {
            call(CollaboratorsRoom_EventScript_Acimut_IntroRematch)
        } else {
            call(CollaboratorsRoom_EventScript_Acimut_IntroFirstBattle)
        }
        playse(SE_PIN)
        applymovement(LOCALID_PLAYER, Common_Movement_VersusWithDelay48)
        applymovement(VAR_LAST_TALKED, Common_Movement_VersusWithDelay48)
        waitmovement(0)
        delay(30)
        setflag(B_FLAG_NO_WHITEOUT)
        trainerbattle_no_intro(TRAINER_WAH_COLLABORATOR_ACIMUT, format("What happened here?"))
        clearflag(B_FLAG_NO_WHITEOUT)
        specialvar(VAR_RESULT, GetBattleOutcome)
        if(var(VAR_RESULT) == B_OUTCOME_WON) {
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_XWithDelay48)
            msgbox(format("I didn't see that last move coming…"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ACIMUT)
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_SweatDropWithDelay48)
            msgbox(format("I hope we can face each other again someday."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ACIMUT)
            setflag(FLAG_DEFEATED_COLLABORATORS_ROOM_ACIMUT)
        } else {
            msgbox(format("The harmony of your Pokémon is everything…"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ACIMUT)
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_WinkWithDelay48)
            delay(20)
            msgbox(format("If you want to try again, I'll be here."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ACIMUT)
        }
        setvar(VAR_0x8004, COLLABORATOR_NO_FAINT_BIT_ACIMUT)
        call(CollaboratorsRoom_EventScript_AfterBattleCollaborators)
        goto(CollaboratorsRoom_EventScript_Acimut_OnFinishEvent)
    } else {
        goto(CollaboratorsRoom_EventScript_Acimut_TalkOnly)
    }
}

script CollaboratorsRoom_EventScript_Alexmad_LongIntro {
    msgbox(format("20 years… do you realize?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
    call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
    msgbox(format("We grew up here among bugs, misaligned tiles, and scripts that froze on the last map."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
    delay(20)
    playse(SE_PIN)
    applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_IdeaWithDelay48)
    msgbox(format("Oh! If you see Baro around… don't try to be his friend.\pTrust me, it doesn't end well."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
    delay(20)
    playse(SE_PIN)
    applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_ThinkingWithDelay48)
    msgbox(format("And if you run into Serg!o… greet him with respect.\pHe's a legend."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
    call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
    delay(10)
    msgbox(format("We all have a special fondness for him…\nAnd no, no homo."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
    playse(SE_PIN)
    applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_HeartWithDelay48)
    msgbox(format("I love the beach, making really wild maps, and putting forests inside caves.\pThat says a lot about me."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
    playse(SE_PIN)
    applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_ThinkingWithDelay48)
    msgbox(format("Hacks say a lot about us.\pEven in our personal lives… they made us better people."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
    call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
    delay(10)
    return
}

script CollaboratorsRoom_EventScript_Alexmad_QRFlow {
    msgbox(format("Scan the QR with your phone and see you in the other world."), speaker = SP_NAME_ALEXMAD)
    load_field_pic(FP_MAD_QR, 120, 80)
    waitbuttonpress
    closemessage
    destroy_field_pic(FP_MAD_QR)
    msgbox(format("Did you see it?"), MSGBOX_YESNO, speaker = SP_NAME_ALEXMAD)
    closemessage
    delay(20)
    if(var(VAR_RESULT) == YES) {
        msgbox(format("Then type the word you saw in the video."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
        special(EnterCode)
        waitstate
        special(GetCodeFeedback)
        if (var(VAR_RESULT) == 1) {
            msgbox(format("Perfect… I see you did watch it.\pThen you know what you have to do."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
            setflag(FLAG_TEMP_ALEXMAD_PUZZLE_STARTED)
            clearflag(FLAG_TEMP_ALEXMAD_PUZZLE_FAILED)
            clearflag(FLAG_TEMP_ALEXMAD_PUZZLE_SWAP_FEEDBACK_PENDING)
            clearflag(FLAG_TEMP_ALEXMAD_PUZZLE_SWAP_FEEDBACK_SHOWN)
            setvar(VAR_TEMP_1_COLLABORATORS_ALEXMAD_PUZZLE_SWAP_FEEDBACK_PENDING, 0)
            setvar(VAR_ALEXMAD_PUZZLE_CHECKPOINT, 0)
            getplayerxy(VAR_ALEXMAD_PUZZLE_START_X, VAR_ALEXMAD_PUZZLE_START_Y)
            special(InitAlexmadPuzzlePartyOrderCheck)
            release
            end
        } else {
            msgbox(format("No… that's not it."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
            playse(SE_PIN)
            applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_AnnoyedWithDelay48)
            msgbox(format("Remember, in the video I explain the 3 steps you need to complete the event.\pThe password is only the first step.\pCome back when you have the correct answer."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
        }
    } else {
        msgbox(format("Come back when you're ready."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
    }
    goto(CollaboratorsRoom_EventScript_Alexmad_OnFinishEvent)
}

script CollaboratorsRoom_EventScript_Alexmad_IntroFirstBattle {
    msgbox(format("Every hack has its own essence. The personality of its creator lives inside it.\pThis one carries the best of great names from the community.\pMore than two decades evolving.\nThey never gave up… never stopped creating.\pLet's see if you don't give up either."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
    call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
    return
}

script CollaboratorsRoom_EventScript_Alexmad_IntroRematch {
    msgbox(format("You came back…\nThat already says something.\pAt WAH we learned that giving up isn't an option.\pEvery bug is a new version… every defeat is a patch.\pAnd every patch made us better."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
    delay(20)
    setspeaker(SP_NAME_ALEXMAD)
    message(format("Another battle?"))
    waitmessage
    dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, CollaboratorsRoom_RematchMultichoice_Rematch, CollaboratorsRoom_RematchMultichoice_TalkOnly, CollaboratorsRoom_RematchMultichoice_Exit)
    closemessage
    delay(20)
    switch(var(VAR_RESULT)) {
        case 0:
            call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
            return
        case 1:
            call(CollaboratorsRoom_EventScript_Alexmad_LongIntro)
            goto(CollaboratorsRoom_EventScript_Alexmad_OnFinishEvent)
        default:
            msgbox(format("Whenever you want to come back, I'll be here."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
            goto(CollaboratorsRoom_EventScript_Alexmad_OnFinishEvent)
    }
}

script CollaboratorsRoom_EventScript_Alexmad_DoBattle {
    playse(SE_PIN)
    applymovement(LOCALID_PLAYER, Common_Movement_VersusWithDelay48)
    applymovement(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_VersusWithDelay48)
    waitmovement(0)
    setflag(B_FLAG_NO_WHITEOUT)
    trainerbattle_no_intro(TRAINER_WAH_COLLABORATOR_ALEXMAD, CollaboratorsRoom_Text_Alexmad_OnDefeat)
    clearflag(B_FLAG_NO_WHITEOUT)
    specialvar(VAR_RESULT, GetBattleOutcome)
    if(var(VAR_RESULT) == B_OUTCOME_WON) {
        playse(SE_PIN)
        applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_SurpriseWithDelay48)
        msgbox(format("Excellent…\nYou're worthy of being here.\pI'm glad to see the community never stopped being the best."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
        playse(SE_PIN)
        applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_HeartWithDelay48)
        msgbox(format("Today I lost…\nBut maybe tomorrow Samee could win.\pSee you soon."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
        call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
        setflag(FLAG_DEFEATED_COLLABORATORS_ROOM_ALEXMAD)
    } else {
        msgbox(format("I see that having the best team isn't always enough.\pStrategy matters more than mashing A like crazy."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
        playse(SE_PIN)
        applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_ThinkingWithDelay48)
        call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
        msgbox(format("Come back when you're ready."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
    }
    setvar(VAR_0x8004, COLLABORATOR_NO_FAINT_BIT_ALEXMAD)
    call(CollaboratorsRoom_EventScript_AfterBattleCollaborators)
    goto(CollaboratorsRoom_EventScript_Alexmad_OnFinishEvent)
}

script CollaboratorsRoom_EventScript_Alexmad_OnFinishEvent {
    turnobject(LOCALID_COLLABORATORS_ROOM_ALEXMAD, DIR_NORTH)
    release
    end
}

text CollaboratorsRoom_Text_Alexmad_OnDefeat {
    format("20 years of community and it still surprises me.")
}

script CollaboratorsRoom_EventScript_Alexmad {
    lock
    playse(SE_PIN)
    if(flag(FLAG_TEMP_ALEXMAD_PUZZLE_STARTED)) {
        msgbox(format("You know what you have to do, right?"), MSGBOX_NPC, speaker = SP_NAME_ALEXMAD)
        end
    }
    applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_ThinkingWithDelay48)
    if(!flag(FLAG_ALEXMAD_EVENT_COMPLETED)) {
        msgbox(format("Sm1, sm2 or…"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
    }
    delay(30)
    playse(SE_PIN)
    applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, moves(emote_exclamation_mark))
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, moves(face_player, lock_facing_direction, jump_in_place_down))
    waitse
    playse(SE_LEDGE)
    applymovement(LOCALID_COLLABORATORS_ROOM_ALEXMAD, moves(jump_in_place_down, unlock_facing_direction, face_player, delay_16))
    waitmovement(0)
    setvar(VAR_TEMP_C, 0)
    if(!flag(FLAG_MET_ALEXMAD)) {
        setvar(VAR_TEMP_C, 1)
        call(CollaboratorsRoom_EventScript_Alexmad_LongIntro)
        setflag(FLAG_MET_ALEXMAD)
    }

    if(flag(FLAG_ALEXMAD_EVENT_COMPLETED)) {
        if(flag(FLAG_WAH_CHALLENGE_COMPLETED)) {
            if(flag(FLAG_DEFEATED_COLLABORATORS_ROOM_ALEXMAD)) {
                call(CollaboratorsRoom_EventScript_Alexmad_IntroRematch)
            } else {
                call(CollaboratorsRoom_EventScript_Alexmad_IntroFirstBattle)
            }
            goto(CollaboratorsRoom_EventScript_Alexmad_DoBattle)
        } else {
            msgbox(format("You already did it."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
            playse(SE_PIN)
            applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_HeartWithDelay48)
            msgbox(format("You remind me of KODER.\pHe was always good with riddles.\nKeep going, I'm sure you'll do fine."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
            goto(CollaboratorsRoom_EventScript_Alexmad_OnFinishEvent)
        }
    } else {
        if(flag(FLAG_WAH_CHALLENGE_COMPLETED)) {
            if(var(VAR_TEMP_C) == 1) {
                msgbox(format("I've got an event for you in true Mitic style.\pBut we can also go straight to the battle.\nWhat do you prefer?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
            } else {
                msgbox(format("You again! I've got two offers for you."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
                playse(SE_PIN)
                applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_QuestionMark)
                msgbox(format("What do you want to do?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
                delay(60)
            }
            dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, format("Event"), format("Battle"), format("Exit"))
            switch(var(VAR_RESULT)) {
                case 0:
                    goto(CollaboratorsRoom_EventScript_Alexmad_QRFlow)
                case 1:
                    if(!flag(FLAG_DEFEATED_COLLABORATORS_ROOM_ALEXMAD)) {
                        call(CollaboratorsRoom_EventScript_Alexmad_IntroFirstBattle)
                    } else {
                        playse(SE_PIN)
                        applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_HappyWithDelay48)
                        msgbox(format("Let's see which version you are now."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
                    }
                    goto(CollaboratorsRoom_EventScript_Alexmad_DoBattle)
                default:
                    msgbox(format("Come back when you're ready."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
                    goto(CollaboratorsRoom_EventScript_Alexmad_OnFinishEvent)
            }
        } else {
            if(var(VAR_TEMP_C) == 1) {
                msgbox(format("I've got an event for you in true Mitic style.\pTell me… do you want to do it?"), MSGBOX_YESNO, speaker = SP_NAME_ALEXMAD)
            } else {
                msgbox(format("You're back - want to continue with the event?"), MSGBOX_YESNO, speaker = SP_NAME_ALEXMAD)
            }
            closemessage
            delay(20)
            if(var(VAR_RESULT) == YES) {
                goto(CollaboratorsRoom_EventScript_Alexmad_QRFlow)
            } else {
                msgbox(format("Come back when you're ready.\nThe Mitic doesn't wait… but it doesn't repeat either."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
                goto(CollaboratorsRoom_EventScript_Alexmad_OnFinishEvent)
            }
        }
    }
}

script CollaboratorsRoom_EventScript_AlexmadPuzzleSwapFeedback {
    lockall
    applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_FacePlayer)
    playse(SE_PIN)
    applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_SurpriseWithDelay48)
    msgbox(format("Nice… you're just missing the last part of the event."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
    clearflag(FLAG_TEMP_ALEXMAD_PUZZLE_SWAP_FEEDBACK_PENDING)
    setvar(VAR_TEMP_1_COLLABORATORS_ALEXMAD_PUZZLE_SWAP_FEEDBACK_PENDING, 0)
    setflag(FLAG_TEMP_ALEXMAD_PUZZLE_SWAP_FEEDBACK_SHOWN)
    releaseall
    end
}

script CollaboratorsRoom_EventScript_AlexmadPuzzleComplete {
    lockall
    applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_FaceRight)
    playse(SE_PIN)
    applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_DoubleExclamationMark)
    waitse
    playse(SE_PIN)
    applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, moves(jump_in_place_right))
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, moves(jump_in_place_right, delay_16))
    waitse
    playse(SE_SUCCESS)
    msgbox(format("You did it! I see you're good."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
    delay(20)
    directmovementtopos(LOCALID_PLAYER, 5, 3)
    waitmovement(0)
    turnobject(LOCALID_PLAYER, DIR_WEST)
    msgbox(format("You remind me of KODER. He was always good with riddles.\pMaybe I can help you on your way."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
    playse(SE_PIN)
    applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_ThinkingWithDelay48)
    msgbox("Take this item.\nI don't quite get what it does, but\lit's sure to be useful.", MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
    delay(20)
    giveitem(ITEM_TERA_ORB)
    setflag(B_FLAG_TERA_ORB_CHARGED)
    setflag(B_FLAG_TERA_ORB_NO_COST)
    closemessage
    delay(10)
    call(WahRoomsShared_EventScript_WalkInPlaceAlexmadFacingPlayer)
    msgbox(format("Also, you can now find some legendaries from the Mitic Island in the PC."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
    delay(20)
    setflag(FLAG_ALEXMAD_EVENT_GIVE_LEGENDARIES)
    call(Pokebox_EventScript_ShowUnlocks)
    delay(20)
    msgbox(format("Maybe you can replace one of your Pokémon with one of them."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
    playse(SE_PIN)
    applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_ThinkingWithDelay48)
    msgbox(format("Do you know the power of the clones?\nNow you'll experience it firsthand."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
    delay(20)
    setflag(FLAG_ALEXMAD_EVENT_GIVE_CLONES)
    call(Pokebox_EventScript_ShowUnlocks)
    delay(20)
    msgbox(format("These clones are much stronger than the original Pokémon.\pUse them wisely."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
    playse(SE_PIN)
    applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_HeartWithDelay48)
    delay(20)
    applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_FaceAwayPlayer)
    playse(SE_PIN)
    applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_ThinkingWithDelay48)
    delay(20)
    playse(SE_PIN)
    applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_ThinkingWithDelay48)
    call(WahRoomsShared_EventScript_WalkInPlaceAlexmadFacingPlayer)
    msgbox(format("I'll also give you access to this very special Pokémon.\pIt's a highly coveted battle tool."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
    setflag(FLAG_ALEXMAD_EVENT_COMPLETED)
    call(Pokebox_EventScript_ShowUnlocks)
    call(WahRoomsShared_EventScript_WalkInPlaceAlexmadFacingPlayer)
    msgbox(format("KODER would've smiled to see you leave here with so many aces up your sleeve.\pDon't waste it."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
    goto(CollaboratorsRoom_EventScript_Alexmad_OnFinishEvent)
}

script WahRoomsShared_EventScript_WalkInPlaceAlexmadFacingPlayer {
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    switch(var(VAR_RESULT)) {
        case DIR_NORTH:
            applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_WalkInPlaceDown)
            break
        case DIR_SOUTH:
            applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_WalkInPlaceUp)
            break
        case DIR_WEST:
            applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD,Common_Movement_WalkInPlaceRight)
            break
        case DIR_EAST:
            applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_WalkInPlaceLeft)
            break
    }
    return
}

script CollaboratorsRoom_EventScript_AlexmadPuzzleFailed {
    lockall
    applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_FacePlayer)
    playse(SE_FAILURE)
    applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_XWithDelay48)
    msgbox(format("No, no… that's not it.\pTalk to me again if you want to try again."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
    if(!flag(FLAG_TEMP_ALEXMAD_PUZZLE_SWAP_FEEDBACK_SHOWN)) {
        playse(SE_PIN)
        applymovementandwait(LOCALID_COLLABORATORS_ROOM_ALEXMAD, Common_Movement_ThinkingWithDelay48)
        msgbox(format("Remember what I said, that sometimes the last shall be the…\l…\pBetter try again."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ALEXMAD)
    }
    goto(CollaboratorsRoom_EventScript_Alexmad_OnFinishEvent)
}

script CollaboratorsRoom_EventScript_Ryuzaki_TalkOnly {
    msgbox(format("My name is the Great Mole Boss, I mean, Ryuzaki, though lately some lowlifes have been calling me Ryumole to smear my name…\pAnd to think my favorite little critters are otters…"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RYUZAKI)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_AnnoyedWithDelay48)
    msgbox(format("But I have to admit it's a pretty hilarious mash-up."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RYUZAKI)
    call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
    delay(20)
    msgbox("Do you read manga? Don't lie!\nI know you do.\lEither way, even if you don't,\lthere's one I'd like to recommend.\pIt's Tokyo Ghoul.", MSGBOX_AUTOCLOSE, speaker = SP_NAME_RYUZAKI)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_DoubleExclamationMark)
    waitse
    msgbox(format("Yes, I get that disappointed look - I'm not an emo teen in 2017!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RYUZAKI)
    call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
    delay(20)
    msgbox(format("Its adaptation was a mess, but it's not the joke you're probably imagining.\pThe manga handles the branching introspection of its characters with such love that it becomes a beautiful experience."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RYUZAKI)
    call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
    msgbox(format("I'm not feeding you misinformation, you can trust me."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RYUZAKI)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_ThinkingWithDelay48)
    msgbox(format("It's very special to me… I had to shamelessly use my influence to give it some visibility."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RYUZAKI)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_HappyWithDelay48)
    goto(CollaboratorsRoom_EventScript_Ryuzaki_OnFinishEvent)
}

script CollaboratorsRoom_EventScript_Ryuzaki_IntroFirstBattle {
    msgbox("It's time for violence.\nI'll show you the Divine Truth.", MSGBOX_AUTOCLOSE, speaker = SP_NAME_RYUZAKI)
    return
}

script CollaboratorsRoom_EventScript_Ryuzaki_IntroRematch {
    msgbox(format("Oh, hello. Your absence gave me time to compose a little poem.\pHere, let me share it."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RYUZAKI)
    call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
    delay(20)
    msgbox("{FONT_SMALL}“Oh, filthy lobster!\nIt's not just a matter of doohickeys\lIt's the shipwreck of the spirit\lIn the Ocean of the Damned.”", MSGBOX_AUTOCLOSE, speaker = SP_NAME_RYUZAKI)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_ThinkingWithDelay48)
    delay(20)
    setspeaker(SP_NAME_RYUZAKI)
    message(format("Deep and seinen, right?\pWell, you probably didn't come to hear me talk nonsense… Shall we throw down?"))
    waitmessage
    dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, CollaboratorsRoom_RematchMultichoice_Rematch, CollaboratorsRoom_RematchMultichoice_TalkOnly, CollaboratorsRoom_RematchMultichoice_Exit)
    closemessage
    delay(20)
    switch(var(VAR_RESULT)) {
        case 0:
            msgbox(format("Get ready to face the true power of the Screw-Screw Fruit: Goblin Model of La Buena Pipa."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RYUZAKI)
            return
        case 1:
            goto(CollaboratorsRoom_EventScript_Ryuzaki_TalkOnly)
        default:
            msgbox(format("Flies can't just put on glasses to see The Light."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RYUZAKI)
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_AnnoyedWithDelay48)
            goto(CollaboratorsRoom_EventScript_Ryuzaki_OnFinishEvent)
    }
}

script CollaboratorsRoom_EventScript_Ryuzaki_OnFinishEvent {
    turnobject(VAR_LAST_TALKED, DIR_EAST)
    release
    end
}

script CollaboratorsRoom_EventScript_Ryuzaki {
    lock
    faceplayer
    if(flag(FLAG_WAH_CHALLENGE_COMPLETED) == TRUE) {
        if(flag(FLAG_DEFEATED_COLLABORATORS_ROOM_RYUZAKI)) {
            call(CollaboratorsRoom_EventScript_Ryuzaki_IntroRematch)
        } else {
            call(CollaboratorsRoom_EventScript_Ryuzaki_IntroFirstBattle)
        }
        playse(SE_PIN)
        applymovement(LOCALID_PLAYER, Common_Movement_VersusWithDelay48)
        applymovement(VAR_LAST_TALKED, Common_Movement_VersusWithDelay48)
        waitmovement(0)
        setflag(B_FLAG_NO_WHITEOUT)
        trainerbattle_no_intro(TRAINER_WAH_COLLABORATOR_RYUZAKI, CollaboratorsRoom_Text_Ryuzaki_OnDefeat)
        clearflag(B_FLAG_NO_WHITEOUT)
        specialvar(VAR_RESULT, GetBattleOutcome)
        if(var(VAR_RESULT) == B_OUTCOME_WON) {
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_XWithDelay48)
            call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
            msgbox(format("You fumigated me. Lucky for you we're not in ryutamic territory."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RYUZAKI)
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_AnnoyedWithDelay48)
            setflag(FLAG_DEFEATED_COLLABORATORS_ROOM_RYUZAKI)
        } elif(var(VAR_RESULT) == B_OUTCOME_FORFEITED) {
            msgbox(format("Huh? Weren't we going to fight? I see you've perfected your misinformation skills…"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RYUZAKI)
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_AnnoyedWithDelay48)
        } else {
            msgbox(format("You're a joke, bro. Pack up your deck."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RYUZAKI)
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_AnnoyedWithDelay48)
        }
        setvar(VAR_0x8004, COLLABORATOR_NO_FAINT_BIT_RYUZAKI)
        call(CollaboratorsRoom_EventScript_AfterBattleCollaborators)
        goto(CollaboratorsRoom_EventScript_Ryuzaki_OnFinishEvent)
    } else {
        msgbox(format("Hello, dear coyote. I wasn't expecting to see you around here.\pIn fact, I wasn't expecting to see myself either, honestly."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RYUZAKI)
        playse(SE_PIN)
        applymovementandwait(VAR_LAST_TALKED, Common_Movement_SurpriseWithDelay48)
        msgbox(format("Life takes more twists than a canteen, right?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RYUZAKI)
        call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
        delay(20)
        msgbox(format("What? Me? Oh, don't worry, I'm nobody suspicious."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RYUZAKI)
        delay(20)
        call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
        goto(CollaboratorsRoom_EventScript_Ryuzaki_TalkOnly)
    }
}

text CollaboratorsRoom_Text_Ryuzaki_OnDefeat {
    format("You know what they say: will is the strength of the soul.")
}

script CollaboratorsRoom_EventScript_Caco_IntroFirstBattle {
    faceplayer
    msgbox(format("You again? You've got a different aura from the first time...\pAnd I assure you it's not hallucinations from the coffee."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CACO)
    delay(30)

    playse(SE_LEDGE)
    applymovementandwait(VAR_LAST_TALKED, moves(lock_facing_direction, jump_in_place_down, unlock_facing_direction, face_player))
    
    checkplayergender
    if(var(VAR_RESULT) == MALE) {
        msgbox(format("That look... don't tell me you've won the challenge...\pAre you really the new champion?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CACO)
    } else {
        msgbox(format("That look... don't tell me you've won the challenge...\pAre you really the new champion?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CACO)
    }
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_SurpriseWithDelay48)
    msgbox(format("Wow! I didn't expect that... But I bet I can guess: you didn't bring me a coffee!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CACO)
    playse(SE_LEDGE)
    applymovementandwait(VAR_LAST_TALKED, moves(lock_facing_direction, jump_in_place_down))
    playse(SE_LEDGE)
    applymovementandwait(VAR_LAST_TALKED, moves(jump_in_place_down, unlock_facing_direction, face_player))
    msgbox(format("I've been cooped up here since we started development and you can't even bring me a lukewarm latte!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CACO)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_AngryWithDelay48)
    msgbox(format("Get ready to face the wrath of the caffeine-deprived developer!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CACO)
    return
}

script CollaboratorsRoom_EventScript_Caco_TalkOnly {
    faceplayer
    msgbox(format("Have you tried the PC in the Waiting Room yet?\pBecause if you keep looking for the one in Pokémon Centers, good luck with that."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CACO)
    call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
    msgbox(format("It cost me a thousand sleepless nights and just as many headbutts against the keyboard to get it working right!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CACO)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_SweatDropWithDelay48)
    msgbox(format("So you'd better hurry up and go try it!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CACO)
    delay(10)
    msgbox(format("And don't you dare poke your nose in here again unless it's with a nice steaming cup of coffee in hand. Come on, get moving!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CACO)
    playse(SE_LEDGE)
    applymovementandwait(VAR_LAST_TALKED, moves(lock_facing_direction, jump_in_place_down, unlock_facing_direction, face_player))
    goto(CollaboratorsRoom_EventScript_Caco_OnFinishEvent)
}

script CollaboratorsRoom_EventScript_Caco_IntroRematch {
    msgbox(format("Blegh! This coffee tastes awful.\pI think it's been in the cup since we started, but I have to drink it...\pIt's the only thing keeping my neurons connected."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CACO)

    delay(30)

    // Salto y exclamación
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_ExclamationMark)
    playse(SE_LEDGE)
    applymovementandwait(VAR_LAST_TALKED, moves(face_player, lock_facing_direction, jump_in_place_down))
    playse(SE_LEDGE)
    applymovementandwait(VAR_LAST_TALKED, moves(jump_in_place_down, unlock_facing_direction, face_player))
    msgbox(format("Heyy! Didn't anyone teach you not to eavesdrop?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CACO)
    delay(10)
    msgbox(format("Your face... looks familiar. Were you a beta-tester or something?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CACO)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_ThinkingWithDelay48)
    msgbox(format("Well, since you're here, it'll do me good to clear my head."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CACO)
    delay(10)
    setspeaker(SP_NAME_CACO)
    message(format("What do you want to do?"))
    waitmessage
    dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, CollaboratorsRoom_RematchMultichoice_Rematch, CollaboratorsRoom_RematchMultichoice_TalkOnly, CollaboratorsRoom_RematchMultichoice_Exit)
    closemessage
    
    switch(var(VAR_RESULT)) {
        case 0:
            call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
            msgbox(format("Programming your victory won't do you any good!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CACO)
            return
        case 1:
            goto(CollaboratorsRoom_EventScript_Caco_TalkOnly)
        default:
            msgbox(format("You'd better bring caffeine next time!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CACO)
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_AnnoyedWithDelay48)
            goto(CollaboratorsRoom_EventScript_Caco_OnFinishEvent)
    }
}

script CollaboratorsRoom_EventScript_Caco_OnFinishEvent {
    turnobject(VAR_LAST_TALKED, DIR_EAST)
    release
    end
}

script CollaboratorsRoom_EventScript_Caco {
    lock
    // Comprobamos si ha ganado el desafío (FLAG_WAH_CHALLENGE_COMPLETED)
    if(flag(FLAG_WAH_CHALLENGE_COMPLETED) == TRUE){
        if(flag(FLAG_DEFEATED_COLLABORATORS_ROOM_CACO)) {
            call(CollaboratorsRoom_EventScript_Caco_IntroRematch)
        } else {
            call(CollaboratorsRoom_EventScript_Caco_IntroFirstBattle)
        }
        
        delay(20)
        playse(SE_PIN)
        applymovement(VAR_LAST_TALKED, Common_Movement_VersusWithDelay48)
        applymovement(LOCALID_PLAYER, Common_Movement_VersusWithDelay48)
        waitmovement(0)
        
        random(3)
        setflag(B_FLAG_NO_WHITEOUT)
        switch(var(VAR_RESULT)) {
            case 0:
                trainerbattle_no_intro(TRAINER_WAH_COLLABORATOR_CACO_1, CollaboratorsRoom_Text_Caco_OnDefeat)
            case 1:
                trainerbattle_no_intro(TRAINER_WAH_COLLABORATOR_CACO_2, CollaboratorsRoom_Text_Caco_OnDefeat)
            case 2:
                trainerbattle_no_intro(TRAINER_WAH_COLLABORATOR_CACO_3, CollaboratorsRoom_Text_Caco_OnDefeat)
        }
        clearflag(B_FLAG_NO_WHITEOUT)
        
        specialvar(VAR_RESULT, GetBattleOutcome)
        
        if (var(VAR_RESULT) == B_OUTCOME_WON) {
            call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
            msgbox(format("Okay, I admit it... you battle better than I program.\pBut I still need that coffee."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CACO)
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_AnnoyedWithDelay48)
            setflag(FLAG_DEFEATED_COLLABORATORS_ROOM_CACO)
        } else {
            msgbox(format("See? Lack of sleep makes me dangerous.\pCome back when you've got the coffee!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CACO)
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_DoubleExclamationMarkWithDelay48)
        }
        setvar(VAR_0x8004, COLLABORATOR_NO_FAINT_BIT_CACO)
        call(CollaboratorsRoom_EventScript_AfterBattleCollaborators)
        goto(CollaboratorsRoom_EventScript_Caco_OnFinishEvent)
    } else {
        // Si no ha completado el desafío
        goto(CollaboratorsRoom_EventScript_Caco_TalkOnly)
    }
}

text CollaboratorsRoom_Text_Caco_OnDefeat {
    format("Sometimes, to move forward, one must accept their mistake.")
}

