
mapscripts OmegaRoom_MapScripts {
     MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_8, 0: OmegaRoom_OnWarp_PlayerTurnNorth
    ]
    MAP_SCRIPT_ON_LOAD: OmegaRoom_OnLoad
    MAP_SCRIPT_ON_TRANSITION : OmegaRoom_OnTransition
}


script OmegaRoom_OnLoad {
    if(flag(FLAG_DEFEATED_ADMIN_OMEGA)){
        call(OmegaRoom_EventScript_BrokenCapsule)
        call(WahRoomsShared_SetDoorAsOpen)
    }
    end
}

script OmegaRoom_OnWarp_PlayerTurnNorth {
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    end
}

script OmegaRoom_OnTransition {
    call(WahRoomsShared_Kecleon_SetSala_Omega)
    end
}

script OmegaRoom_EventScript_StartChallenge {
    lock
    directmovementtopos(LOCALID_PLAYER, 6, 9)
    waitmovement(0)
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    special(SpawnCameraObject)
    directcameramovementtopos(6, 6)
    waitmovement(0)
    delay(50)
    call(OmegaRoom_EventScript_OmegaAwakens)
    delay(10)
    setvar(VAR_0x8004, 1)  // vertical pan
    setvar(VAR_0x8005, 2)  // horizontal pan
    setvar(VAR_0x8006, 8)  // num shakes
    setvar(VAR_0x8007, 5)  // shake delay
    special(ShakeCamera)
    fadescreen(FADE_TO_BLACK)
    delay(30)
    call(OmegaRoom_EventScript_BrokenCapsule)
    showobjectat(LOCALID_OMEGAROOM_OMEGA, MAP_OMEGA_ROOM)
    setobjectmovementtype(LOCALID_OMEGAROOM_OMEGA, MOVEMENT_TYPE_FACE_DOWN)
    setobjectmovementtype2(LOCALID_OMEGAROOM_OMEGA, MOVEMENT_TYPE_FACE_DOWN)
    turnobject(LOCALID_OMEGAROOM_OMEGA, DIR_SOUTH)
    fadescreen(FADE_FROM_BLACK)
    playse(SE_PIN)
    applymovement(LOCALID_OMEGAROOM_OMEGA, moves(emote_double_exclamation_mark))
    waitmovement(0)
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_OMEGAROOM_OMEGA, moves(jump_in_place_down))
    msgbox(format("Whoa, a new challenger!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_OMEGA)  
    delay(50)
    directcameramovementtopos(6, 9)
    waitmovement(0)
    special(RemoveCameraObject)
    playse(SE_LEDGE)
    applymovement(LOCALID_OMEGAROOM_OMEGA, moves(
        jump_2_down))
    applymovement(LOCALID_PLAYER, moves(delay_8, lock_facing_direction, jump_down, unlock_facing_direction, face_up))
    waitmovement(0)
    delay(20)
    playse(SE_PIN)
    applymovementandwait(LOCALID_PLAYER, Common_Movement_QuestionMarkWithDelay48)
    delay(30)
    msgbox(format("Welcome to the first match of this celebration's challenge!\pWe've been expecting you."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_OMEGA)
    playse(SE_PIN)
    applymovementandwait(LOCALID_OMEGAROOM_OMEGA, Common_Movement_HappyWithDelay48)
    delay(20)
    msgbox(format("Ready for your first battle? Let's see if you can beat me!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_OMEGA)
    applymovementandwait(LOCALID_OMEGAROOM_OMEGA, Common_Movement_WalkInPlaceDown)
    delay(20)
    applymovementandwait(LOCALID_PLAYER, Common_Movement_WalkInPlaceUp)
    delay(10)
    playse(SE_LEDGE)
    applymovement(LOCALID_OMEGAROOM_OMEGA, moves(jump_in_place_down))
    waitmovement(0)
    waitse
    playse(SE_LEDGE)
    applymovement(LOCALID_OMEGAROOM_OMEGA, moves(jump_in_place_down, delay_16))
    waitmovement(0)
    waitse
    msgbox(format("Perfect, let's go!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_OMEGA)
    playse(SE_PIN)
    applymovement(LOCALID_OMEGAROOM_OMEGA, moves(emote_versus))
    waitmovement(0)
    waitse
    call(OmegaRoom_EventScript_OmegaBattle)
    playse(SE_PIN)
    applymovementandwait(LOCALID_OMEGAROOM_OMEGA, moves(emote_x))
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_OMEGAROOM_OMEGA, moves(lock_facing_direction, jump_up, unlock_facing_direction, face_down, delay_16 * 2))
    delay(40)
    playse(SE_PIN)
    applymovementandwait(LOCALID_OMEGAROOM_OMEGA, Common_Movement_Surprise)
    msgbox(format("You really bared your fangs!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_OMEGA)
    delay(48)
    applymovementandwait(LOCALID_OMEGAROOM_OMEGA, Common_Movement_WalkDown)
    msgbox(format("That was a good battle. It leaves me wanting more, honestly.\pI'll have to wait until you complete the challenge for a rematch."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_OMEGA)
    playse(SE_PIN)
    applymovementandwait(LOCALID_OMEGAROOM_OMEGA, Common_Movement_WalkInPlaceDown)
    msgbox(format("Either way, this was only the first room; you've still got a long road ahead."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_OMEGA)
    playse(SE_LEDGE)
    applymovement(LOCALID_OMEGAROOM_OMEGA, moves(jump_in_place_down))
    waitmovement(0)
    waitse
    playse(SE_LEDGE)
    applymovement(LOCALID_OMEGAROOM_OMEGA, moves(jump_in_place_down))
    waitmovement(0)
    waitse
    delay(30)
    msgbox(format("It'll be interesting to see how far you can get in this challenge."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_OMEGA)
    waitmovement(0)
    delay(30)
    msgbox(format("I'm still active around here, but many of your upcoming rivals had already retired… and came back especially for this celebration.\pBut remember, don't underestimate the old guard. They're stubborn, and when they get serious, you'll know it."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_OMEGA)
    playse(SE_PIN)
    applymovementandwait(LOCALID_OMEGAROOM_OMEGA, Common_Movement_SweatDropWithDelay48)
    delay(20)
    applymovementandwait(LOCALID_OMEGAROOM_OMEGA, Common_Movement_WalkInPlaceDown)
    getplayerxy(VAR_TEMP_A, VAR_TEMP_B)
    msgbox(format("I'll open the door so you can continue your journey."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_OMEGA)
    special(SpawnCameraObject)
    directcameramovementtopos(6, 4)
    waitmovement(0)
    call(WahRoomsShared_OpenDoor)
    directcameramovementtoposwithvars(VAR_TEMP_A, VAR_TEMP_B)
    waitmovement(0)
    special(RemoveCameraObject)
    msgbox(format("Now go on, and show you're here to achieve great things."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_OMEGA)
    applymovementandwait(LOCALID_OMEGAROOM_OMEGA, moves(walk_up * 2, face_down))
    setflag(FLAG_DEFEATED_ADMIN_OMEGA)
    setvar(VAR_TEMP_0, 1)
    call(WahRoomsShared_EventScript_AfterBattle)
    release
    end
}

script OmegaRoom_EventScript_OmegaAwakens {
    setmetatile(5, 4, METATILE_room_omega_OMEGA_AWAKENS_1, FALSE)
    setmetatile(6, 4, METATILE_room_omega_OMEGA_AWAKENS_2, FALSE)
    setmetatile(7, 4, METATILE_room_omega_OMEGA_AWAKENS_3, FALSE)
    setmetatile(5, 5, METATILE_room_omega_OMEGA_AWAKENS_4, FALSE)
    setmetatile(6, 5, METATILE_room_omega_OMEGA_AWAKENS_5, FALSE)
    setmetatile(7, 5, METATILE_room_omega_OMEGA_AWAKENS_6, FALSE)
    setmetatile(6, 6, METATILE_room_omega_OMEGA_AWAKENS_7, TRUE)
    special(DrawWholeMapView)
    return
}

script OmegaRoom_EventScript_BrokenCapsule {
    playse(SE_ICE_CRACK)
    waitse
    playse(SE_M_BRICK_BREAK)
    waitse
    setmetatile(5, 4, METATILE_room_omega_CAPSULE_BROKEN_1, FALSE)
    setmetatile(6, 4, METATILE_room_omega_CAPSULE_BROKEN_2, FALSE)
    setmetatile(7, 4, METATILE_room_omega_CAPSULE_BROKEN_3, FALSE)
    setmetatile(5, 5, METATILE_room_omega_CAPSULE_BROKEN_4, FALSE)
    setmetatile(6, 5, METATILE_room_omega_CAPSULE_BROKEN_5, FALSE)
    setmetatile(7, 5, METATILE_room_omega_CAPSULE_BROKEN_6, FALSE)
    setmetatile(6, 6, METATILE_room_omega_CAPSULE_BROKEN_7, TRUE)
    setmetatile(6, 7, METATILE_room_omega_BROKEN_GLASS, FALSE)
    special(DrawWholeMapView)
    return
}

script OmegaRoom_EventScript_OmegaBattle {
     if (!flag(FLAG_WAH_CHALLENGE_COMPLETED)) {
        trainerbattle_no_intro(TRAINER_WAH_ADMIN_OMEGA_MAIN, OmegaRoom_Text_OmegaDefeated)
    } else {
        setvar(VAR_0x8004, TEAM_INDEX_OMEGA)
        special(ShouldUseAlternativeTeam)
        if (var(VAR_RESULT) == 0) {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_OMEGA_MAIN, OmegaRoom_Text_OmegaDefeated)
        } else {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_OMEGA_ALTERNATIVE, OmegaRoom_Text_OmegaDefeated)
        }
    }
    return
}

text OmegaRoom_Text_OmegaDefeated {
    format("That was awesome! I didn't expect such an entertaining battle.")
}

script OmegaRoom_EventScript_Omega {
    msgbox(format("What are you waiting for? Go show those old-timers you didn't beat me by luck."), MSGBOX_NPC, speaker = SP_NAME_OMEGA)
    end
}

script OmegaRoom_Eventscript_Capsule {
    msgbox(format("It looks like an experimentation pod."), MSGBOX_SIGN)
    end
}

script OmegaRoom_EventScript_Machine1 {
    msgbox(format("The machine gives off a constant hum.\pIt looks like no one's checked it in years."), MSGBOX_SIGN)
    end
}

script OmegaRoom_EventScript_Machine2 {
    msgbox(format("The machine is completely neglected.\pSmall plants have grown between the panels and cracks in the metal."), MSGBOX_SIGN)
    end
}

script OmegaRoom_EventScript_Machine3 {
    msgbox(format("The screen is full of glitches and dead pixels.\pIt's amazing the system is still running."), MSGBOX_SIGN)
    end
}

script OmegaRoom_EventScript_Box {
    msgbox(format("The box is covered in a thick layer of dust.\pIt looks like no one's touched it in years."), MSGBOX_SIGN)
    end
}