mapscripts KleinPkPowerRoom_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_TEMP_0, 0: KleinPkPowerRoom_OnFrame
	]
    MAP_SCRIPT_ON_LOAD: KleinPkPowerRoom_OnLoad
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_8, 0: KleinPkPowerRoom_OnWarp_PlayerTurnNorth
    ]
    MAP_SCRIPT_ON_TRANSITION : KleinPkPowerRoom_OnTransition
}


script KleinPkPowerRoom_OnLoad {
    if(flag(FLAG_DEFEATED_ADMIN_KLEIN) && flag(FLAG_DEFEATED_ADMIN_PKPOWER)){
        setmetatile(7, 5, METATILE_room_kleinpkpower_SCREEN_JAIL_OPEN, 1)
        setmetatile(9, 5, METATILE_room_kleinpkpower_JAIL_FLOOR, 0)
        setmetatileelevation(9, 6, 0)
        setobjectxyperm(LOCALID_KLEINROOM_PKPOWER, 2, 4)
        setobjectmovementtype(LOCALID_KLEINROOM_PKPOWER, MOVEMENT_TYPE_FACE_UP)
        setobjectxyperm(LOCALID_KLEINROOM_KLEIN, 2, 7)
        setobjectmovementtype(LOCALID_KLEINROOM_KLEIN, MOVEMENT_TYPE_FACE_UP)
        call(WahRoomsShared_SetDoorAsOpen)
    }
    end
}

script KleinPkPowerRoom_OnWarp_PlayerTurnNorth {
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    end
}

script KleinPkPowerRoom_OnTransition {
    call(WahRoomsShared_Kecleon_SetSala_KelinPkPower)
    end
}

script KleinPkPowerRoom_OnFrame {
    special(ShowMapNamePopup)
    lock
    applymovement(LOCALID_PLAYER, moves(walk_up * 7))
    waitmovement(LOCALID_PLAYER)
    // Primera llamada
    playse(SE_POKENAV_CALL)
    waitse
    special(HideMapNamePopUpWindow)
    playse(SE_POKENAV_CALL)
    waitse
    playse(SE_PIN)
    applymovement(LOCALID_KLEINROOM_PKPOWER, moves(emote_exclamation_mark))
    waitmovement(LOCALID_KLEINROOM_PKPOWER)
    waitse
    playse(SE_POKENAV_CALL)
    waitse
    playse(SE_POKENAV_CALL)
    waitse
    delay(30)
    playse(SE_POKENAV_ON)
    waitse
    applymovement(LOCALID_KLEINROOM_PKPOWER, moves(walk_in_place_up))
    waitmovement(LOCALID_KLEINROOM_PKPOWER)
    msgbox(format("Tech support here.\nHow can I help you?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_PKPOWER)
    applymovement(LOCALID_KLEINROOM_PKPOWER, moves(emote_thinking))
    delay(60)
    waitmovement(LOCALID_KLEINROOM_PKPOWER)
    msgbox(format("So Windoze won't boot?\nAnd what shows up on screen?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_PKPOWER)
    applymovement(LOCALID_KLEINROOM_PKPOWER, moves(emote_thinking))
    delay(60)
    waitmovement(LOCALID_KLEINROOM_PKPOWER)
    msgbox(format("Nothing?\nBut… is the computer even turned on?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_PKPOWER)
    applymovement(LOCALID_KLEINROOM_PKPOWER, moves(emote_thinking))
    delay(60)
    waitmovement(LOCALID_KLEINROOM_PKPOWER)
    playse(SE_PIN)
    applymovementandwait(LOCALID_KLEINROOM_PKPOWER, moves(emote_angry))
    msgbox(format("Then plug it in, man!\nYou check that stuff first!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_PKPOWER)
    waitse
    playse(SE_POKENAV_HANG_UP)
    waitse
    // Segunda llamada
    delay(60)
    playse(SE_POKENAV_CALL)
    waitse
    playse(SE_POKENAV_CALL)
    waitse
    delay(30)
    playse(SE_POKENAV_ON)
    waitse
    applymovement(LOCALID_KLEINROOM_PKPOWER, moves(walk_in_place_up))
    waitmovement(LOCALID_KLEINROOM_PKPOWER)
    msgbox(format("Tech support here.\nWhat do you need?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_PKPOWER)
    applymovement(LOCALID_KLEINROOM_PKPOWER, moves(emote_thinking))
    delay(60)
    waitmovement(LOCALID_KLEINROOM_PKPOWER)
    msgbox(format("What do you mean you lost the cursor!?\nHave you tried moving the mouse?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_PKPOWER)
    applymovement(LOCALID_KLEINROOM_PKPOWER, moves(emote_thinking))
    delay(60)
    waitmovement(LOCALID_KLEINROOM_PKPOWER)
    msgbox(format("It's not the wireless mouse, is it...\nDoes it have batteries?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_PKPOWER)
    applymovement(LOCALID_KLEINROOM_PKPOWER, moves(emote_thinking))
    delay(60)
    waitmovement(LOCALID_KLEINROOM_PKPOWER)
    playse(SE_PIN)
    applymovementandwait(LOCALID_KLEINROOM_PKPOWER, moves(emote_angry))
    msgbox(format("For crying out loud! Then put some in!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_PKPOWER)
    waitse
    playse(SE_POKENAV_HANG_UP)
    waitse
    // Tercera llamada
    delay(60)
    playse(SE_POKENAV_CALL)
    waitse
    playse(SE_POKENAV_CALL)
    waitse
    delay(30)
    playse(SE_POKENAV_ON)
    waitse
    applymovement(LOCALID_KLEINROOM_PKPOWER, moves(walk_in_place_up))
    waitmovement(LOCALID_KLEINROOM_PKPOWER)
    msgbox(format("Tech support here."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_PKPOWER)
    applymovement(LOCALID_KLEINROOM_PKPOWER, moves(emote_thinking))
    delay(60)
    waitmovement(LOCALID_KLEINROOM_PKPOWER)
    msgbox(format("Which key is the “any key”!? What kind of question is that!?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_PKPOWER)
    applymovement(LOCALID_KLEINROOM_PKPOWER, moves(emote_thinking))
    delay(60)
    waitmovement(LOCALID_KLEINROOM_PKPOWER)
    msgbox(format("Look, if the message says “press any key,” just do what it says!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_PKPOWER)
    applymovement(LOCALID_KLEINROOM_PKPOWER, moves(emote_thinking))
    delay(60)
    waitmovement(LOCALID_KLEINROOM_PKPOWER)
    playse(SE_PIN)
    applymovementandwait(LOCALID_KLEINROOM_PKPOWER, moves(emote_angry))
    msgbox(format("There is NO key called “any key”! Just press any key at all!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_PKPOWER)
    waitse
    playse(SE_POKENAV_HANG_UP)
    waitse
    playbgm(MUS_ENCOUNTER_MAGMA, FALSE)
    playse(SE_PIN)
    applymovementandwait(LOCALID_KLEINROOM_PKPOWER, moves(emote_angry, walk_in_place_up))
    msgbox(format("This is unbelievable! How can there be people like this? I'm surrounded by idiots! But it's going to end...\pI'm going to fire them all!\nOut on the street!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_PKPOWER)
    waitse
    playse(SE_LEDGE)
    applymovement(LOCALID_KLEINROOM_KLEIN, moves(jump_in_place_down))
    waitse
    waitmovement(LOCALID_KLEINROOM_KLEIN)
    playse(SE_LEDGE)
    applymovement(LOCALID_KLEINROOM_KLEIN, moves(jump_in_place_down))
    waitse
    waitmovement(LOCALID_KLEINROOM_KLEIN)
    msgbox(format("Hey, you! Over here! Come!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_KLEIN)
    playse(SE_PIN)
    applymovement(LOCALID_PLAYER, moves(emote_question_mark face_right))
    waitse
    waitmovement(LOCALID_PLAYER)
    fadedefaultbgm
    delay(60)
    applymovement(LOCALID_PLAYER, moves(walk_down walk_right * 4 walk_up))
    waitmovement(LOCALID_PLAYER)
    playbgm(MUS_B_PIKE, FALSE)
    msgbox(format("Do you know who I am?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_KLEIN)
    playse(SE_PIN)
    applymovement(LOCALID_PLAYER, moves(emote_thinking))
    waitse
    waitmovement(LOCALID_PLAYER)
    delay(30)
    msgbox(format("Right... how would you know...\nI'm Klein, the webmaster of WaH.\pListen... you've got to help me, I've really messed up!\pI hacked Perro Sanxe, and to top it off they threw me in this jail right as the forum went down...\nCan you set me free?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_KLEIN)
    playse(SE_PIN)
    applymovement(LOCALID_PLAYER, moves(emote_question_mark))
    waitse
    waitmovement(LOCALID_PLAYER)
    delay(30)
    msgbox(format("You don't know how to free me? It's super easy!\pSee that red button?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_KLEIN)
    applymovement(LOCALID_PLAYER, moves(face_left delay_16*4 face_up))
    waitmovement(LOCALID_PLAYER)
    msgbox(format("Yes, that button! Press it and I can get out!\pCome on, don't keep me waiting - I've got a forum to bring back up!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_KLEIN)
    fadedefaultbgm
    setvar(VAR_TEMP_0, 1)
    release
    end
}

script KleinPkPowerRoom_EventScript_BotonRojo {
    lock
    if(flag(FLAG_DEFEATED_ADMIN_PKPOWER))
    {
        msgbox(format("The cell is already open."), MSGBOX_AUTOCLOSE)
    }
    else
    {
        msgbox(format("Press the red button?"), MSGBOX_YESNO)
        closemessage
        if(var(VAR_RESULT) == YES)
        {
            playse(SE_CLICK)
            waitse
            delay(30)
            playse(SE_SUCCESS)
            setmetatile(7, 5, METATILE_room_kleinpkpower_SCREEN_JAIL_OPEN, 1)
            special(DrawWholeMapView)
            waitse
            delay(30)
            playse(SE_UNLOCK)
            call(KleinPkPowerRoom_EventScript_OpenJail)
            applymovement(LOCALID_PLAYER, moves(face_right))
            applymovement(LOCALID_KLEINROOM_KLEIN, moves(walk_left walk_down))
            waitmovement(LOCALID_KLEINROOM_KLEIN)
            playse(SE_LEDGE)
            applymovement(LOCALID_KLEINROOM_KLEIN, moves(jump_in_place_down))
            waitse
            waitmovement(LOCALID_KLEINROOM_KLEIN)
            playse(SE_LEDGE)
            applymovement(LOCALID_KLEINROOM_KLEIN, moves(jump_in_place_down))
            waitse
            waitmovement(LOCALID_KLEINROOM_KLEIN)
            playse(SE_PIN)
            applymovement(LOCALID_KLEINROOM_KLEIN, moves(emote_happy))
            waitse
            waitmovement(LOCALID_KLEINROOM_KLEIN)
            playbgm(MUS_B_PIKE, FALSE)
            msgbox(format("Yes! I'm free!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_KLEIN)
            applymovement(LOCALID_KLEINROOM_KLEIN, moves(walk_down, walk_left))
            waitmovement(LOCALID_KLEINROOM_KLEIN)
            playse(SE_PIN)
            applymovement(LOCALID_KLEINROOM_KLEIN, moves(emote_question_mark))
            waitse
            waitmovement(LOCALID_KLEINROOM_KLEIN)
            msgbox(format("By the way... who were you again?\nThis isn't a trap to lock me up again, is it?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_KLEIN)
            playse(SE_PIN)
            applymovement(LOCALID_KLEINROOM_KLEIN, moves(emote_versus))
            waitse
            call(KleinPkPowerRoom_EventScript_KleinBattle)
            playse(SE_PIN)
            applymovement(LOCALID_KLEINROOM_PKPOWER, moves(face_down emote_question_mark))
            waitmovement(LOCALID_KLEINROOM_PKPOWER)
            waitse
            applymovement(LOCALID_KLEINROOM_PKPOWER, moves(walk_right*3 walk_down*3 face_right))
            waitmovement(LOCALID_KLEINROOM_PKPOWER)
            playse(SE_PIN)
            applymovement(LOCALID_KLEINROOM_PKPOWER, moves(emote_double_exclamation_mark))
            waitmovement(LOCALID_KLEINROOM_PKPOWER)
            waitse
            playbgm(MUS_ENCOUNTER_MAGMA, FALSE)
            msgbox(format("What the!?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_PKPOWER)
            applymovement(LOCALID_KLEINROOM_PKPOWER, moves(walk_right))
            waitmovement(LOCALID_KLEINROOM_PKPOWER)
            applymovement(LOCALID_PLAYER, moves(face_left))
            waitmovement(LOCALID_PLAYER)
            msgbox(format("What are you two doing?\nI just paid the bail to get him out of jail!\pCouldn't you just stay put too? Bah, whatever...\pCome on, let's get the forum back up!\nIt's been down all day!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_PKPOWER)
            playse(SE_PIN)
            applymovement(LOCALID_KLEINROOM_PKPOWER, moves(emote_versus))
            waitse
            call(KleinPkPowerRoom_EventScript_PkPowerBattle)
            msgbox(format("Perfect! You've passed the test!\nYou've got to know how to act under pressure.\pCome on, let's get the forum back up!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_PKPOWER)
            fadescreen(FADE_TO_BLACK)
            setobjectxy(LOCALID_KLEINROOM_PKPOWER, 2, 4)
            setobjectxyperm(LOCALID_KLEINROOM_PKPOWER, 2, 4)
            setobjectmovementtype(LOCALID_KLEINROOM_PKPOWER, MOVEMENT_TYPE_FACE_UP)
            setobjectxy(LOCALID_KLEINROOM_KLEIN, 2, 7)
            setobjectxyperm(LOCALID_KLEINROOM_KLEIN, 2, 7)
            setobjectmovementtype(LOCALID_KLEINROOM_KLEIN, MOVEMENT_TYPE_FACE_UP)
            applymovement(LOCALID_KLEINROOM_PKPOWER, moves(face_up))
            applymovement(LOCALID_KLEINROOM_KLEIN, moves(face_up))
            applymovement(LOCALID_PLAYER, moves(walk_left walk_up))
            waitmovement(LOCALID_NONE)
            fadescreen(FADE_FROM_BLACK)
            call(WahRoomsShared_OpenDoor)
            call(WahRoomsShared_EventScript_AfterBattle)

        }
    }
    release
    end
}

script KleinPkPowerRoom_EventScript_OpenJail {
    setmetatile(9, 5, METATILE_room_kleinpkpower_JAIL_DOOR_OPENING_1, 0)
    special(DrawWholeMapView)
    delay(10)
    setmetatile(9, 5, METATILE_room_kleinpkpower_JAIL_DOOR_OPENING_2, 0)
    special(DrawWholeMapView)
    delay(10)
    setmetatile(9, 5, METATILE_room_kleinpkpower_JAIL_DOOR_OPENING_3, 0)
    special(DrawWholeMapView)
    delay(10)
    setmetatile(9, 5, METATILE_room_kleinpkpower_JAIL_FLOOR, 0)
    special(DrawWholeMapView)
    waitse
    setmetatileelevation(9, 6, 0)
    return
}

script KleinPkPowerRoom_EventScript_KleinBattle {
    if (!flag(FLAG_WAH_CHALLENGE_COMPLETED)) {
        trainerbattle_no_intro(TRAINER_WAH_ADMIN_KLEIN_MAIN, KleinPkPowerRoom_Text_KleinDefeated)
    } else {
        setvar(VAR_0x8004, TEAM_INDEX_KLEIN)
        special(ShouldUseAlternativeTeam)
        if (var(VAR_RESULT) == 0) {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_KLEIN_MAIN, KleinPkPowerRoom_Text_KleinDefeated)
        } else {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_KLEIN_ALTERNATIVE, KleinPkPowerRoom_Text_KleinDefeated)
        }
    }
    setflag(FLAG_DEFEATED_ADMIN_KLEIN)
    call(WahRoomsShared_EventScript_AfterBattle)
    return
}

text KleinPkPowerRoom_Text_KleinDefeated {
    format("Now what?\nBack to the slammer?")
}

script KleinPkPowerRoom_EventScript_PkPowerBattle {
    if (!flag(FLAG_WAH_CHALLENGE_COMPLETED)) {
        trainerbattle_no_intro(TRAINER_WAH_ADMIN_PKPOWER_MAIN, KleinPkPowerRoom_Text_PkPowerDefeated)
    } else {
        setvar(VAR_0x8004, TEAM_INDEX_PKPOWER)
        special(ShouldUseAlternativeTeam)
        if (var(VAR_RESULT) == 0) {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_PKPOWER_MAIN, KleinPkPowerRoom_Text_PkPowerDefeated)
        } else {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_PKPOWER_ALTERNATIVE, KleinPkPowerRoom_Text_PkPowerDefeated)
        }
    }
    setflag(FLAG_DEFEATED_ADMIN_PKPOWER)
    return
}

text KleinPkPowerRoom_Text_PkPowerDefeated {
    format("What a mess! Back to work!")
}

script KleinPkPowerRoom_EventScript_PkPower {
    lock
    faceplayer
    if(flag(FLAG_DEFEATED_ADMIN_PKPOWER)) {
        msgbox(format("I should get some work done now while there are no more calls.\pNow get out of here!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_PKPOWER)
    }
    else {
        msgbox(format("Can't you see I'm busy?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_PKPOWER)
    }
    applymovement(LOCALID_KLEINROOM_PKPOWER, moves(face_up))
    waitmovement(LOCALID_KLEINROOM_PKPOWER)
    release
    end
}

script KleinPkPowerRoom_EventScript_Klein {
    lock
    faceplayer
    msgbox(format("Research Team?\nOr Team Garbage?\pWhat do you care about the hack on Perro."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_KLEIN)
    applymovement(LOCALID_KLEINROOM_KLEIN, moves(face_up))
    waitmovement(LOCALID_KLEINROOM_KLEIN)
    release
    end
}

