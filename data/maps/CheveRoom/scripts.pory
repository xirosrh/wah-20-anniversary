const FLAG_TEMP_1_CHEVE_ROOM_HIDE_MEGANIUM = FLAG_TEMP_1
const FLAG_TEMP_2_CHEVE_ROOM_HIDE_POKEBALL = FLAG_TEMP_2
const FLAG_TEMP_3_CHEVE_ROOM_HIDE_TREE = FLAG_TEMP_3

mapscripts CheveRoom_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: CheveRoom_OnTransition
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_8, 0: CheveRoom_OnWarp_PlayerTurnNorth
    ]
    MAP_SCRIPT_ON_LOAD: CheveRoom_OnLoad

}

script CheveRoom_OnLoad {
    if(flag(FLAG_DEFEATED_ADMIN_CHEVE)){
        call(WahRoomsShared_SetDoorAsOpen)
    }
    end
}

script CheveRoom_OnWarp_PlayerTurnNorth {
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    end
}

script CheveRoom_OnTransition {
    call(WahRoomsShared_Kecleon_SetSala_Cheve)
    setflag(FLAG_TEMP_1_CHEVE_ROOM_HIDE_MEGANIUM)
    setflag(FLAG_TEMP_2_CHEVE_ROOM_HIDE_POKEBALL)
    end
}

script CheveRoom_EventScript_Cheve {
    lock
    faceplayer
    msgbox(format("So you came back? Don't tell me… you want a rematch?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CHEVE)
    call(CheveRoom_EventScript_WalkInPlaceCheveFacingPlayer)
    delay(10)
    msgbox(format("Don't even dream of it. I'm in the middle of a creative process… i.e., procrastinating."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CHEVE)
    playse(SE_PIN)
    applymovementandwait(LOCALID_CHEVEROOM_CHEVE, Common_Movement_XDWithDelay48)
    delay(10)
    msgbox(format("I appreciate the visit, though.\pIt's nice when someone comes back to your room, even if it's just to say hi to the tree that wasn't a tree."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CHEVE)
    playse(SE_PIN)
    applymovementandwait(LOCALID_CHEVEROOM_CHEVE, Common_Movement_HeartWithDelay48)
    msgbox(format("Greetings!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CHEVE)
    release
    end
}

script CheveRoom_EventScript_WalkInPlaceCheveFacingPlayer {
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    switch(var(VAR_RESULT)) {
        case DIR_NORTH:
            applymovementandwait(LOCALID_CHEVEROOM_CHEVE, Common_Movement_WalkInPlaceDown)
            break
        case DIR_SOUTH:
            applymovementandwait(LOCALID_CHEVEROOM_CHEVE, Common_Movement_WalkInPlaceUp)
            break
        case DIR_WEST:
            applymovementandwait(LOCALID_CHEVEROOM_CHEVE,Common_Movement_WalkInPlaceRight)
            break
        case DIR_EAST:
            applymovementandwait(LOCALID_CHEVEROOM_CHEVE, Common_Movement_WalkInPlaceLeft)
            break
    }
    return
}

script CheveRoom_EventScript_CuttableTree {
    lock
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    switch(var(VAR_RESULT)){
        case DIR_SOUTH:
            applymovementandwait(LOCALID_PLAYER, moves(
                walk_left
                walk_down * 2
                walk_right
                face_up
            ))
            break
        case DIR_WEST:
            applymovementandwait(LOCALID_PLAYER, moves(
                walk_down
                walk_left
                face_up
            ))
            break
        case DIR_EAST:
            applymovementandwait(LOCALID_PLAYER, moves(
                walk_down
                walk_right
                face_up
            ))
    }
    msgbox(format("Why are you looking at me like that?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_UNKNOWN)
    playse(SE_PIN)
    applymovementandwait(LOCALID_PLAYER, moves(emote_double_exclamation_mark))
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_PLAYER, moves(
        lock_facing_direction, 
        jump_in_place_up))
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_PLAYER, moves(
        jump_down, 
        unlock_facing_direction
        face_up))
    waitse
    msgbox(format("You want to Cut me down?\pDon't hurt me, I'm Cheve!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_UNKNOWN)
    playse(SE_PIN)
    applymovementandwait(LOCALID_PLAYER, Common_Movement_SurpriseWithDelay48)
    delay(20)
    special(SpawnCameraObject)
    applymovementandwait(LOCALID_CAMERA, Common_Movement_WalkUp2)
    applymovementandwait(LOCALID_CHEVEROOM_CHEVE, Common_Movement_WalkDown)
    call(WahRoomsShared_OpenDoor)
    delay(20)
    showobjectat(LOCALID_CHEVEROOM_CHEVE, MAP_CHEVE_ROOM)
    setobjectmovementtype(LOCALID_CHEVEROOM_CHEVE, MOVEMENT_TYPE_FACE_DOWN)
    setobjectmovementtype2(LOCALID_CHEVEROOM_CHEVE, MOVEMENT_TYPE_FACE_DOWN)
    applymovementandwait(LOCALID_CHEVEROOM_CHEVE, Common_Movement_WalkDown)
    delay(20)
    call(WahRoomsShared_CloseDoor)
    msgbox(format("Go, Sprout!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CHEVE)
    special(RemoveCameraObject)
    clearflag(FLAG_TEMP_2_CHEVE_ROOM_HIDE_POKEBALL)
    addobject(LOCALID_CHEVEROOM_POKEBALL)
    showobjectat(LOCALID_CHEVEROOM_POKEBALL, MAP_CHEVE_ROOM)
    applymovementandwait(LOCALID_CHEVEROOM_POKEBALL, Common_Movement_WalkDiagSouthEast)
    playse(SE_BALL_OPEN)
    fadescreen(FADE_TO_WHITE)
    removeobject(LOCALID_CHEVEROOM_POKEBALL)
    clearflag(FLAG_TEMP_1_CHEVE_ROOM_HIDE_MEGANIUM)
    addobject(LOCALID_CHEVEROOM_MEGANIUM)
    waitse
    fadescreen(FADE_FROM_WHITE)
    release
    playmoncry(SPECIES_MEGANIUM, CRY_MODE_NORMAL)
    waitmoncry
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_CHEVEROOM_MEGANIUM, moves(
        lock_facing_direction
        jump_down
    ))
    playse(SE_LEDGE)
    applymovement(LOCALID_CHEVEROOM_MEGANIUM, moves(
        jump_up
        unlock_facing_direction
    ))
    waitmovement(0)
    release
    playse(SE_M_CUT)
    load_field_pic(FP_CUT_ATTACK, 121, 75, VAR_TEMP_2)
    delay(60)
    destroy_field_pic(FP_CUT_ATTACK, VAR_TEMP_2)
    applymovementandwait(LOCALID_CHEVEROOM_TREE, Movement_CutTreeDown)
    delay(20)
    playse(SE_BALL_OPEN)
    fadescreen(FADE_TO_WHITE)
    removeobject(LOCALID_CHEVEROOM_MEGANIUM)
    setflag(FLAG_TEMP_1_CHEVE_ROOM_HIDE_MEGANIUM)
    waitse
    fadescreen(FADE_FROM_WHITE)
    special(SpawnCameraObject)
    applymovement(LOCALID_CHEVEROOM_CHEVE, Common_Movement_WalkDown3)
    applymovement(LOCALID_CAMERA, Common_Movement_WalkDown2)
    waitmovement(LOCALID_CHEVEROOM_CHEVE)
    special(RemoveCameraObject)
    msgbox(format("You fell for it completely."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CHEVE)
    applymovementandwait(LOCALID_CHEVEROOM_CHEVE, Common_Movement_WalkInPlaceDown)
    delay(10)
    msgbox(format("Did you really think I was a tree?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CHEVE)
    playse(SE_PIN)
    applymovementandwait(LOCALID_CHEVEROOM_CHEVE, Common_Movement_XDWithDelay48)
    delay(30)
    msgbox(format("But hey… I didn't expect you to make it all the way to my room.\pAnd even less after beating my great friend Javi4315!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CHEVE)
    applymovementandwait(LOCALID_CHEVEROOM_CHEVE, Common_Movement_WalkInPlaceDown)
    delay(10)
    msgbox(format("I respect him a lot, so… let's say that alone makes me like you."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CHEVE)
    playse(SE_PIN)
    applymovementandwait(LOCALID_CHEVEROOM_CHEVE, Common_Movement_SmileWithDelay48)
    delay(20)
    msgbox(format("I guess it's my turn to put your luck to the test."),MSGBOX_AUTOCLOSE, speaker = SP_NAME_CHEVE)
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_CHEVEROOM_CHEVE, Common_Movement_JumpInPlaceDown)
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_CHEVEROOM_CHEVE, Common_Movement_JumpInPlaceDown)
    waitse
    msgbox(format("Fair warning, though… I'm not a big fan of long battles.\pI'd rather procrastinate… my favorite activity!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CHEVE)
    playse(SE_PIN)
    applymovementandwait(LOCALID_CHEVEROOM_CHEVE, Common_Movement_WinkWithDelay48)
    msgbox(format("Let's go!"), speaker = SP_NAME_CHEVE)
    playse(SE_PIN)
    applymovementandwait(LOCALID_CHEVEROOM_CHEVE, moves(emote_versus))
    waitse
    call(CheveRoom_EventScript_CheveBattle)
    msgbox(format("Ugh… what a beating."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CHEVE)
    playse(SE_PIN)
    applymovementandwait(LOCALID_CHEVEROOM_CHEVE, Common_Movement_SweatDropWithDelay48)
    delay(20)
    msgbox(format("Makes me want to put off my rematch until next century.\pBut hey, don't get me wrong… it was fun!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CHEVE)
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_CHEVEROOM_CHEVE, Common_Movement_JumpInPlaceDown)
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_CHEVEROOM_CHEVE, Common_Movement_JumpInPlaceDown)
    delay(30)
    msgbox(format("I guess that's what this place is like: someone new always shows up at your room, and when they leave, they hang one more little painting on the wall.\pMine's got quite a few already, but this battle deserves a new one."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CHEVE)
    playse(SE_PIN)
    applymovementandwait(LOCALID_CHEVEROOM_CHEVE, Common_Movement_HeartWithDelay48)
    msgbox(format("Come on, keep going.\pI'm sure the next floor has another surprise in store for you."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CHEVE)
    call(WahRoomsShared_OpenDoor)
    applymovementandwait(LOCALID_CHEVEROOM_CHEVE, Common_Movement_WalkInPlaceDown)
    msgbox(format("Greetings!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_CHEVE)
    setflag(FLAG_DEFEATED_ADMIN_CHEVE)
    removeobject(LOCALID_CHEVEROOM_TREE)
    setflag(FLAG_TEMP_3_CHEVE_ROOM_HIDE_TREE)
    setobjectxyperm(LOCALID_CHEVEROOM_CHEVE, 6, 5)
    setobjectmovementtype2(LOCALID_CHEVEROOM_CHEVE, MOVEMENT_TYPE_FACE_DOWN)
    call(WahRoomsShared_EventScript_AfterBattle)
    release
    end
}

script CheveRoom_EventScript_CheveBattle {
    if (!flag(FLAG_WAH_CHALLENGE_COMPLETED)) {
        trainerbattle_no_intro(TRAINER_WAH_ADMIN_CHEVE_MAIN, CheveRoom_Text_CheveDefeated)
    } else {
        setvar(VAR_0x8004, TEAM_INDEX_CHEVE)
        special(ShouldUseAlternativeTeam)
        if (var(VAR_RESULT) == 0) {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_CHEVE_MAIN, CheveRoom_Text_CheveDefeated)
        } else {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_CHEVE_ALTERNATIVE, CheveRoom_Text_CheveDefeated)
        }
    }
    return
}

text CheveRoom_Text_CheveDefeated {
    format("Great battle! It reminded me of my showdowns with Xavi.")
}