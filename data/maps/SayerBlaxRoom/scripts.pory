const VAR_TEMP_0_SAYER_BLAX_ROOM_STATE = VAR_TEMP_0

mapscripts SayerBlaxRoom_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_TEMP_0_SAYER_BLAX_ROOM_STATE, 0: SayerBlaxRoom_OnFrame
	]
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_8, 0: SayerBlaxRoom_OnWarp_PlayerTurnNorth
    ]
    MAP_SCRIPT_ON_LOAD: SayerBlaxRoom_OnLoad
    MAP_SCRIPT_ON_TRANSITION: SayerBlaxRoom_OnTransition
}


script SayerBlaxRoom_OnTransition {
    call(WahRoomsShared_Kecleon_SetSala_SayerBlax)
    if(var(VAR_TEMP_0_SAYER_BLAX_ROOM_STATE) == 1) {
        setobjectmovementtype(LOCALID_SAYERBLAXROOM_SAYER, MOVEMENT_TYPE_FACE_RIGHT)
        setobjectxy(LOCALID_SAYERBLAXROOM_SAYER, 5, 10)
        setobjectxyperm(LOCALID_SAYERBLAXROOM_SAYER, 5, 10)
    }
    end
}

script SayerBlaxRoom_OnLoad {
    if(flag(FLAG_DEFEATED_ADMINS_SAYER_AND_BLAX)){
        call(WahRoomsShared_SetDoorAsOpen)
    }
    end
}

script SayerBlaxRoom_OnWarp_PlayerTurnNorth {
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    end
}

script SayerBlaxRoom_OnFrame {
    special(ShowMapNamePopup)
    applymovementandwait(LOCALID_PLAYER, Common_Movement_WalkUp3)
    special(SpawnCameraObject)
    directcameramovementtopos(6,5)
    waitmovement(0)
    delay(50)
    playse(SE_M_SNORE)
    delay(150)
    setobjectmovementtype2(LOCALID_SAYERBLAXROOM_BLAX, MOVEMENT_TYPE_FACE_DOWN)
    turnobject(LOCALID_SAYERBLAXROOM_BLAX, DIR_SOUTH)
    delay(30)
    msgbox(format("Phew, so tired! And I really needed that rest, too…"), MSGBOX_AUTOCLOSE, SP_NAME_BLAX)
    applymovementandwait(LOCALID_SAYERBLAXROOM_BLAX, Common_Movement_WalkLeft)
    waitmovement(0)
    msgbox(format("Is it the anniversary already?"), MSGBOX_AUTOCLOSE, SP_NAME_BLAX)
    applymovementandwait(LOCALID_SAYERBLAXROOM_BLAX, moves(
        walk_left
        walk_down
        walk_left
        face_down
        delay_16))
    playse(SE_PIN)
    applymovementandwait(LOCALID_SAYERBLAXROOM_BLAX, moves(emote_question_mark))
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_SAYERBLAXROOM_BLAX, moves(jump_in_place_down))
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_SAYERBLAXROOM_BLAX, moves(
        jump_in_place_down
        delay_16
    ))
    msgbox(format("Who are you?"), MSGBOX_AUTOCLOSE, SP_NAME_BLAX)
    applymovement(LOCALID_SAYERBLAXROOM_BLAX, Common_Movement_WalkDown3)
    applymovement(LOCALID_CAMERA, Common_Movement_WalkDown5)
    waitmovement(LOCALID_CAMERA)
    special(RemoveCameraObject)
    msgbox(format("What? You want to battle? I retired many years ago, kid.\pWe even lived through a pandemic… But if you insist… don't think I'll make it easy for you."), MSGBOX_AUTOCLOSE, SP_NAME_BLAX)
    delay(20)
    applymovementandwait(LOCALID_SAYERBLAXROOM_BLAX, moves(
        face_up
        delay_16
        face_right
        delay_16
        face_left
        delay_16
    ))
    msgbox(format("And where's Sayer gotten to now…? We were supposed to battle you together."), MSGBOX_AUTOCLOSE, SP_NAME_BLAX)
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_SAYERBLAXROOM_SAYER, Common_Movement_JumpDown)
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_SAYERBLAXROOM_SAYER, moves(jump_2_left))
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_SAYERBLAXROOM_SAYER, moves(jump_2_down))
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_SAYERBLAXROOM_SAYER, moves(jump_right))
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_SAYERBLAXROOM_SAYER, Common_Movement_JumpDown)
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_SAYERBLAXROOM_SAYER, moves(jump_right))
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_SAYERBLAXROOM_SAYER, moves(jump_2_right))
    turnobject(LOCALID_PLAYER, DIR_WEST)
    msgbox(format("Welcome to the jungle!"), MSGBOX_DEFAULT, speaker = SP_NAME_SAYER)
    turnobject(LOCALID_SAYERBLAXROOM_BLAX, DIR_SOUTH)
    playse(SE_PIN)
    applymovement(LOCALID_SAYERBLAXROOM_BLAX, Common_Movement_VersusWithDelay48)
    applymovement(LOCALID_SAYERBLAXROOM_SAYER, Common_Movement_VersusWithDelay48)
    waitmovement(0)
    call(SayerBlaxRoom_EventScript_SayerBlaxBattle)
    playse(SE_LEDGE)
    applymovement(LOCALID_SAYERBLAXROOM_SAYER, moves(
        lock_facing_direction
        jump_2_left
        unlock_facing_direction
    ))
    applymovement(LOCALID_SAYERBLAXROOM_BLAX, moves(
        lock_facing_direction
        jump_2_up
        unlock_facing_direction
    ))
    waitmovement(0)
    playse(SE_PIN)
    applymovement(LOCALID_SAYERBLAXROOM_SAYER, moves(emote_x))
    applymovement(LOCALID_SAYERBLAXROOM_BLAX, moves(emote_x))
    waitmovement(0)
    delay(20)
    applymovementandwait(LOCALID_SAYERBLAXROOM_BLAX, Common_Movement_WalkDown2)
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    msgbox(format("That was a spectacular battle."), MSGBOX_AUTOCLOSE, SP_NAME_BLAX)
    playse(SE_PIN)
    applymovementandwait(LOCALID_SAYERBLAXROOM_BLAX, Common_Movement_HappyWithDelay48)
    msgbox(format("Confirmed: I'm rustier than I thought."), MSGBOX_AUTOCLOSE, SP_NAME_BLAX)
    playse(SE_PIN)
    applymovementandwait(LOCALID_SAYERBLAXROOM_BLAX, Common_Movement_SweatDropWithDelay48)
    msgbox(format("You've still got many battles ahead, but make the most of every one of them to celebrate these 20 years of the best Pokémon ROM hacking and fangaming forum in the world.\pThat said… I'm going back to sleep. Good luck!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_BLAX)
    applymovementandwait(LOCALID_SAYERBLAXROOM_BLAX, moves(
        walk_up * 4
        walk_right * 3
        face_down
    ))
    setobjectmovementtype2(LOCALID_SAYERBLAXROOM_BLAX, MOVEMENT_TYPE_SLEEPING)
    applymovementandwait(LOCALID_SAYERBLAXROOM_SAYER, Common_Movement_WalkRight2)
    turnobject(LOCALID_PLAYER, DIR_WEST)
    msgbox(format("And remember: don't cause trouble, and if you can, well, do."), MSGBOX_AUTOCLOSE, SP_NAME_SAYER)
    setvar(VAR_TEMP_0_SAYER_BLAX_ROOM_STATE, 1)
    setobjectxyperm(LOCALID_SAYERBLAXROOM_SAYER, 5, 10)
    setobjectmovementtype2(LOCALID_SAYERBLAXROOM_SAYER, MOVEMENT_TYPE_FACE_RIGHT)
    call(WahRoomsShared_OpenDoor)
    setflag(FLAG_DEFEATED_ADMINS_SAYER_AND_BLAX)
    call(WahRoomsShared_EventScript_AfterBattle)
    release
    end

}

script SayerBlaxRoom_EventScript_Blax {
    msgbox(format("Zzz… Go, BLAxTOISE!\pZzz…"), MSGBOX_AUTOCLOSE, SP_NAME_BLAX)
    end
}

script SayerBlaxRoom_EventScript_Sayer {
    msgbox(format("I honestly can't complain, I ended up pretty happy with the battle.\pMove on, champ."), MSGBOX_NPC, SP_NAME_SAYER)
    end
}

script SayerBlaxRoom_EventScript_SayerBlaxBattle {
    if (!flag(FLAG_WAH_CHALLENGE_COMPLETED)) {
        trainerbattle_two_trainers(TRAINER_WAH_ADMIN_BLAX_MAIN, SayerBlaxRoom_Text_BlaxDefeated, TRAINER_WAH_ADMIN_SAYER_MAIN, SayerBlaxRoom_Text_SayerDefeated)
    } else {
        setvar(VAR_0x8004, TEAM_INDEX_BLAX)
        special(ShouldUseAlternativeTeam)
        copyvar(VAR_0x8005, VAR_RESULT)
        setvar(VAR_0x8004, TEAM_INDEX_SAYER)
        special(ShouldUseAlternativeTeam)
        // VAR_0x8005 = Blax team, VAR_RESULT = Sayer team
        if (var(VAR_0x8005) == 0) {
            if (var(VAR_RESULT) == 0) {
                trainerbattle_two_trainers(TRAINER_WAH_ADMIN_BLAX_MAIN, SayerBlaxRoom_Text_BlaxDefeated, TRAINER_WAH_ADMIN_SAYER_MAIN, SayerBlaxRoom_Text_SayerDefeated)
            } else {
                trainerbattle_two_trainers(TRAINER_WAH_ADMIN_BLAX_MAIN, SayerBlaxRoom_Text_BlaxDefeated, TRAINER_WAH_ADMIN_SAYER_ALTERNATIVE, SayerBlaxRoom_Text_SayerDefeated)
            }
        } else {
            if (var(VAR_RESULT) == 0) {
                trainerbattle_two_trainers(TRAINER_WAH_ADMIN_BLAX_ALTERNATIVE, SayerBlaxRoom_Text_BlaxDefeated, TRAINER_WAH_ADMIN_SAYER_MAIN, SayerBlaxRoom_Text_SayerDefeated)
            } else {
                trainerbattle_two_trainers(TRAINER_WAH_ADMIN_BLAX_ALTERNATIVE, SayerBlaxRoom_Text_BlaxDefeated, TRAINER_WAH_ADMIN_SAYER_ALTERNATIVE, SayerBlaxRoom_Text_SayerDefeated)
            }
        }
    }
    return
}

text SayerBlaxRoom_Text_BlaxDefeated {
    format("Well, you won. Congratulations!")
}

text SayerBlaxRoom_Text_SayerDefeated {
    format("You sure stirred things up.")
}
