mapscripts RestRoom_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: RestRoom_OnTransition
}


script RestRoom_OnTransition {
    call(Common_EventScript_SetupRivalGfxId)
    end
}

script RestRoom_EventScript_Boy1 {
    msgbox(format("PENDIENTE"), MSGBOX_NPC)
    end
}

script RestRoom_EventScript_Girl1 {
    msgbox(format("PENDIENTE"), MSGBOX_NPC)
    end
}

script RestRoom_EventScript_PlayerCounterpart {
    msgbox(format("PENDIENTE"), MSGBOX_NPC)
    end
}

script RestRoom_EventScript_Shop {
	lock
    faceplayer
    message("¡Hola! ¿En qué puedo ayudarte?\n¡Aquí somos un poco más caros!")
	waitmessage
	setflag(FLAG_REST_ROOM_MART_PRICE_MULTIPLIER)
	call(WahRoomsShared_EventScript_Shop)
	clearflag(FLAG_REST_ROOM_MART_PRICE_MULTIPLIER)
	release
    end
}

