mapscripts RestRoom_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: RestRoom_OnTransition
     MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_8, 0: RestRoom_OnWarp_PlayerTurnNorth
    ]
}


script RestRoom_OnWarp_PlayerTurnNorth {
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    end
}
script RestRoom_OnTransition {
    call(Common_EventScript_SetupRivalGfxId)
    end
}

script RestRoom_EventScript_Boy1 {
    lock
    faceplayer
    msgbox(format("Phew, finally a rest area!"), MSGBOX_AUTOCLOSE)
    call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
    msgbox(format("For a moment I thought all 21 rooms were back-to-back with no break…"), MSGBOX_AUTOCLOSE)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_SweatDropWithDelay48)
    setvar(VAR_0x8004, SPECIES_GRENINJA)
    specialvar(VAR_RESULT, Special_BufferPokeboxBuyOfferFromSpecies)
    if(var(VAR_RESULT) == TRUE) {
        msgbox(format("I'm struggling; I need to prepare better for the next rooms.\pI'll tweak some moves, buy some healing items, and…\pI think I'll buy a {STR_VAR_1}! I saw it's only {STR_VAR_2} in the PC - it's a steal!"), MSGBOX_AUTOCLOSE)
    }
    release
    end
}

script RestRoom_EventScript_Girl1 {
    lock
    faceplayer
    msgbox(format("The room designs are incredible!"), MSGBOX_AUTOCLOSE)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_HeartWithDelay48)
    msgbox(format("A theater, a jungle… even a cinema!\pCan you imagine how much work goes into all this?"), MSGBOX_AUTOCLOSE)
    release
    end
}

script RestRoom_EventScript_Boy2 {
    msgbox(format("The prices in this shop are a total ripoff!\pI should have bought everything I needed before coming in."), MSGBOX_NPC)
    end
}

script RestRoom_EventScript_AStartGaming {
    lock
    faceplayer
    msgbox(format("Originally I was going to help out as a translator on the localization effort.\pBut in the end, here I am, having a blast while I clear the challenge!"), MSGBOX_NPC, speaker = SP_NAME_A_START_GAMING)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_HappyWithDelay48)
    end
}

script RestRoom_EventScript_PlayerCounterpart {
    lock
    faceplayer
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_DoubleExclamationMark)
    msgbox(format("What a surprise, {PLAYER}!"), MSGBOX_AUTOCLOSE)
    delay(48)
    msgbox(format("So you're taking part in the challenge too?\pEvery room teaches us something about the community's leaders!\pI've learned a lot from them!"), MSGBOX_AUTOCLOSE)
    delay(10)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_Happy)
    msgbox(format("How exciting!"), MSGBOX_AUTOCLOSE)
    delay(48)
    release
    end
}

script RestRoom_EventScript_Raizen_TalkOnly {
    msgbox(format("Believe it or not, I come from far away.\pFrom Konoha, no less."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RAIZEN)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_ThinkingWithDelay48)
    msgbox(format("I'm a translator.\pThey called me in so everything that happens here could be known in other lands too."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RAIZEN)
    call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
    msgbox(format("It's not an S-rank mission, but someone had to do it!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RAIZEN)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_SweatDropWithDelay48)
    goto(RestRoom_EventScript_Raizen_OnFinishEvent)
}

script RestRoom_EventScript_Raizen_IntroFirstBattle {
    msgbox(format("So you've completed the challenge!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RAIZEN)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_SurpriseWithDelay48)
    msgbox(format("For me, being a translator is easy.\pThe hard part will be translating the beatdown I'm about to give you."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RAIZEN)
    call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
    msgbox(format("Come on, show me what you've got!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RAIZEN)
    return
}

script RestRoom_EventScript_Raizen_IntroRematch {
    msgbox(format("You're back!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RAIZEN)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_DoubleExclamationMarkWithDelay48)
    msgbox(format("Here for a rematch? I'll admit I didn't expect another mission this soon.\pThis time there'll be no scrolls or words to translate.\pJust you, me, and our Pokémon."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RAIZEN)
    call(WahRoomsShared_EventScript_WalkInPlaceLastTalkedFacingPlayer)
    setspeaker(SP_NAME_RAIZEN)
    message(format("What do you say?"))
    waitmessage
    dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, CollaboratorsRoom_RematchMultichoice_Rematch, CollaboratorsRoom_RematchMultichoice_TalkOnly, CollaboratorsRoom_RematchMultichoice_Exit)
    closemessage
    delay(20)
    switch(var(VAR_RESULT)) {
        case 0:
            msgbox(format("Mission accepted!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RAIZEN)
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_HappyWithDelay48)
            msgbox(format("Get ready, because this time I intend to finish it."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RAIZEN)
            return
        case 1:
            goto(RestRoom_EventScript_Raizen_TalkOnly)
        default:
            msgbox(format("Understood. I'll leave this mission pending.\pCome back when you're ready."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RAIZEN)
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_WinkWithDelay48)
            goto(RestRoom_EventScript_Raizen_OnFinishEvent)
    }
}

script RestRoom_EventScript_Raizen_OnFinishEvent {
    turnobject(VAR_LAST_TALKED, DIR_SOUTH)
    release
    end
}

script RestRoom_EventScript_Raizen {
    lock
    faceplayer
    if(!flag(FLAG_WAH_CHALLENGE_COMPLETED)) {
        goto(RestRoom_EventScript_Raizen_TalkOnly)
    }

    if(flag(FLAG_DEFEATED_REST_ROOM_RAIZEN)) {
        call(RestRoom_EventScript_Raizen_IntroRematch)
    } else {
        call(RestRoom_EventScript_Raizen_IntroFirstBattle)
    }

    playse(SE_PIN)
    applymovement(VAR_LAST_TALKED, Common_Movement_VersusWithDelay48)
    applymovement(LOCALID_PLAYER, Common_Movement_VersusWithDelay48)
    waitmovement(0)
    setflag(B_FLAG_NO_WHITEOUT)
    trainerbattle_no_intro(TRAINER_WAH_TRANSLATOR_RAIZEN, RestRoom_Text_Raizen_OnDefeat)
    clearflag(B_FLAG_NO_WHITEOUT)
    specialvar(VAR_RESULT, GetBattleOutcome)

    if(var(VAR_RESULT) == B_OUTCOME_WON) {
        playse(SE_PIN)
        applymovementandwait(VAR_LAST_TALKED, Common_Movement_SurpriseWithDelay48)
        msgbox(format("Incomprehensible!\pMy strategy got lost in translation on the battlefield."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RAIZEN)
        playse(SE_PIN)
        applymovementandwait(VAR_LAST_TALKED, Common_Movement_SadWithDelay48)
        if(!flag(FLAG_DEFEATED_REST_ROOM_RAIZEN)) {
            setflag(FLAG_DEFEATED_REST_ROOM_RAIZEN)
            call(Achievements_EventScript_Eval_DefeatTranslatorRaizen)
        }
    } else {
        msgbox(format("The result is clear in any language: you still have a lot to learn."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_RAIZEN)
        playse(SE_PIN)
        applymovementandwait(VAR_LAST_TALKED, Common_Movement_WinkWithDelay48)
    }

    call(WahRoomsShared_EventScript_AfterBattle)
    goto(RestRoom_EventScript_Raizen_OnFinishEvent)
}

text RestRoom_Text_Raizen_OnDefeat {
    format("I didn't understand a word of that...")
}

script RestRoom_EventScript_Shop {
	lock
    faceplayer
    if (flag(FLAG_WAH_CHALLENGE_COMPLETED) && !flag(FLAG_WAH_MART_COMBAT_ITEMS_ANNOUNCEMENT_SEEN)) {
        message(format("Hi! We've expanded the catalog!\pNow you can also buy battle items.\pHow can I help you?\nWe're a little pricier here!"))
        waitmessage
        setflag(FLAG_WAH_MART_COMBAT_ITEMS_ANNOUNCEMENT_SEEN)
    }
    else {
        message("Hi! How can I help you?\nWe're a little pricier here!")
        waitmessage
    }
	setflag(FLAG_REST_ROOM_MART_PRICE_MULTIPLIER)
	call(WahRoomsShared_EventScript_Shop)
	clearflag(FLAG_REST_ROOM_MART_PRICE_MULTIPLIER)
	release
    end
}

script RestRoom_EventScript_Pokebox {
    setvar(VAR_TEMP_C, 3)
    setvar(VAR_TEMP_D, 4)
    setvar(VAR_TEMP_E, METATILE_lobby_PC_RESTROOM_OFF)
    setvar(VAR_TEMP_F, METATILE_lobby_PC_RESTROOM_ON)
    call(WahRoomsShared_EventScript_Pokebox)
    end
}
