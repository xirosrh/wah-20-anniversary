const VAR_TEMP_0_DAVZERO_ROOM_STATE = VAR_TEMP_0
const FLAG_TEMP_1_DAVZERO_ROOM_HIDE_MILOTIC = FLAG_TEMP_1
const FLAG_TEMP_2_DAVZERO_ROOM_HIDE_BALL = FLAG_TEMP_2

mapscripts DavZeroRoom_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_0_DAVZERO_ROOM_STATE, 0: DavZeroRoom_OnFrame
	]
    MAP_SCRIPT_ON_TRANSITION: DavZeroRoom_OnTransition
    MAP_SCRIPT_ON_LOAD: DavZeroRoom_OnLoad
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_8, 0: DavZeroRoom_OnWarp_PlayerTurnNorth
    ]
}

script DavZeroRoom_OnLoad {
    if(flag(FLAG_DEFEATED_ADMIN_DAVZERO)){
        call(WahRoomsShared_SetDoorAsOpen)
    }
    end
}

script DavZeroRoom_OnWarp_PlayerTurnNorth {
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    end
}

script DavZeroRoom_OnTransition {
    call(WahRoomsShared_Kecleon_SetSala_DavZero)
    if(var(VAR_TEMP_0_DAVZERO_ROOM_STATE) == 0) {
        setflag(FLAG_TEMP_1_DAVZERO_ROOM_HIDE_MILOTIC)
        setflag(FLAG_TEMP_2_DAVZERO_ROOM_HIDE_BALL)
    }
    end
}

script DavZeroRoom_OnFrame {
    special(ShowMapNamePopup)
    applymovementandwait(LOCALID_PLAYER, moves(walk_up * 8, face_right))
    special(SpawnCameraObject)
    directcameramovementtopos(10,5)
    waitmovement(0)
    msgbox(format("All right, class, remember: it's 'i' before {COLOR RED}e{COLOR DARK_GRAY}, except after {COLOR BLUE}c{COLOR DARK_GRAY}."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    playse(SE_PIN)
    applymovement(LOCALID_ZEROROOM_SCHOOLGIRL, DavZeroRoom_Movement_GirlAndBoyLearning)
    applymovement(LOCALID_ZEROROOM_SCHOOLBOY, DavZeroRoom_Movement_GirlAndBoyLearning)
    waitmovement(0)
    waitse
    delay(20)
    turnobject(LOCALID_ZEROROOM_DAVZERO, DIR_WEST)
    playse(SE_PIN)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, Common_Movement_DoubleExclamationMarkWithDelay48)
    delay(20)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, Common_Movement_WalkInPlaceDown)
    msgbox(format("Hold on a second… I think today we have company!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    applymovement(LOCALID_ZEROROOM_DAVZERO, moves(walk_left * 3, walk_up, walk_left, face_down))
    applymovement(LOCALID_CAMERA, Common_Movement_WalkLeft4)
    waitmovement(LOCALID_ZEROROOM_DAVZERO)
    special(RemoveCameraObject)
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    msgbox(format("Aha, so you've finally made it here.\pIt's a pleasure to see you. Do you recognize me?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    dynmultichoice(0,0, TRUE, 3, 0, DYN_MULTICHOICE_CB_NONE, format("Yes, you're unmistakable!"), format("You look familiar - like a Machoke!"), format("Should I know you?"))
    if(var(VAR_RESULT) == 2)
    {
        delay(20)
        msgbox(format("You'll soon find out who I am."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    }
    playse(SE_PIN)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, Common_Movement_HappyWithDelay48)
    delay(10)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, moves(walk_left * 2, walk_down * 5, face_left))
    playse(SE_PIN)
    applymovementandwait(LOCALID_PLAYER, Common_Movement_QuestionMarkWithDelay48)
    applymovementandwait(LOCALID_PLAYER, moves(walk_down * 4, face_left))
    turnobject(LOCALID_ZEROROOM_DAVZERO, DIR_EAST)
    msgbox(format("I had to cut short my fourth set at 110 kg on the bench press.\pAll because I heard a contender was reaching this level.\pAnd you caught me right as I was teaching the spelling rules to my students…"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    playse(SE_PIN)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, Common_Movement_SweatDropWithDelay48)
    msgbox(format("Well, at least they can practice a while as we battle.\pThough I think they'll be quite eager to watch, because I sense this'll be a battle without equal."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    playse(SE_PIN)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, moves(emote_happy))
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, moves(jump_in_place_right))
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, moves(jump_in_place_right, delay_16))
    delay(20)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, Common_Movement_WalkRight)
    msgbox(format("Tell me… what's your goal? Do you want to challenge the flamethrower-wielding madman waiting at the end?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, Common_Movement_WalkLeft2)
    msgbox(format("By now you must know, since to get here you've had to face several colleagues of mine."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, Common_Movement_JumpInPlaceLeftRight)
    msgbox(format("But I won't make it easy for you in this battle!\pI've been training body, mind, and Pokémon awaiting your arrival."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, Common_Movement_WalkRight2)
    msgbox(format("Few challengers manage to make it this far.\pCongratulations."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    playse(SE_PIN)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, Common_Movement_SmileWithDelay48)
    msgbox(format("Come, let's take our places in the battle area."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    special(SpawnCameraObject)
    applymovement(LOCALID_ZEROROOM_DAVZERO, moves(walk_up * 3, walk_right, face_down))
    applymovement(LOCALID_PLAYER, Common_Movement_FaceUp)
    applymovement(LOCALID_CAMERA, Common_Movement_WalkUp)
    waitmovement(LOCALID_ZEROROOM_DAVZERO)
    special(RemoveCameraObject)
    msgbox(format("You know? Many think a battle is pure strength, but to me it's memory.\pEvery attack, every strategy, every mistake… is a reminder of who we were and what we became."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, Common_Movement_WalkInPlaceDown)
    msgbox(format("Let me make this clear: I'm not your rival.\pI'm the voice reminding you that every step, even within these four walls, can shape you more than you think."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, Common_Movement_WalkInPlaceDown)
    delay(10)
    msgbox(format("Some fight to win, and some fight to never make the same mistake again.\pWhich of those are you? Let me find out, because your gaze makes me curious…\pIt reminds me of that crazy time when I used to hang around that place that was once our home."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    playse(SE_PIN)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, Common_Movement_CryWithDelay48)
    msgbox(format("Well, that's enough - I'm getting too intense and this'll end up sounding like a Benedetti poem…\pAnd this time I didn't bring roses to go with it - just Poké Balls."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    clearflag(FLAG_TEMP_2_DAVZERO_ROOM_HIDE_BALL)
    addobject(LOCALID_ZEROROOM_POKEBALL)
    showobjectat(LOCALID_ZEROROOM_POKEBALL, MAP_DAV_ZERO_ROOM)
    applymovement(LOCALID_ZEROROOM_POKEBALL, Common_Movement_WalkDiagSouthEast)
    waitmovement(0)
	playse(SE_BALL_OPEN)
	fadescreen(FADE_TO_WHITE)
    removeobject(LOCALID_ZEROROOM_POKEBALL)
    clearflag(FLAG_TEMP_1_DAVZERO_ROOM_HIDE_MILOTIC)
    addobject(LOCALID_ZEROROOM_MILOTIC)
    fadescreen(FADE_FROM_WHITE)
    setobjectmovementtype2(LOCALID_ZEROROOM_DAVZERO, MOVEMENT_TYPE_FACE_DOWN)   
    release
    msgbox(format("Don't lose your nerve now!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    playse(SE_PIN)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, moves(emote_versus))
    waitse
    call(DavZeroRoom_EventScript_DavZeroBattle)
	playse(SE_BALL_OPEN)
    fadescreen(FADE_TO_WHITE)
    removeobject(LOCALID_ZEROROOM_MILOTIC)
    fadescreen(FADE_FROM_WHITE)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, Common_Movement_WalkDown2)
    msgbox(format("Today you're the one who came out victorious, and I'll admit it plainly.\pBut you must understand that you won't always come out on top."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    playse(SE_PIN)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, Common_Movement_ThinkingWithDelay48)
    msgbox(format("But listen: defeat is not the end of anything.\pOn the contrary, it's a mirror.\pIt reflects what we still don't want to see in ourselves - the things we avoid facing."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, Common_Movement_WalkInPlaceDown)
    msgbox(format("I learned it that way too, losing, messing up, falling again and again…"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    delay(10)
    msgbox(format("Laughing all the while."), MSGBOX_AUTOCLOSE, MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    playse(SE_PIN)
    applymovement(LOCALID_ZEROROOM_DAVZERO, Common_Movement_HappyWithDelay48)
    waitmovement(0)
    delay(20)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, moves(walk_left))
    playse(SE_PIN)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, moves(emote_thinking, walk_left, walk_right * 4, walk_left * 2, face_down))
    msgbox(format("You know? Success and victory aren't about piling up wins, or crushing rivals, or even in beating me right now.\pSuccess is getting up after you fall, in walking on with your scars in plain sight, in not giving up even when life or a battle has left you shaken."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    delay(10)
    msgbox(format("I want you to understand that."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, Common_Movement_WalkInPlaceDown)
    delay(20)
    msgbox(format("Today you beat me, and I'm glad you did.\pBecause it means you're also learning what really matters…\pAnd that I still have things to learn too."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO    )
    playse(SE_PIN)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, Common_Movement_HeartWithDelay48)
    msgbox(format("Hold on to that, because it's knowledge no Pokémon, no rival, and no badge can ever take from you."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, Common_Movement_WalkInPlaceDown)
    msgbox(format("I definitely wasn't wrong: you've got a different look in your eye.\pI'm proud that you won, because every victory like yours keeps the flame of this place alive."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    playse(SE_PIN)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, Common_Movement_HappyWithDelay48)
    delay(10)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, Common_Movement_WalkUp2)
    msgbox(format("Our encounter ends here, but not your journey.\pI was just an obstacle, like those dumbbells that seem impossible until one day you realize you can lift them."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    delay(20)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, Common_Movement_FaceDown)
    msgbox(format("And hey, if we ever cross paths at the gym, don't give me a weird look if I ask you to spot me on the bar.\pNo one is invincible."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    delay(20)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, Common_Movement_WalkDown2)
    msgbox(format("Now go, my friend. Follow your path, make mistakes, and learn."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, Common_Movement_WalkInPlaceDown)
    msgbox(format("Don't be afraid to lose.\pThe worst thing you can do is stop trying out of fear you won't measure up.\pI know it well… too many times I froze, worrying about what others would say about me, whether my mistakes defined me."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    playse(SE_PIN)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, Common_Movement_ThinkingWithDelay48)
    msgbox(format("You are not your failures, your falls, or what others think of you.\pYou are everything you do in spite of them.\pIf today you were able to beat me here, in this place, remember you'll also be able to face anything out there."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, Common_Movement_WalkInPlaceDown)
    msgbox(format("What is it? Why are you looking at me like that?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    dynmultichoice(0,0, TRUE, 4, 0, DYN_MULTICHOICE_CB_NONE, format("Great advice, worthy of a sage."), format("You made me think a little."), format("Is there much more of this speech?"), format("Was that a lecture?"))
    msgbox(format("Didn't expect this?\pWhat can I say? I'm just Zero."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO   )
    playse(SE_PIN)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, Common_Movement_SmileWithDelay48)
    special(SpawnCameraObject)
    directcameramovementtopos(6, 5)
    waitmovement(0)
	call(WahRoomsShared_OpenDoor)
    directcameramovementtopos(6, 9)
    waitmovement(0)
    special(RemoveCameraObject)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, moves(walk_up * 3, walk_right * 4, face_down))
    setvar(VAR_TEMP_0_DAVZERO_ROOM_STATE, 1)
    setflag(FLAG_DEFEATED_ADMIN_DAVZERO)
    call(WahRoomsShared_EventScript_AfterBattle)
    release
    end
}

script DavZeroRoom_EventScript_DavZeroBattle {
    if (!flag(FLAG_WAH_CHALLENGE_COMPLETED)) {
        trainerbattle_no_intro(TRAINER_WAH_ADMIN_DAVZERO_MAIN, DavZeroRoom_Text_DavZeroDefeated)
    } else {
        setvar(VAR_0x8004, TEAM_INDEX_DAVZERO)
        special(ShouldUseAlternativeTeam)
        if (var(VAR_RESULT) == 0) {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_DAVZERO_MAIN, DavZeroRoom_Text_DavZeroDefeated)
        } else {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_DAVZERO_ALTERNATIVE, DavZeroRoom_Text_DavZeroDefeated)
        }
    }
    return
}

text DavZeroRoom_Text_DavZeroDefeated {
    format("Phew… I can't deny it, you've surprised me.\pIt was one of those battles I love: intense, where every move seems to weigh twice as much and every decision matters.")
}
movement DavZeroRoom_Movement_GirlAndBoyLearning {
    emote_idea
    walk_in_place_up
    delay_16 * 2
}

script DavZeroRoom_EventScript_SchoolGirl {
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    if(var(VAR_RESULT) == DIR_NORTH) {
        end
    }
    lock
    faceplayer
    msgbox(format("Want to hear a secret? I finished school years ago.\pI only come here because Zero is so interesting!\pI could listen to him talk all day."), MSGBOX_AUTOCLOSE)
    turnobject(LOCALID_ZEROROOM_SCHOOLGIRL, DIR_NORTH)
    release
    end
}

script DavZeroRoom_EventScript_SchoolBoy {
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    if(var(VAR_RESULT) == DIR_NORTH) {
        end
    }
    lock
    faceplayer
    msgbox(format("Mr. Zero is super cool!"))
    playse(SE_PIN)
    applymovementandwait(LOCALID_ZEROROOM_SCHOOLBOY, Common_Movement_SmileWithDelay48)
    msgbox(format("When we were six he taught us English, and we learned the months of the year to the tune of La Macarena."), MSGBOX_AUTOCLOSE)
    playse(SE_PIN)
    applymovementandwait(LOCALID_PLAYER, Common_Movement_SurpriseWithDelay48)
    delay(20)
    turnobject(LOCALID_ZEROROOM_SCHOOLBOY, DIR_NORTH)
    release
    end
}

script DavZeroRoom_EventScript_Zero {
    lock
    faceplayer
    msgbox(format("If you want another deep quote, bring a ticket.\pMy work here is done."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_DAVZERO)
    playse(SE_PIN)
    applymovementandwait(LOCALID_ZEROROOM_DAVZERO, Common_Movement_XDWithDelay48)
    turnobject(LOCALID_ZEROROOM_DAVZERO, DIR_SOUTH)
    release
    end
}

script DavZeroRoom_EventScript_Dumbbells {
    msgbox(format("The dumbbells are heavy enough not to be just for show."), MSGBOX_SIGN)
    end
}

script DavZeroRoom_EventScript_PC {
    msgbox(format("It's a laptop that's on, with a Valencia CF wallpaper.\pThere are more tabs open than Team NoHack has alt accounts."), MSGBOX_SIGN)
    end
}

script DavZeroRoom_EventScript_Notes {
    msgbox(format("There are several sheets lying on the floor.\pThey look like notes of ideas for a poetry book."), MSGBOX_SIGN)
    end
}

script DavZeroRoom_EventScript_Library1 {
    msgbox(format("It looks like a collection of poetry books.\pOne stands out from the rest: “A Lustrum of Soliloquy.”\pThe author is listed as Zero."), MSGBOX_SIGN)
    end
}

script DavZeroRoom_EventScript_Library2 {
    msgbox(format("This shelf holds a series of installments.\pThey all share the same title: “History of Whack a Hack: Since 2005.”\pSkimming a few of them, you can read names like Deryko, Inmortal Kaktus, Franco Kuchiki, C!ro, Lon, Frax, Acspower, and Kalawus."), MSGBOX_SIGN)
    end
}

script DavZeroRoom_EventScript_Library3 {
    msgbox(format("There's educational material, teaching guides, emotional education, and psychology.\pMany sections on conflict resolution are underlined.\pIt seems someone hoped they'd be good for something… and also tried to apply them outside of class."), MSGBOX_SIGN)
    end
}

script DavZeroRoom_EventScript_Tredmill {
    msgbox(format("It's a treadmill with a built-in screen.\pAn episode of One Piece is playing."), MSGBOX_SIGN)
    end
}

script DavZeroRoom_EventScript_TrashCan {
    msgbox(format("You've found the meaning of life! Oh wait, it's dented bottles, drafts that didn't survive their author's self-criticism, and… used Fortnite cards?"), MSGBOX_SIGN)
    end
}

script DavZeroRoom_EventScript_Box1 {
    msgbox(format("Inside this box are consoles. You can spot a SNES and a Nintendo 64 alongside Zelda: Majora's Mask.\pThere's also a cartridge of Super Mario World 2: Yoshi's Island."), MSGBOX_SIGN)
    end
}

script DavZeroRoom_EventScript_Box2 {
    msgbox(format("Inside this box are video games and figures. Two stand out, titled “Mother 3” and “Phoenix Wright: Ace Attorney.”"), MSGBOX_SIGN)
    end
}

script DavZeroRoom_EventScript_StackedPlates {
    msgbox(format("They look like weight plates… or giant donuts for a Snorlax on a very strict diet."), MSGBOX_SIGN)
    end
}