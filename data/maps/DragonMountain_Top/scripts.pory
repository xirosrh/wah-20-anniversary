const FLAG_TEMP_1_HIDE_MOLTRES = FLAG_TEMP_1
const FLAG_TEMP_2_HIDE_ABRA_2 = FLAG_TEMP_2

mapscripts DragonMountain_Top_MapScripts {
     MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_1, 0: DragonMountain_Top_OnWarp
    ]
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_1, 0: DragonMountain_Top_OnFrame
    ]
    MAP_SCRIPT_ON_TRANSITION: DragonMountain_Top_OnTransition
}


script DragonMountain_Top_OnWarp {
    hideobjectat(LOCALID_MOUNTAINTOP_ABRA, MAP_DRAGON_MOUNTAIN_TOP)
    hideobjectat(LOCALID_PLAYER, MAP_DRAGON_MOUNTAIN_TOP)
    hideobjectat(LOCALID_MOUNTAINTOP_MOLTRES, MAP_DRAGON_MOUNTAIN_TOP)
    setflag(FLAG_TEMP_2_HIDE_ABRA_2)
    end
}


script DragonMountain_Top_OnTransition {
    setflag(FLAG_TEMP_1_HIDE_MOLTRES)
    end
}

script DragonMountain_Top_OnFrame {
    special(ShowMapNamePopup)
    call(WahRoomsShared_SetPlayerTeleportGfxVars)
    playse(SE_WARP_OUT)
    updateobjectsprite(LOCALID_MOUNTAINTOP_ABRA, OBJ_EVENT_GFX_ABRA_TELEPORTING_1)
    call(WahRoomsShared_UpdatePlayerSpriteTeleporting1)
    showobjectat(LOCALID_MOUNTAINTOP_ABRA, MAP_DRAGON_MOUNTAIN_TOP)
    showobjectat(LOCALID_PLAYER, MAP_DRAGON_MOUNTAIN_TOP)
    turnobject(LOCALID_MOUNTAINTOP_ABRA, DIR_WEST)
    turnobject(LOCALID_PLAYER, DIR_EAST)
    release
    delay(30)
    updateobjectsprite(LOCALID_MOUNTAINTOP_ABRA, OBJ_EVENT_GFX_ABRA_TELEPORTING_2)
    call(WahRoomsShared_UpdatePlayerSpriteTeleporting2)
    release
    delay(30)
    updateobjectsprite(LOCALID_MOUNTAINTOP_ABRA, OBJ_EVENT_GFX_SPECIES(ABRA))
    call(WahRoomsShared_UpdatePlayerSpriteNormal)
    playmoncry(SPECIES_ABRA, CRY_MODE_NORMAL)
    setvar(VAR_TEMP_1, 1)
    release
    end
}


script DragonMountain_Top_EventScript_Abra {
    lock
    release
    applymovementandwait(LOCALID_MOUNTAINTOP_ABRA, Common_Movement_FacePlayer)
    release
    playmoncry(SPECIES_ABRA, CRY_MODE_ENCOUNTER)
    releaseall
    delay(20)
    msgbox(format("Do you want to return to Serg!o's room?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES) {
        call(WahRoomsShared_SetPlayerTeleportGfxVars)
        playse(SE_WARP_IN)
        updateobjectsprite(LOCALID_MOUNTAINTOP_ABRA, OBJ_EVENT_GFX_ABRA_TELEPORTING_2)
		call(WahRoomsShared_UpdatePlayerSpriteTeleporting2)
		release
		delay(30)
		updateobjectsprite(LOCALID_MOUNTAINTOP_ABRA, OBJ_EVENT_GFX_ABRA_TELEPORTING_1)
		call(WahRoomsShared_UpdatePlayerSpriteTeleporting1)
        release
        delay(20)
        setvar(VAR_SERGIO_ROOM_STATE, 1)
		warpsilent(MAP_SERGIO_ROOM, WARP_ID_SERGIO_ROOM_ABRA)
		waitstate
    }
	release
    end
}

script DragonMountan_Top_EventScript_Sergio {
    lock
    faceplayer
    msgbox(format("..............\n.............."), speaker = SP_NAME_UNKNOWN)
    delay(30)
    fadescreen(FADE_TO_BLACK)
    closemessage
    fadescreen(FADE_FROM_BLACK)
    call(DragonMountan_Top_EventScript_WalkInPlaceSergioFacingPlayer)
    msgbox(format("Hey there! How's it going? Did you really think we weren't going to talk?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_UNKNOWN)
    playse(SE_PIN)
    applymovementandwait(LOCALID_MOUNTAINTOP_SERGIO, Common_Movement_XDWithDelay48)
    msgbox(format("I'm Serg!o… glad to see new faces around here!"),MSGBOX_AUTOCLOSE, speaker = SP_NAME_SERGIO)
    playse(SE_PIN)
    applymovementandwait(LOCALID_MOUNTAINTOP_SERGIO, moves(emote_smile))
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_MOUNTAINTOP_SERGIO, moves(lock_facing_direction, jump_in_place_down))
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_MOUNTAINTOP_SERGIO, moves(jump_in_place_down, unlock_facing_direction, face_player))
    delay(30)
    msgbox(format("What? You didn't expect to find me on this peak, three steps from falling off?\pNeither did I."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_SERGIO)
    delay(30)
    applymovementandwait(LOCALID_MOUNTAINTOP_SERGIO, Common_Movement_WalkInPlaceDown)
    msgbox(format("Who knows… maybe I'm the messiah."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_SERGIO)
    playse(SE_PIN)
    applymovementandwait(LOCALID_MOUNTAINTOP_SERGIO, Common_Movement_HappyWithDelay48)
    delay(30)
    msgbox(format("Tell me, what are you looking for up here?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_SERGIO)
    fadescreen(FADE_TO_BLACK)
    delay(20)
    fadescreen(FADE_FROM_BLACK)
    playse(SE_PIN)
    applymovementandwait(LOCALID_MOUNTAINTOP_SERGIO, Common_Movement_DoubleExclamationMark)
    msgbox(format("Huh? So you want to battle now?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_SERGIO)
    delay(50)
    msgbox(format("I admire that you made it here; I know I can be hard to find sometimes.\pBut I'm not ready to battle yet."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_SERGIO)
    call(DragonMountan_Top_EventScript_WalkInPlaceSergioFacingPlayer)
    special(SpawnCameraObject)
    directcameramovementtopos(15, 13)
    waitmovement(0)
    setfieldeffectargument(0, LOCALID_MOUNTAINTOP_SERGIO)
	dofieldeffect(FLDEFF_NPCFLY_OUT)
	delay(15)
	hideobjectat(LOCALID_MOUNTAINTOP_SERGIO, MAP_DRAGON_MOUNTAIN_TOP)
	waitfieldeffect(FLDEFF_NPCFLY_OUT)
	delay(30)
    applymovementandwait(LOCALID_PLAYER, moves(
        face_down
        delay_16
        face_right
        delay_16
        face_left
        delay_16
        face_up
    ))
    playse(SE_PIN)
    applymovementandwait(LOCALID_PLAYER, Common_Movement_QuestionMarkWithDelay48)
    delay(50)
    release
    applymovement(LOCALID_CAMERA, Common_Movement_WalkUp4)
    directmovementtopos(LOCALID_PLAYER, 15, 13)
    waitmovement(LOCALID_CAMERA)
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    playmoncry(SPECIES_DRAGONITE, CRY_MODE_NORMAL)
    waitmoncry
    applymovement(LOCALID_MOUNTAINTOP_SERGIODRAGONITE, Common_Movement_WalkDown6)
    applymovement(LOCALID_CAMERA, Common_Movement_WalkDown4)
    waitmovement(LOCALID_MOUNTAINTOP_SERGIODRAGONITE)
    special(RemoveCameraObject)
    release
    msgbox(format("Now I am!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_SERGIO)
    applymovementandwait(LOCALID_MOUNTAINTOP_SERGIODRAGONITE, moves(disable_jump_landing_ground_effect, jump_in_place_down, enable_jump_landing_ground_effect))
    release
    msgbox(format("The time to battle has come, and my dragons won't hold back.\pDragonite, unleash all your fury on the battlefield!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_SERGIO)
    playse(SE_PIN)
    applymovementandwait(LOCALID_MOUNTAINTOP_SERGIODRAGONITE, moves(emote_versus))
    waitse
    playmoncry(SPECIES_DRAGONITE, CRY_MODE_NORMAL)
    applymovementandwait(LOCALID_MOUNTAINTOP_SERGIODRAGONITE, moves(disable_jump_landing_ground_effect, jump_in_place_down * 2, enable_jump_landing_ground_effect))
    release
    delay(60)
    call(DragonMountan_Top_EventScript_SergioBattle)
    playse(SE_FAILURE)
    applymovementandwait(LOCALID_MOUNTAINTOP_SERGIODRAGONITE, moves(disable_jump_landing_ground_effect, lock_facing_direction, emote_x))
    waitse
    playmoncry(SPECIES_DRAGONITE, CRY_MODE_WEAK)
    applymovementandwait(LOCALID_MOUNTAINTOP_SERGIODRAGONITE, moves(jump_up, unlock_facing_direction, enable_jump_landing_ground_effect))
    release
    delay(100)
    fadescreen(FADE_TO_BLACK)
    showobjectat(LOCALID_MOUNTAINTOP_SERGIO, MAP_DRAGON_MOUNTAIN_TOP)
    setobjectxyperm(LOCALID_MOUNTAINTOP_SERGIO, 16, 14)
    setobjectxy(LOCALID_MOUNTAINTOP_SERGIO, 16, 14)
    turnobject(LOCALID_MOUNTAINTOP_SERGIO, DIR_WEST)
    applymovementandwait(LOCALID_PLAYER, Common_Movement_WalkDown)
    turnobject(LOCALID_PLAYER, DIR_EAST)
    hideobjectat(LOCALID_MOUNTAINTOP_SERGIODRAGONITE, MAP_DRAGON_MOUNTAIN_TOP)
    fadescreen(FADE_FROM_BLACK)
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_MOUNTAINTOP_SERGIO, moves(jump_in_place_left))
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_MOUNTAINTOP_SERGIO, moves(jump_in_place_left))
    msgbox(format("Congratulations! You've fulfilled WAH's dream!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_SERGIO)
    delay(30)
    msgbox(format("Now of course don't fall asleep on me - there's a ton of things left to do!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_SERGIO)
    playse(SE_PIN)
    applymovementandwait(LOCALID_MOUNTAINTOP_SERGIO, Common_Movement_HappyWithDelay48)
    special(SpawnCameraObject)
    directcameramovementtopos(15, 12)
    waitmovement(0)
    clearflag(FLAG_TEMP_1_HIDE_MOLTRES)
    addobject(LOCALID_MOUNTAINTOP_MOLTRES)
    showobjectat(LOCALID_MOUNTAINTOP_MOLTRES, MAP_DRAGON_MOUNTAIN_TOP)
    playse(SE_M_WING_ATTACK)
    applymovementandwait(LOCALID_MOUNTAINTOP_MOLTRES, Common_Movement_WalkLeft3)
    turnobject(LOCALID_MOUNTAINTOP_SERGIO, DIR_NORTH)
    playmoncry(SPECIES_MOLTRES, CRY_MODE_NORMAL)
    playse(SE_PIN)
    setspeaker(SP_NAME_SERGIO)
    message(format("Wow! Look who showed up here!"))
    applymovement(LOCALID_MOUNTAINTOP_SERGIO, Common_Movement_DoubleExclamationMarkWithDelay48)
    applymovement(LOCALID_MOUNTAINTOP_MOLTRES, Common_Movement_WalkLeft3)
    waitmovement(LOCALID_MOUNTAINTOP_MOLTRES)
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    playse(SE_PIN)
    applymovement(LOCALID_PLAYER, Common_Movement_DoubleExclamationMarkWithDelay48)
    applymovement(LOCALID_MOUNTAINTOP_MOLTRES, Common_Movement_WalkLeft3)
    waitmovement(LOCALID_MOUNTAINTOP_MOLTRES)
    playse(SE_M_WING_ATTACK)
    applymovementandwait(LOCALID_MOUNTAINTOP_MOLTRES, Common_Movement_WalkLeft8)
    closemessage
    delay(50)
    directcameramovementtopos(15, 14)
    waitmovement(0)
    special(RemoveCameraObject)
    turnobject(LOCALID_MOUNTAINTOP_SERGIO, DIR_WEST)
    turnobject(LOCALID_PLAYER, DIR_EAST)
    msgbox(format("Moltres is a Pokémon that has always been with us, because we're reborn from our ashes like the phoenix."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_SERGIO)
    call(DragonMountan_Top_EventScript_WalkInPlaceSergioFacingPlayer)
    delay(30)
    msgbox(format("It's wild that we've spent 20 years all together building this community.\pA lot of time has passed, but I feel very proud that together we've collaborated and shared our knowledge, striving to keep the spirit fun."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_SERGIO)
    call(DragonMountan_Top_EventScript_WalkInPlaceSergioFacingPlayer)
    delay(20)
    playse(SE_PIN)
    applymovementandwait(LOCALID_MOUNTAINTOP_SERGIO, Common_Movement_Heart)
    msgbox(format("A thousand thanks for being part of this celebration!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_SERGIO)
    delay(60)
    msgbox(format("Now come, follow me; it's time to record your feat in the Hall of Fame."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_SERGIO)
    call(DragonMountan_Top_EventScript_WalkInPlaceSergioFacingPlayer)
    call(WahRoomsShared_EventScript_AfterBattle)
    applymovementandwait(LOCALID_MOUNTAINTOP_SERGIO, moves(walk_down, walk_left, face_down))
    turnobject(LOCALID_PLAYER, DIR_SOUTH)
    clearflag(FLAG_TEMP_2_HIDE_ABRA_2)
    addobject(LOCALID_MOUNTAINTOP_ABRA_2)
    playse(SE_WARP_OUT)
    updateobjectsprite(LOCALID_MOUNTAINTOP_ABRA_2, OBJ_EVENT_GFX_ABRA_TELEPORTING_1)
    showobjectat(LOCALID_MOUNTAINTOP_ABRA_2, MAP_DRAGON_MOUNTAIN_TOP)
    turnobject(LOCALID_MOUNTAINTOP_ABRA_2, DIR_NORTH)
    release
    delay(30)
    updateobjectsprite(LOCALID_MOUNTAINTOP_ABRA_2, OBJ_EVENT_GFX_ABRA_TELEPORTING_2)
    release
    delay(30)
    updateobjectsprite(LOCALID_MOUNTAINTOP_ABRA_2, OBJ_EVENT_GFX_SPECIES(ABRA))
    release
    playmoncry(SPECIES_ABRA, CRY_MODE_NORMAL)
    applymovement(LOCALID_MOUNTAINTOP_SERGIO, moves(walk_fast_down, walk_fast_right, walk_fast_down, face_left))
    applymovement(LOCALID_PLAYER, moves(walk_fast_down * 2, walk_fast_left, walk_fast_down, face_right))
    waitmovement(LOCALID_PLAYER)
    turnobject(LOCALID_MOUNTAINTOP_ABRA_2, DIR_EAST)
    delay(20)
    call(WahRoomsShared_SetPlayerTeleportGfxVars)
    playse(SE_WARP_IN)
    updateobjectsprite(LOCALID_MOUNTAINTOP_ABRA_2, OBJ_EVENT_GFX_ABRA_TELEPORTING_2)
    call(WahRoomsShared_UpdatePlayerSpriteTeleporting2)
    updateobjectsprite(LOCALID_MOUNTAINTOP_SERGIO, OBJ_EVENT_GFX_SERGIO_TELEPORTING_2)
    release
    delay(30)
    updateobjectsprite(LOCALID_MOUNTAINTOP_ABRA_2, OBJ_EVENT_GFX_ABRA_TELEPORTING_1)
    call(WahRoomsShared_UpdatePlayerSpriteTeleporting1)
    updateobjectsprite(LOCALID_MOUNTAINTOP_SERGIO, OBJ_EVENT_GFX_SERGIO_TELEPORTING_1)
    release
    delay(20)
    setflag(FLAG_DEFEATED_ADMIN_SERGIO)
    setvar(VAR_SERGIO_ROOM_STATE, 2)
    warpsilent(MAP_SERGIO_ROOM, WARP_ID_SERGIO_ROOM_ABRA)
	waitstate
	releaseall
    end
}

script DragonMountan_Top_EventScript_SergioBattle {
    if (!flag(FLAG_WAH_CHALLENGE_COMPLETED)) {
        trainerbattle_no_intro(TRAINER_WAH_ADMIN_SERGIO_MAIN, DragonMountan_Top_Text_SergioDefeated)
    } else {
        setvar(VAR_0x8004, TEAM_INDEX_SERGIO)
        special(ShouldUseAlternativeTeam)
        if (var(VAR_RESULT) == 0) {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_SERGIO_MAIN, DragonMountan_Top_Text_SergioDefeated)
        } else {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_SERGIO_ALTERNATIVE, DragonMountan_Top_Text_SergioDefeated)
        }
    }
    return
}

text DragonMountan_Top_Text_SergioDefeated {
    format("Wow! That was brutal!")
}


script DragonMountan_Top_EventScript_WalkInPlaceSergioFacingPlayer {
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    switch(var(VAR_RESULT)) {
        case DIR_NORTH:
            applymovementandwait(LOCALID_MOUNTAINTOP_SERGIO, Common_Movement_WalkInPlaceDown)
            break
        case DIR_SOUTH:
            applymovementandwait(LOCALID_MOUNTAINTOP_SERGIO, Common_Movement_WalkInPlaceUp)
            break
        case DIR_WEST:
            applymovementandwait(LOCALID_MOUNTAINTOP_SERGIO,Common_Movement_WalkInPlaceRight)
            break
        case DIR_EAST:
            applymovementandwait(LOCALID_MOUNTAINTOP_SERGIO, Common_Movement_WalkInPlaceLeft)
            break
    }
    return
}
