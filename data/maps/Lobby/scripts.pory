        addvar(VAR_0x8000, 1)
    }
    getseenmon(SPECIES_MAGIKEN)
    if(var(VAR_RESULT) != 0) {
        bufferspeciesname(STR_VAR_1, SPECIES_MAGIKEN)
        dynmultipush(gStringVar1, 4)
        addvar(VAR_0x8000, 1)
    }
    getseenmon(SPECIES_AYEWIRAZ)
    if(var(VAR_RESULT) != 0) {
        bufferspeciesname(STR_VAR_1, SPECIES_AYEWIRAZ)
