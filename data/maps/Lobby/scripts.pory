const VAR_TEMP_0_ASKED_BETA_QUESTIONS_THIS_TALK = VAR_TEMP_0
const VAR_TEMP_1_COPE_TRIGGER = VAR_TEMP_1

mapscripts Lobby_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Lobby_OnTransition
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_EXPLAIN_NEW_CHALLENGE_MODES_LOBBY, 1: Lobby_OnFrame_ExplainNewChallengeModes
    ]
}

script Lobby_OnFrame_ExplainNewChallengeModes {
    applymovementandwait(LOCALID_LOBBY_COPE, moves(walk_down * 4, face_right))
    turnobject(LOCALID_PLAYER, DIR_WEST)
    msgbox(format("Incredible, {PLAYER}! You've beaten the challenge completely."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
    playse(SE_PIN)
    applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_HeartWithDelay48)
    msgbox(format("But don't think this is over!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_JumpInPlaceRight)
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_JumpInPlaceRight)
    msgbox(format("You've still got plenty left to do!\pFrom now on you've unlocked new ways to play the challenge."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
    applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_WalkInPlaceRight)
    msgbox(format("Now you can battle in {COLOR BLUE}Double Battle{COLOR DARK_GRAY} mode!\pEvery battle will be a double: two Pokémon out, double the chaos!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_JumpInPlaceRight)
    msgbox(format("Want to think a bit harder? Then {COLOR RED}Inverse Battles{COLOR DARK_GRAY} are for you!\pThe type chart is flipped! What's resistant becomes weak, and vice versa.\pYou can no longer battle in auto mode!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
    playse(SE_PIN)
    applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_SmileWithDelay48)
    msgbox(format("And that's not all!\pNo matter which mode you pick, each admin will have two possible teams to use.\pTheir {COLOR BLUE}main team{COLOR DARK_GRAY}, which you know, or an {COLOR RED}alternate team{COLOR DARK_GRAY}.\pYou'll never know which you'll face, which means each run could feel completely different."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
    turnobject(LOCALID_LOBBY_COPE, DIR_WEST)
    playse(SE_PIN)
    applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_ThinkingWithDelay48)
    delay(40)
    applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_WalkInPlaceRight)
    msgbox(format("I almost forgot!\pYou can also explore the {COLOR BLUE}Creative Zone{COLOR DARK_GRAY}.\pSeveral of the challenge's creators are eager to take you on!\pAnd if you want 100% completion, there are still many {COLOR BLUE}achievements{COLOR DARK_GRAY} to earn.\pWith everything left to do, you're sure to have a blast!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
    playse(SE_PIN)
    applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_HappyWithDelay48)
    applymovementandwait(LOCALID_LOBBY_COPE, moves(walk_up * 4, face_down))
    setvar(VAR_EXPLAIN_NEW_CHALLENGE_MODES_LOBBY, 2)
    end
}

script Lobby_OnTransition {
    setrespawn(HEAL_LOCATION_LOBBY)
    end
}

script Lobby_EventScript_StartChallenge {
    lock
    applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_FacePlayer)
    playse(SE_PIN)
    applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_DoubleExclamationMarkWithDelay48)
    msgbox(format("Hi {PLAYER}!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
    turnobject(LOCALID_PLAYER, DIR_WEST)
    delay(20)
    applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_WalkInPlaceRight)
    if (!flag(FLAG_WAH_CHALLENGE_COMPLETED)) {
        msgbox(format("So you're ready to take on the challenge?"), MSGBOX_YESNO, speaker = SP_NAME_COPE)
        closemessage
        delay(10)
        if (var(VAR_RESULT) == YES) {
            setvar(VAR_WAH_CHALLENGE_MODE, VAR_VALUE_WAH_CHALLENGE_MODE_STANDARD)
            applymovementandwait(LOCALID_PLAYER, Common_Movement_WalkInPlaceLeft)
            msgbox(format("Excellent! Go ahead - I wish you lots of luck and, above all, have fun!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
            goto(Lobby_StartChallenge_EnterOmegaRoom)
        } else {
            goto(Lobby_StartChallenge_CancelledChallenge)
        }
    }
    setspeaker(SP_NAME_COPE)
    message(format("How do you want to take on the challenge?"))
    waitmessage
    dynmultipush(format("Standard"), 0)
    dynmultipush(format("Double Battles"), 1)
    dynmultipush(format("Inverse Battles"), 2)
    dynmultipush(format("Exit"), 4)
    dynmultistack(0, 0, FALSE, 4, 0, 0, DYN_MULTICHOICE_CB_NONE)
    closemessage
    delay(10)
    switch(var(VAR_RESULT)) {
        case 0:
            setvar(VAR_WAH_CHALLENGE_MODE, VAR_VALUE_WAH_CHALLENGE_MODE_STANDARD)
            applymovementandwait(LOCALID_PLAYER, Common_Movement_WalkInPlaceLeft)
            msgbox(format("Excellent! Go ahead - I wish you lots of luck and, above all, have fun!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
            goto(Lobby_StartChallenge_EnterOmegaRoom)
        case 1:
            setvar(VAR_WAH_CHALLENGE_MODE, VAR_VALUE_WAH_CHALLENGE_MODE_DOUBLE)
            applymovementandwait(LOCALID_PLAYER, Common_Movement_WalkInPlaceLeft)
            setflag(FLAG_FORCE_DOUBLE_BATTLE)
            msgbox(format("Excellent! The challenge will be in Double Battle mode.\pGo ahead, I wish you lots of luck and, above all, have fun!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
            goto(Lobby_StartChallenge_EnterOmegaRoom)
        case 2:
            setvar(VAR_WAH_CHALLENGE_MODE, VAR_VALUE_WAH_CHALLENGE_MODE_INVERSE)
            applymovementandwait(LOCALID_PLAYER, Common_Movement_WalkInPlaceLeft)
            setflag(FLAG_INVERSE_BATTLE)
            msgbox(format("Excellent! The challenge will be in Inverse Battle mode.\pType effectiveness is inverted: what's normally super effective becomes not very effective, and vice versa.\pGo ahead, I wish you lots of luck and, above all, have fun!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
            goto(Lobby_StartChallenge_EnterOmegaRoom)
        default:
            goto(Lobby_StartChallenge_CancelledChallenge)
    }
}

script Lobby_StartChallenge_CancelledChallenge {
    playse(SE_PIN)
    applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_Surprise)
    msgbox(format("So you don't feel ready?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
    delay(60)
    msgbox(format("Remember, the people in the waiting room can help with your preparation."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
    applymovementandwait(LOCALID_PLAYER, Common_Movement_WalkDown)
    turnobject(LOCALID_LOBBY_COPE, DIR_SOUTH)
    release
    end
}

script Lobby_StartChallenge_EnterOmegaRoom {
    special(SetWahChallengeInitialAchievementFlags)
    call(WahRoomsShared_Kecleon_ResetFlags)
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    call(Lobby_EventScript_OpenDoor)
    applymovementandwait(LOCALID_PLAYER, Common_Movement_WalkUp2)
    hideobjectat(LOCALID_PLAYER, MAP_LOBBY)
    warp(MAP_OMEGA_ROOM, WARP_ID_OMEGA_ROOM_INITIAL)
    waitstate
    release
    end
}


script Lobby_EventScript_OpenDoor {
    applymovementandwait(LOCALID_PLAYER, Common_Movement_Delay32)
	playse(SE_DOOR)
	setmetatile(7, 2, METATILE_RoomGeneral_Door_Opening1, FALSE)
	special(DrawWholeMapView)
	delay(5)
	setmetatile(7, 2, METATILE_RoomGeneral_Door_Opening2, FALSE)
    special(DrawWholeMapView)
	delay(5)
    setmetatile(7, 2, METATILE_RoomGeneral_Door_Open, FALSE)
    special(DrawWholeMapView)
	return
}


script Lobby_EventScript_TeamSelector {
    lock
    faceplayer
    msgbox(format("Hi! I'm in charge of team selection for the challenge.\pYour current team is good, but I think you can get a better one.\pWant to choose another team?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES) {
        special(OpenTeamSelectorFromField)
        waitstate
        if(var(VAR_RESULT) == TRUE) {
            msgbox( format("Excellent choice! Now that's a winning team.\pGo for glory!"), MSGBOX_AUTOCLOSE)
        } else {
            msgbox(Lobby_Text_TeamSelector_TeamSelectionCancelled, MSGBOX_AUTOCLOSE)
        }
    } else {
        msgbox(Lobby_Text_TeamSelector_TeamSelectionCancelled, MSGBOX_AUTOCLOSE)
    }
    turnobject(VAR_LAST_TALKED, DIR_SOUTH)
    release
    end
}


text Lobby_Text_TeamSelector_TeamSelectionCancelled {
    "Well, well! A brave kid, huh?\nSo you think you'll win with THAT team...\pGood luck - you're gonna need it!"
}


script Lobby_EventScript_DifficultySelector {
    lock
    faceplayer
    msgbox(format("Hi! I'm in charge of difficulty selection for the challenge.\pThe current difficulty doesn't seem right for you.\pWant to change the difficulty level?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES) {
        special(OpenDifficultySelectorFromField)
        waitstate
        if(var(VAR_RESULT) == TRUE) {
            msgbox("Done! The difficulty's been updated.\nGood luck with the challenge!", MSGBOX_AUTOCLOSE)
        } else {
            msgbox(Lobby_Text_DifficultySelector_Cancelled, MSGBOX_AUTOCLOSE)
        }
    } else {
        msgbox(Lobby_Text_DifficultySelector_Cancelled, MSGBOX_AUTOCLOSE)
    }
    turnobject(VAR_LAST_TALKED, DIR_SOUTH)
    release
    end
}

text Lobby_Text_DifficultySelector_Cancelled {
    format("Got it! If you change your mind, I'll be around.")
}


script Lobby_EventScript_BufferVictoryWordFromCountVar {
    if(var(VAR_0x8004) == 0) {
        bufferstring(STR_VAR_1, "0")
    } else {
        buffernumberstring(STR_VAR_1, VAR_0x8004)
    }
    if(var(VAR_0x8004) == 1) {
        bufferstring(STR_VAR_2, "win")
    } else {
        bufferstring(STR_VAR_2, "wins")
    }
    return
}

script Lobby_EventScript_BufferTimeWordFromCountVar {
    if(var(VAR_0x8004) == 0) {
        bufferstring(STR_VAR_1, "0")
    } else {
        buffernumberstring(STR_VAR_1, VAR_0x8004)
    }
    if(var(VAR_0x8004) == 1) {
        bufferstring(STR_VAR_2, "time")
    } else {
        bufferstring(STR_VAR_2, "times")
    }
    return
}

script Lobby_EventScript_ChallengeHistorian {
    lock
    faceplayer
    
    msgbox(format("Hey, {PLAYER}!\pI don't work here or anything, but I love crunching stats.\pI hang out in the waiting room watching everyone who comes in, and I note it all down."), MSGBOX_AUTOCLOSE)
    turnobject(VAR_LAST_TALKED, DIR_NORTH)
    if(!flag(FLAG_WAH_CHALLENGE_COMPLETED)) {
        playse(SE_PIN)
        applymovementandwait(VAR_LAST_TALKED, Common_Movement_SurpriseWithDelay48)
        faceplayer
        msgbox(format("I see you haven't completed the challenge even once.\pYou haven't earned a spot in my notes yet."), MSGBOX_AUTOCLOSE)
        playse(SE_PIN)
        applymovementandwait(VAR_LAST_TALKED, Common_Movement_SadWithDelay48)
        turnobject(VAR_LAST_TALKED, DIR_NORTH)
        release
        end
    }
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_ThinkingWithDelay48)
    faceplayer
    copyvar(VAR_0x8004, VAR_WAH_CHALLENGE_STANDARD_COMPLETION_COUNT)
    call(Lobby_EventScript_BufferVictoryWordFromCountVar)
    msgbox(format("According to my notebook, in standard mode you have {STR_VAR_1} {STR_VAR_2}.\pNot bad at all, really!"))
    copyvar(VAR_0x8004, VAR_WAH_CHALLENGE_DOUBLE_COMPLETION_COUNT)
    call(Lobby_EventScript_BufferVictoryWordFromCountVar)
    msgbox(format("In double battles you have {STR_VAR_1} {STR_VAR_2}.\pThat's where you see who thinks two turns ahead."))
    copyvar(VAR_0x8004, VAR_WAH_CHALLENGE_INVERSE_COMPLETION_COUNT)
    call(Lobby_EventScript_BufferVictoryWordFromCountVar)
    msgbox(format("And in inverse battles you've racked up {STR_VAR_1} {STR_VAR_2}.\pThat mode turns anyone's head inside out."))
    copyvar(VAR_0x8004, VAR_WAH_CHALLENGE_COMPLETION_COUNT)
    call(Lobby_EventScript_BufferTimeWordFromCountVar)
    msgbox(format("In total, you've completed the challenge {STR_VAR_1} {STR_VAR_2}."))
    if(var(VAR_WAH_CHALLENGE_COMPLETION_COUNT) > 5) {
        msgbox(format("If you keep this up, I'll have to buy another notebook to record your numbers!"), MSGBOX_AUTOCLOSE)
        playse(SE_PIN)
        applymovementandwait(VAR_LAST_TALKED, Common_Movement_SweatDropWithDelay48)
    }
    else {
        msgbox(format("Not that many wins yet, but keep it up."), MSGBOX_AUTOCLOSE)
        playse(SE_PIN)
        applymovementandwait(VAR_LAST_TALKED, Common_Movement_SmileWithDelay48)
    }
    turnobject(VAR_LAST_TALKED, DIR_NORTH)
    release
    end
}


script Lobby_EventScript_Shop {
	lock
    faceplayer
    if (flag(FLAG_WAH_CHALLENGE_COMPLETED) && !flag(FLAG_WAH_MART_COMBAT_ITEMS_ANNOUNCEMENT_SEEN)) {
        message(format("Hi! We've expanded the catalog!\pNow you can also buy battle items.\pHow can I help you?"))
        waitmessage
        setflag(FLAG_WAH_MART_COMBAT_ITEMS_ANNOUNCEMENT_SEEN)
    }else {
        message(format("Hi! How can I help you?"))
	    waitmessage
    }
	call(WahRoomsShared_EventScript_Shop)
	release
    end
}

script Lobby_EventScript_Roxas_IntroFirstBattle {
    checkplayergender
    if(var(VAR_RESULT) == MALE) {
        msgbox(format("Well, look at you! The new champ! Congrats, man!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
    } else {
        msgbox(format("Well, look at you! The new champ! Congrats, girl!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
    }
    playse(SE_LEDGE)
    applymovementandwait(VAR_LAST_TALKED, moves(lock_facing_direction, jump_in_place_down))
    playse(SE_LEDGE)
    applymovementandwait(VAR_LAST_TALKED, moves(jump_in_place_down, unlock_facing_direction, face_player, delay_16 * 2))
    msgbox(format("I see you gave it to those traitors in the rooms… Glad someone finally knocked 'em down a peg."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_HappyWithDelay48)
    delay(20)
    msgbox(format("Remember what I told you last time?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_QuestionMarkWithDelay48)
    msgbox(format("I finished my research in the Suzuka Archipelago… it's a long story, you should've seen it…\pYou have no idea… But I picked up the trail of that force that was causing so much trouble, and I'm ready to test if this thing's really as legendary as the archipelago's chronicles claim."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
    call(Lobby_EventScript_WalkInPlaceLastTalkedFacingPlayer)
    delay(20)
    call(Lobby_EventScript_Roxas_ExplainPartyLimit)
    return
}

script Lobby_EventScript_Roxas_IntroRematch {
    msgbox(format("Hey, you again! Want to battle my legendary again?"), MSGBOX_YESNO, speaker = SP_NAME_ROXAS)
    closemessage
    delay(20)
    if(var(VAR_RESULT) == YES) {
        call(Lobby_EventScript_Roxas_ExplainPartyLimit)
        return
    } else {
        msgbox(Lobby_Text_Roxas_PlayerCancelled, MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
        release
        end
    }
}

script Lobby_EventScript_Roxas_ExplainPartyLimit {
    switch(var(VAR_DIFFICULTY)) {
        case DIFFICULTY_EASY:
            msgbox(format("Let's make it interesting: pick three of your critters.\pI'll send out my legendary, so you'd better choose well."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
            break
        case DIFFICULTY_NORMAL:
            msgbox(format("Let's make it interesting: pick three of your critters.\pI'll send out my legendary, so you'd better choose well."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
            break
        default:
            msgbox(format("Let's make it interesting: a one-on-one.\pPick your best critter and get ready to face my legendary."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
            break
    }
    return
}

script Lobby_EventScript_Roxas_SelectPlayerMons {
    setvar(VAR_FRONTIER_FACILITY, FRONTIER_FACILITY_TOWER)
    setvar(VAR_0x8004, FRONTIER_LVL_OPEN)
    fadescreen(FADE_TO_BLACK)
    special(ChoosePartyForBattleFrontier)
    waitstate
    lock
    if (var(VAR_RESULT) == 0) {
        special(LoadPlayerParty)
        msgbox(Lobby_Text_Roxas_PlayerCancelled, MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
        release
        end
    }
    special(ReducePlayerPartyToSelectedMons)
    return
}

script Lobby_EventScript_Roxas {
    lock
    faceplayer
    if(flag(FLAG_WAH_CHALLENGE_COMPLETED) == TRUE){
        playse(SE_PIN)
        applymovementandwait(VAR_LAST_TALKED, Common_Movement_DoubleExclamationMarkWithDelay48)
        if(flag(FLAG_DEFEATED_LOBBY_ROXAS)) {
            call(Lobby_EventScript_Roxas_IntroRematch)
        } else {
            call(Lobby_EventScript_Roxas_IntroFirstBattle)
        }
        special(SavePlayerParty)
        switch(var(VAR_DIFFICULTY)) {
            case DIFFICULTY_EASY:
                setvar(VAR_0x8005, 3)
                call(Lobby_EventScript_Roxas_SelectPlayerMons)
                break
            case DIFFICULTY_NORMAL:
                setvar(VAR_0x8005, 3)
                call(Lobby_EventScript_Roxas_SelectPlayerMons)
                break
            default:
                setvar(VAR_0x8005, 1)
                call(Lobby_EventScript_Roxas_SelectPlayerMons)
                break
        }
        msgbox(format("Let's see if you can handle it!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
        setflag(B_FLAG_NO_WHITEOUT)
        trainerbattle_no_intro(TRAINER_WAH_ADMIN_ROXAS, format("Nooooo!"))
        clearflag(B_FLAG_NO_WHITEOUT)
        special(GetBattleOutcome)
        special(LoadPlayerParty)
        if (var(VAR_RESULT) == B_OUTCOME_WON) {
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_X)
            msgbox(format("Noo, you've gotta be kidding! Not even the power of this dark Pokémon could beat you.\pNow I get why they let you into the rooms and tossed me out on my ear.\pYou've got something special, champ material - not just brute force.\pHonestly, you shut me up. Well earned."), MSGBOX_AUTOCLOSE)
            delay(40)
            setflag(FLAG_DEFEATED_LOBBY_ROXAS)
        } else {
            checkplayergender
            if(var(VAR_RESULT) == MALE) {
                msgbox(format("Man, just like I figured… The power of this thing is out of this world; not even you, the champ, could take it."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
            } else {
                msgbox(format("Man, just like I figured… The power of this thing is out of this world; not even you, the champ, could take it."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
            }
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_SweatDropWithDelay48)
            msgbox(format("If you ever swing by the Suzuka Archipelago, watch yourself, ace, 'cause out there this one won't cut you any slack.\pBetter luck next time."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
        }
        call(Achievements_EventScript_Eval_DefeatAllAdmins)
        call(WahRoomsShared_EventScript_AfterBattle)
        release
        end
    } else {
        msgbox(format("Don't bother asking… They won't let me through either…"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
        playse(SE_PIN)
        applymovementandwait(VAR_LAST_TALKED, Common_Movement_AnnoyedWithDelay48)
        delay(20)
        msgbox(format("They say being a WAH Leader in the Suzuka Archipelago for just two weeks isn't “enough of a track record” to take part."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
        delay(20)
        playse(SE_PIN)
        applymovementandwait(VAR_LAST_TALKED, Common_Movement_Angry)
        playse(SE_LEDGE)
        applymovementandwait(VAR_LAST_TALKED, moves(lock_facing_direction, jump_in_place_down))
        playse(SE_LEDGE)
        applymovementandwait(VAR_LAST_TALKED, moves(jump_in_place_down, unlock_facing_direction, face_player, delay_16 * 2))
        msgbox(format("The nerve of these guys, man!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
        lock
        delay(20)
        msgbox(format("But hey, I'm not gonna sit here crying about it.\pI'm after a ship that vanished west of the Orange Islands, the Suzuka Archipelago.\pTeam Rocket's up to its old tricks, and they say there's a dark creature with red eyes that's dangerous… sounds terrifying…\pI gotta investigate and see what's up…"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
        call(Lobby_EventScript_WalkInPlaceLastTalkedFacingPlayer)
        msgbox(format("Hey, sorry, I'd better get back to my research.\pGood luck, I hope they actually give you the time of day!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
        release
        end
    }
}



text Lobby_Text_Roxas_PlayerCancelled {
    format("So you're scared of my legendary critter? And yet you won the rooms!")
}

script Lobby_EventScript_WalkInPlaceLastTalkedFacingPlayer {
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    switch(var(VAR_RESULT)) {
        case DIR_NORTH:
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_WalkInPlaceDown)
            break
        case DIR_SOUTH:
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_WalkInPlaceUp)
            break
        case DIR_WEST:
            applymovementandwait(VAR_LAST_TALKED,Common_Movement_WalkInPlaceRight)
            break
        case DIR_EAST:
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_WalkInPlaceLeft)
            break
    }
    return
}


script Lobby_EventScript_FakemonDexMenu {
    lock
    faceplayer
    msgbox(format("I'm the expert on the species exclusive to Whack a Hack.\pI'll tell you all about them, but only the ones you've seen.\pI don't want to spoil the surprise!"), MSGBOX_AUTOCLOSE)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_SweatDropWithDelay48)
    goto(Lobby_EventScript_FakemonDexMenu_ChooseSpecies)
}

script Lobby_EventScript_FakemonDexMenu_ChooseSpecies {
    setvar(VAR_0x8000, 0)
    getseenmon(SPECIES_KAOSUNE)
    if(var(VAR_RESULT) != 0) {
        bufferspeciesname(STR_VAR_1, SPECIES_KAOSUNE)
        dynmultipush(gStringVar1, 0)
        addvar(VAR_0x8000, 1)
    }
    getseenmon(SPECIES_FREECH)
    if(var(VAR_RESULT) != 0) {
        bufferspeciesname(STR_VAR_1, SPECIES_FREECH)
        dynmultipush(gStringVar1, 1)
        addvar(VAR_0x8000, 1)
    }
    getseenmon(SPECIES_PLUGOINK)
    if(var(VAR_RESULT) != 0) {
        bufferspeciesname(STR_VAR_1, SPECIES_PLUGOINK)
        dynmultipush(gStringVar1, 2)
        addvar(VAR_0x8000, 1)
    }
    getseenmon(SPECIES_GRITESPEC)
    if(var(VAR_RESULT) != 0) {
        bufferspeciesname(STR_VAR_1, SPECIES_GRITESPEC)
