    if(var(VAR_RESULT) == 2) {
        setflag(FLAG_POKEBOX_UNLOCK_BETA_MADAAMU)
        msgbox(format("Exacto. Ese filo también despertó la curiosidad de Madaamu."), MSGBOX_AUTOCLOSE)
        call(Pokebox_EventScript_ShowUnlocks)
    } else {
        msgbox(Lobby_Text_FailedToUnlock, MSGBOX_AUTOCLOSE)
    }
    return
}

script Lobby_EventScript_BetaMonQuestionnaire_Akueria {
    message(format("Adivina, adivinanza.\p¿Qué serpiente azul tiene una evolución naranja?"))
    waitmessage
    dynmultipush(format("Gyarados"), 0)
    dynmultipush(format("Dratini"), 1)
    dynmultipush(format("Milotic"), 2)
    dynmultipush(format("Dunsparce"), 3)
    dynmultistack(0, 0, TRUE, 4, 0, 0, DYN_MULTICHOICE_CB_NONE)
    closemessage
    if(var(VAR_RESULT) == 1) {
        setflag(FLAG_POKEBOX_UNLOCK_BETA_AKUERIA)
        msgbox(format("Pues su primo te ha visto luchar y te espera."), MSGBOX_AUTOCLOSE)
        call(Pokebox_EventScript_ShowUnlocks)
    } else {
        msgbox(Lobby_Text_FailedToUnlock, MSGBOX_AUTOCLOSE)
    }
    return
