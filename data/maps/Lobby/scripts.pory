mapscripts Lobby_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Lobby_OnTransition
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_EXPLAIN_NEW_CHALLENGE_MODES_LOBBY, 1: Lobby_OnFrame_ExplainNewChallengeModes
    ]
}

script Lobby_OnFrame_ExplainNewChallengeModes {
    applymovementandwait(LOCALID_LOBBY_COPE, moves(walk_down * 4, face_right))
    turnobject(LOCALID_PLAYER, DIR_WEST)
    msgbox(format("¡Increíble, {PLAYER}! Has superado el desafío por completo."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
    playse(SE_PIN)
    applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_HeartWithDelay48)
    msgbox(format("¡Pero no creas que esto ha terminado!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_JumpInPlaceRight)
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_JumpInPlaceRight)
    msgbox(format("¡Todavía tienes muchas cosas por hacer!\pA partir de ahora has desbloqueado nuevas formas de jugar el desafío."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
    applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_WalkInPlaceRight)
    msgbox(format("¡Ahora puedes combatir en modalidad {COLOR BLUE}batallas dobles{COLOR DARK_GRAY}!\pCada combate será en formato doble: dos Pokémon en campo, ¡el doble de caos!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_JumpInPlaceRight)
    msgbox(format("¿Y si quieres pensar un poco más? Entonces las {COLOR RED}batallas inversas{COLOR DARK_GRAY} son para ti!\p¡La tabla de tipos está al revés! Lo resistente será débil, y viceversa.\p¡Ya no podrás combatir en modo automático!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
    playse(SE_PIN)
    applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_SmileWithDelay48)
    msgbox(format("¡Y eso no es todo!\pSin importar la modalidad que elijas, cada administrador tendrá dos equipos posibles para utilizar.\pSu {COLOR BLUE}equipo principal{COLOR DARK_GRAY}, que ya conoces, o un {COLOR RED}equipo alternativo{COLOR DARK_GRAY}.\pNunca sabrás cuál te podrá tocar, lo que significa que cada recorrido podría sentirse completamente diferente."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
    turnobject(LOCALID_LOBBY_COPE, DIR_WEST)
    playse(SE_PIN)
    applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_ThinkingWithDelay48)
    delay(40)
    applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_WalkInPlaceRight)
    msgbox(format("¡Casi lo olvidaba!\pTambién puedes explorar la {COLOR BLUE}Zona creativa{COLOR DARK_GRAY}.\p¡Varios de los creadores del desafío están ansiosos por enfrentarte!\pY si buscas completar todo al 100%, aún quedan muchos {COLOR BLUE}logros{COLOR DARK_GRAY} por conseguir.\pCon todo lo que te queda por hacer, ¡seguro te vas a divertir mucho!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
    playse(SE_PIN)
    applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_HappyWithDelay48)
    applymovementandwait(LOCALID_LOBBY_COPE, moves(walk_up * 4, face_down))
    setvar(VAR_EXPLAIN_NEW_CHALLENGE_MODES_LOBBY, 2)
    end
}

script Lobby_OnTransition {
    setrespawn(HEAL_LOCATION_LOBBY)
    end
}

script Lobby_EventScript_StartChallenge {
    lock
    applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_FacePlayer)
    playse(SE_PIN)
    applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_DoubleExclamationMarkWithDelay48)
    msgbox(format("¡Hola {PLAYER}!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
    turnobject(LOCALID_PLAYER, DIR_WEST)
    delay(20)
    applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_WalkInPlaceRight)
    if (!flag(FLAG_WAH_CHALLENGE_COMPLETED)) {
        msgbox(format("¿Así que ya estás list{OA} para intentar el desafío?"), MSGBOX_YESNO, speaker = SP_NAME_COPE)
        closemessage
        delay(10)
        if (var(VAR_RESULT) == YES) {
            setvar(VAR_WAH_CHALLENGE_MODE, VAR_VALUE_WAH_CHALLENGE_MODE_STANDARD)
            applymovementandwait(LOCALID_PLAYER, Common_Movement_WalkInPlaceLeft)
            msgbox(format("¡Excelente! Adelante, ¡te deseo mucha suerte y sobre todo que te diviertas!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
            goto(Lobby_StartChallenge_EnterOmegaRoom)
        } else {
            goto(Lobby_StartChallenge_CancelledChallenge)
        }
    }
    setspeaker(SP_NAME_COPE)
    message(format("¿En qué modo quieres afrontar el desafío?"))
    waitmessage
    dynmultipush(format("Estándar"), 0)
    dynmultipush(format("Batallas dobles"), 1)
    dynmultipush(format("Batallas inversas"), 2)
    dynmultipush(format("Salir"), 4)
    dynmultistack(0, 0, FALSE, 4, 0, 0, DYN_MULTICHOICE_CB_NONE)
    closemessage
    delay(10)
    switch(var(VAR_RESULT)) {
        case 0:
            setvar(VAR_WAH_CHALLENGE_MODE, VAR_VALUE_WAH_CHALLENGE_MODE_STANDARD)
            applymovementandwait(LOCALID_PLAYER, Common_Movement_WalkInPlaceLeft)
            msgbox(format("¡Excelente! Adelante, ¡te deseo mucha suerte y sobre todo que te diviertas!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
            goto(Lobby_StartChallenge_EnterOmegaRoom)
        case 1:
            setvar(VAR_WAH_CHALLENGE_MODE, VAR_VALUE_WAH_CHALLENGE_MODE_DOUBLE)
            applymovementandwait(LOCALID_PLAYER, Common_Movement_WalkInPlaceLeft)
            setflag(FLAG_FORCE_DOUBLE_BATTLE)
            msgbox(format("¡Excelente! El desafío será en modo batallas dobles.\p¡Adelante, te deseo mucha suerte y sobre todo que te diviertas!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
            goto(Lobby_StartChallenge_EnterOmegaRoom)
        case 2:
            setvar(VAR_WAH_CHALLENGE_MODE, VAR_VALUE_WAH_CHALLENGE_MODE_INVERSE)
            applymovementandwait(LOCALID_PLAYER, Common_Movement_WalkInPlaceLeft)
            setflag(FLAG_INVERSE_BATTLE)
            msgbox(format("¡Excelente! El desafío será en modo batallas inversas.\pLas efectividades de tipo se invierten: lo que normalmente es súper efectivo será poco efectivo y viceversa.\p¡Adelante, te deseo mucha suerte y sobre todo que te diviertas!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
            goto(Lobby_StartChallenge_EnterOmegaRoom)
        default:
            goto(Lobby_StartChallenge_CancelledChallenge)
    }
}

script Lobby_StartChallenge_CancelledChallenge {
    playse(SE_PIN)
    applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_Surprise)
    msgbox(format("¿Así que no te sientes list{OA}?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
    delay(60)
    msgbox(format("Recuerda que las personas de la sala de espera pueden ayudar en tu preparación."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
    applymovementandwait(LOCALID_PLAYER, Common_Movement_WalkDown)
    turnobject(LOCALID_LOBBY_COPE, DIR_SOUTH)
    release
    end
}

script Lobby_StartChallenge_EnterOmegaRoom {
    special(SetWahChallengeInitialAchievementFlags)
    call(WahRoomsShared_Kecleon_ResetFlags)
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    call(Lobby_EventScript_OpenDoor)
    applymovementandwait(LOCALID_PLAYER, Common_Movement_WalkUp2)
    hideobjectat(LOCALID_PLAYER, MAP_LOBBY)
    warp(MAP_OMEGA_ROOM, WARP_ID_OMEGA_ROOM_INITIAL)
    waitstate
    release
    end
}


script Lobby_EventScript_OpenDoor {
    applymovementandwait(LOCALID_PLAYER, Common_Movement_Delay32)
	playse(SE_DOOR)
	setmetatile(7, 2, METATILE_RoomGeneral_Door_Opening1, FALSE)
	special(DrawWholeMapView)
	delay(5)
	setmetatile(7, 2, METATILE_RoomGeneral_Door_Opening2, FALSE)
    special(DrawWholeMapView)
	delay(5)
    setmetatile(7, 2, METATILE_RoomGeneral_Door_Open, FALSE)
    special(DrawWholeMapView)
	return
}


script Lobby_EventScript_TeamSelector {
    lock
    faceplayer
    msgbox(format("¡Hola! Soy el encargado de la selección de equipos para el desafío.\pVeo que tu equipo actual es bueno, pero creo que puedes conseguir uno mejor.\p¿Quieres elegir otro equipo?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES) {
        special(OpenTeamSelectorFromField)
        waitstate
        if(var(VAR_RESULT) == TRUE) {
            msgbox( format("¡Excelente elección! Eso sí es un equipo ganador.\p¡Ve por la gloria!"), MSGBOX_AUTOCLOSE)
        } else {
            msgbox(Lobby_Text_TeamSelector_TeamSelectionCancelled, MSGBOX_AUTOCLOSE)
        }
    } else {
        msgbox(Lobby_Text_TeamSelector_TeamSelectionCancelled, MSGBOX_AUTOCLOSE)
    }
    turnobject(VAR_LAST_TALKED, DIR_SOUTH)
    release
    end
}


text Lobby_Text_TeamSelector_TeamSelectionCancelled {
    "¡Vaya, vaya! Un{A} chic{OA} valiente, ¿eh?\nAsí que piensas ganar con ESE equipo…\p¡Buena suerte, la vas a necesitar!"
}


script Lobby_EventScript_DifficultySelector {
    lock
    faceplayer
    msgbox(format("¡Hola! Soy la encargada de la selección de dificultad del desafío.\pNo parece que la dificultad actual sea la adecuada para ti.\p¿Quieres cambiar el nivel de dificultad?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES) {
        special(OpenDifficultySelectorFromField)
        waitstate
        if(var(VAR_RESULT) == TRUE) {
            msgbox("¡Listo! La dificultad ha sido actualizada.\n¡Buena suerte con el desafío!", MSGBOX_AUTOCLOSE)
        } else {
            msgbox(Lobby_Text_DifficultySelector_Cancelled, MSGBOX_AUTOCLOSE)
        }
    } else {
        msgbox(Lobby_Text_DifficultySelector_Cancelled, MSGBOX_AUTOCLOSE)
    }
    turnobject(VAR_LAST_TALKED, DIR_SOUTH)
    release
    end
}

text Lobby_Text_DifficultySelector_Cancelled {
    format("¡Entendido! Si cambias de opinión, estaré por aquí.")
}


script Lobby_EventScript_BufferVictoryWordFromCountVar {
    if(var(VAR_0x8004) == 0) {
        bufferstring(STR_VAR_1, "0")
    } else {
        buffernumberstring(STR_VAR_1, VAR_0x8004)
    }
    if(var(VAR_0x8004) == 1) {
        bufferstring(STR_VAR_2, "victoria")
    } else {
        bufferstring(STR_VAR_2, "victorias")
    }
    return
}

script Lobby_EventScript_BufferTimeWordFromCountVar {
    if(var(VAR_0x8004) == 0) {
        bufferstring(STR_VAR_1, "0")
    } else {
        buffernumberstring(STR_VAR_1, VAR_0x8004)
    }
    if(var(VAR_0x8004) == 1) {
        bufferstring(STR_VAR_2, "vez")
    } else {
        bufferstring(STR_VAR_2, "veces")
    }
    return
}

script Lobby_EventScript_ChallengeHistorian {
    lock
    faceplayer
    
    msgbox(format("¡Ey, {PLAYER}!\pNo trabajo aquí ni nada, pero me encanta sacar estadísticas.\pMe quedo en la sala de espera observando a todos los que entran y lo anoto todo."), MSGBOX_AUTOCLOSE)
    turnobject(VAR_LAST_TALKED, DIR_NORTH)
    if(!flag(FLAG_WAH_CHALLENGE_COMPLETED)) {
        playse(SE_PIN)
        applymovementandwait(VAR_LAST_TALKED, Common_Movement_SurpriseWithDelay48)
        faceplayer
        msgbox(format("Veo que aún no has completado el desafío ni una vez.\pTodavía no te has ganado un lugar en mis notas."), MSGBOX_AUTOCLOSE)
        playse(SE_PIN)
        applymovementandwait(VAR_LAST_TALKED, Common_Movement_SadWithDelay48)
        turnobject(VAR_LAST_TALKED, DIR_NORTH)
        release
        end
    }
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_ThinkingWithDelay48)
    faceplayer
    copyvar(VAR_0x8004, VAR_WAH_CHALLENGE_STANDARD_COMPLETION_COUNT)
    call(Lobby_EventScript_BufferVictoryWordFromCountVar)
    msgbox(format("Según mi cuaderno, en modo estándar llevas {STR_VAR_1} {STR_VAR_2}.\p¡Nada mal, de verdad!"))
    copyvar(VAR_0x8004, VAR_WAH_CHALLENGE_DOUBLE_COMPLETION_COUNT)
    call(Lobby_EventScript_BufferVictoryWordFromCountVar)
    msgbox(format("En batallas dobles tienes {STR_VAR_1} {STR_VAR_2}.\pAhí se nota quién piensa dos turnos por adelantado."))
    copyvar(VAR_0x8004, VAR_WAH_CHALLENGE_INVERSE_COMPLETION_COUNT)
    call(Lobby_EventScript_BufferVictoryWordFromCountVar)
    msgbox(format("Y en batallas invertidas sumas {STR_VAR_1} {STR_VAR_2}.\pEse modo le da vuelta la cabeza a cualquiera."))
    copyvar(VAR_0x8004, VAR_WAH_CHALLENGE_COMPLETION_COUNT)
    call(Lobby_EventScript_BufferTimeWordFromCountVar)
    msgbox(format("En total, has completado el desafío {STR_VAR_1} {STR_VAR_2}."))
    if(var(VAR_WAH_CHALLENGE_COMPLETION_COUNT) > 5) {
        msgbox(format("¡Si sigues así, voy a tener que comprar otro cuaderno para registrar tus números!"), MSGBOX_AUTOCLOSE)
        playse(SE_PIN)
        applymovementandwait(VAR_LAST_TALKED, Common_Movement_SweatDropWithDelay48)
    }
    else {
        msgbox(format("Aún no son tantas victorias, pero sigue así."), MSGBOX_AUTOCLOSE)
        playse(SE_PIN)
        applymovementandwait(VAR_LAST_TALKED, Common_Movement_SmileWithDelay48)
    }
    turnobject(VAR_LAST_TALKED, DIR_NORTH)
    release
    end
}


script Lobby_EventScript_Shop {
	lock
    faceplayer
    if (flag(FLAG_WAH_CHALLENGE_COMPLETED) && !flag(FLAG_WAH_MART_COMBAT_ITEMS_ANNOUNCEMENT_SEEN)) {
        message(format("¡Hola! ¡Hemos ampliado el catálogo!\pAhora también puedes comprar objetos de combate.\p¿En qué puedo ayudarte?"))
        waitmessage
        setflag(FLAG_WAH_MART_COMBAT_ITEMS_ANNOUNCEMENT_SEEN)
    }else {
        message(format("¡Hola! ¿En qué puedo ayudarte?"))
	    waitmessage
    }
	call(WahRoomsShared_EventScript_Shop)
	release
    end
}

script Lobby_EventScript_Roxas_IntroFirstBattle {
    checkplayergender
    if(var(VAR_RESULT) == MALE) {
        msgbox(format("¡Apa, mira vos!  ¡El nuevo campeón! ¡Felicidades loco!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
    } else {
        msgbox(format("¡Apa, mira vos! ¡La nueva campeona! ¡Felicidades loca!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
    }
    playse(SE_LEDGE)
    applymovementandwait(VAR_LAST_TALKED, moves(lock_facing_direction, jump_in_place_down))
    playse(SE_LEDGE)
    applymovementandwait(VAR_LAST_TALKED, moves(jump_in_place_down, unlock_facing_direction, face_player, delay_16 * 2))
    msgbox(format("Veo que se la diste a esos traidores de las salas… Me alegra que alguien les bajara los humos."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_HappyWithDelay48)
    delay(20)
    msgbox(format("¿Te acordas de lo que te conté la última vez?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_QuestionMarkWithDelay48)
    msgbox(format("Terminé mi investigación en el Archipiélago Suzuka… es una historia larga, tendrías que haberlo visto…\pNo sabes lo que fue… Pero logré dar con el rastro de esa fuerza que estaba causando tantos males y estoy listo para probar si realmente este bicho es tan legendario como dicen las crónicas del archipiélago."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
    call(Lobby_EventScript_WalkInPlaceLastTalkedFacingPlayer)
    delay(20)
    call(Lobby_EventScript_Roxas_ExplainPartyLimit)
    return
}

script Lobby_EventScript_Roxas_IntroRematch {
    msgbox(format("¡Apa, tú de nuevo! ¿Quieres volver a combatir contra mi legendario?"), MSGBOX_YESNO, speaker = SP_NAME_ROXAS)
    closemessage
    delay(20)
    if(var(VAR_RESULT) == YES) {
        call(Lobby_EventScript_Roxas_ExplainPartyLimit)
        return
    } else {
        msgbox(Lobby_Text_Roxas_PlayerCancelled, MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
        release
        end
    }
}

script Lobby_EventScript_Roxas_ExplainPartyLimit {
    switch(var(VAR_DIFFICULTY)) {
        case DIFFICULTY_EASY:
            msgbox(format("Vamos a hacerlo más interesante: elige a tres de tus bichos.\pYo voy a salir con mi legendario, así que más te vale elegir bien."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
            break
        case DIFFICULTY_NORMAL:
            msgbox(format("Vamos a hacerlo más interesante: elige a tres de tus bichos.\pYo voy a salir con mi legendario, así que más te vale elegir bien."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
            break
        default:
            msgbox(format("Vamos a hacerlo más interesante: un mano a mano.\pElige a tu mejor bicho y prepárate para enfrentar a mi legendario."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
            break
    }
    return
}

script Lobby_EventScript_Roxas_SelectPlayerMons {
    setvar(VAR_FRONTIER_FACILITY, FRONTIER_FACILITY_TOWER)
    setvar(VAR_0x8004, FRONTIER_LVL_OPEN)
    fadescreen(FADE_TO_BLACK)
    special(ChoosePartyForBattleFrontier)
    waitstate
    lock
    if (var(VAR_RESULT) == 0) {
        special(LoadPlayerParty)
        msgbox(Lobby_Text_Roxas_PlayerCancelled, MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
        release
        end
    }
    special(ReducePlayerPartyToSelectedMons)
    return
}

script Lobby_EventScript_Roxas {
    lock
    faceplayer
    if(flag(FLAG_WAH_CHALLENGE_COMPLETED) == TRUE){
        playse(SE_PIN)
        applymovementandwait(VAR_LAST_TALKED, Common_Movement_DoubleExclamationMarkWithDelay48)
        if(flag(FLAG_DEFEATED_LOBBY_ROXAS)) {
            call(Lobby_EventScript_Roxas_IntroRematch)
        } else {
            call(Lobby_EventScript_Roxas_IntroFirstBattle)
        }
        special(SavePlayerParty)
        switch(var(VAR_DIFFICULTY)) {
            case DIFFICULTY_EASY:
                setvar(VAR_0x8005, 3)
                call(Lobby_EventScript_Roxas_SelectPlayerMons)
                break
            case DIFFICULTY_NORMAL:
                setvar(VAR_0x8005, 3)
                call(Lobby_EventScript_Roxas_SelectPlayerMons)
                break
            default:
                setvar(VAR_0x8005, 1)
                call(Lobby_EventScript_Roxas_SelectPlayerMons)
                break
        }
        msgbox(format("¡A ver si te la bancas!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
        setflag(B_FLAG_NO_WHITEOUT)
        trainerbattle_no_intro(TRAINER_WAH_ADMIN_ROXAS, format("¡Nooooo!"))
        clearflag(B_FLAG_NO_WHITEOUT)
        special(GetBattleOutcome)
        special(LoadPlayerParty)
        if (var(VAR_RESULT) == B_OUTCOME_WON) {
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_X)
            msgbox(format("¡Nooo, me estás cargando! Ni con la fuerza de este Pokémon oscuro te pude ganar.\pAhora me cierra por qué a vos te dejaron pasar a las salas y a mí me sacaron de un voleo.\pTenés algo distinto, pasta de campeón, no es solo fuerza bruta.\pLa verdad, me cerraste la boca. Bien ganado."), MSGBOX_AUTOCLOSE)
            delay(40)
            setflag(FLAG_DEFEATED_LOBBY_ROXAS)
        } else {
            checkplayergender
            if(var(VAR_RESULT) == MALE) {
                msgbox(format("Mamita lo que me imaginaba… El poder de este bicho es de otro planeta, ni vos que sos el campeón te la bancaste."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
            } else {
                msgbox(format("Mamita lo que me imaginaba… El poder de este bicho es de otro planeta, ni vos que sos la campeona te la bancaste."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
            }
            playse(SE_PIN)
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_SweatDropWithDelay48)
            msgbox(format("Si algún día te das una vuelta por el Archipiélago Suzuka, anda con cuidado maquina, porque allá este no te perdona ni media.\pSuerte la próxima."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
        }
        call(Achievements_EventScript_Eval_DefeatAllAdmins)
        call(WahRoomsShared_EventScript_AfterBattle)
        release
        end
    } else {
        msgbox(format("No te molestes en preguntar… A mí tampoco me dejan pasar estos…"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
        playse(SE_PIN)
        applymovementandwait(VAR_LAST_TALKED, Common_Movement_AnnoyedWithDelay48)
        delay(20)
        msgbox(format("Dicen que haber sido Líder de WAH en el Archipiélago Suzuka durante solo dos semanas no es “trayectoria suficiente” para participar."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
        delay(20)
        playse(SE_PIN)
        applymovementandwait(VAR_LAST_TALKED, Common_Movement_Angry)
        playse(SE_LEDGE)
        applymovementandwait(VAR_LAST_TALKED, moves(lock_facing_direction, jump_in_place_down))
        playse(SE_LEDGE)
        applymovementandwait(VAR_LAST_TALKED, moves(jump_in_place_down, unlock_facing_direction, face_player, delay_16 * 2))
        msgbox(format("¡Unos caraduras, loco!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
        lock
        delay(20)
        msgbox(format("Pero bueno, tampoco me voy a quedar acá llorando.\pEstoy tras un barco que desapareció al oeste de las Islas Naranja, el archipiélago Suzuka.\pEl Team Rocket anda haciendo de las suyas y dicen que hay un bicho oscuro con ojos rojos que es un peligro… aterrador…\pHabrá que investigar y ver qué onda…"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
        call(Lobby_EventScript_WalkInPlaceLastTalkedFacingPlayer)
        msgbox(format("Che, discúlpame, mejor me voy a seguir con mis investigaciones.\p¡Suerte, espero que a vos sí te den bola!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_ROXAS)
        release
        end
    }
}



text Lobby_Text_Roxas_PlayerCancelled {
    format("¿Así que le tenés miedo a mi bicho legendario? ¡Y aún así ganaste las salas!")
}

script Lobby_EventScript_WalkInPlaceLastTalkedFacingPlayer {
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    switch(var(VAR_RESULT)) {
        case DIR_NORTH:
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_WalkInPlaceDown)
            break
        case DIR_SOUTH:
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_WalkInPlaceUp)
            break
        case DIR_WEST:
            applymovementandwait(VAR_LAST_TALKED,Common_Movement_WalkInPlaceRight)
            break
        case DIR_EAST:
            applymovementandwait(VAR_LAST_TALKED, Common_Movement_WalkInPlaceLeft)
            break
    }
    return
}


script Lobby_EventScript_FakemonDexMenu {
    lock
    faceplayer
    msgbox(format("Soy el experto en las especies exclusivas de Whack a Hack.\pTe revelaré todo sobre ellas, pero solo de las que hayas visto.\p¡No quiero arruinar el factor sorpresa!"), MSGBOX_AUTOCLOSE)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_SweatDropWithDelay48)
    goto(Lobby_EventScript_FakemonDexMenu_ChooseSpecies)
}

script Lobby_EventScript_FakemonDexMenu_ChooseSpecies {
    setvar(VAR_0x8000, 0)
    getseenmon(SPECIES_KAOSUNE)
    if(var(VAR_RESULT) != 0) {
        bufferspeciesname(STR_VAR_1, SPECIES_KAOSUNE)
        dynmultipush(gStringVar1, 0)
        addvar(VAR_0x8000, 1)
    }
    getseenmon(SPECIES_FREECH)
    if(var(VAR_RESULT) != 0) {
        bufferspeciesname(STR_VAR_1, SPECIES_FREECH)
        dynmultipush(gStringVar1, 1)
        addvar(VAR_0x8000, 1)
    }
    getseenmon(SPECIES_PLUGOINK)
