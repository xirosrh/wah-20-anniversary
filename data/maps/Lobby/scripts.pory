script Lobby_EventScript_BetaMonQuestionnaire_Latiken {
    msgbox(format("Adivina, adivinanza.\p¿Qué Pokémon hace este grito?"), MSGBOX_AUTOCLOSE)
    playmoncry(SPECIES_JIRACHI, CRY_MODE_NORMAL)
    waitmoncry
    message(format("¿Quién fue?"))
    waitmessage
    dynmultipush(format("Jirachi"), 0)
    dynmultipush(format("Celebi"), 1)
    dynmultipush(format("Mew"), 2)
    dynmultipush(format("Deoxys"), 3)
    dynmultistack(0, 0, TRUE, 4, 0, 0, DYN_MULTICHOICE_CB_NONE)
    closemessage
    if(var(VAR_RESULT) != 0) {
        msgbox(Lobby_Text_FailedToUnlock, MSGBOX_AUTOCLOSE)
        return
    }

    msgbox(format("Oh, correcto. Ahora mismo intenta adivinar este."), MSGBOX_AUTOCLOSE)
    playmoncry(SPECIES_LATIAS, CRY_MODE_NORMAL)
    waitmoncry
    message(format("¿Quién fue?"))
    waitmessage
    dynmultipush(format("Latios"), 0)
    dynmultipush(format("Latias"), 1)
    dynmultipush(format("Altaria"), 2)
    dynmultipush(format("Flygon"), 3)
    dynmultistack(0, 0, TRUE, 4, 0, 0, DYN_MULTICHOICE_CB_NONE)
    closemessage
    if(var(VAR_RESULT) != 1) {
        msgbox(Lobby_Text_FailedToUnlock, MSGBOX_AUTOCLOSE)
        return
    }

    msgbox(format("Oh, volviste a acertar. Ahora este."), MSGBOX_AUTOCLOSE)
    playmoncry(SPECIES_BLAZIKEN, CRY_MODE_NORMAL)
    waitmoncry
    message(format("¿Quién fue?"))
    waitmessage
    dynmultipush(format("Blaziken"), 0)
    dynmultipush(format("Combusken"), 1)
    dynmultipush(format("Infernape"), 2)
    dynmultipush(format("Lucario"), 3)
    dynmultistack(0, 0, TRUE, 4, 0, 0, DYN_MULTICHOICE_CB_NONE)
    closemessage
    if(var(VAR_RESULT) == 0) {
        setflag(FLAG_POKEBOX_UNLOCK_BETA_LATIKEN)
        msgbox(format("Increíble, acertaste otra vez. Es impresionante.\pTen esto."), MSGBOX_AUTOCLOSE)
        call(Pokebox_EventScript_ShowUnlocks)
    } else {
        msgbox(Lobby_Text_FailedToUnlock, MSGBOX_AUTOCLOSE)
    }
    return
}

text Lobby_Text_FailedToUnlock {
    format("Oh, ¡fallaste!")
}

script Lobby_EventScript_Pokebox {
    setvar(VAR_TEMP_C, 8)
    setvar(VAR_TEMP_D, 3)
    setvar(VAR_TEMP_E, METATILE_lobby_PC_OFF)
    setvar(VAR_TEMP_F, METATILE_lobby_PC_ON)
    call(WahRoomsShared_EventScript_Pokebox)
    end
}

script Lobby_EventScript_Turbo {
    msgbox(format("¿Sabías que existe un modo turbo para vivir la aventura a toda velocidad?\pDesde el menú de opciones puedes configurar tu velocidad de texto, de caminar, ¡y un turbo para los combates!\p¿Te animas a probarlo?"), MSGBOX_NPC)
    end
}

script Lobby_EventScript_Notes {
    msgbox(format("Parecen apuntes llenos de estadísticas y observaciones.\pAlgunas páginas están tan gastadas que cuesta leerlas."), MSGBOX_SIGN)
    end
}