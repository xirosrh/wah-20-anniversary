            setvar(VAR_0x8004, SPECIES_GRITESPEC)
            call(Lobby_EventScript_ShowFakemonDexInfo)
        case 4:
            showmonpic(SPECIES_MAGIKEN, 10, 3)
            setvar(VAR_0x8004, SPECIES_MAGIKEN)
            call(Lobby_EventScript_ShowFakemonDexInfo)
        case 5:
            showmonpic(SPECIES_AYEWIRAZ, 10, 3)
            setvar(VAR_0x8004, SPECIES_AYEWIRAZ)
            call(Lobby_EventScript_ShowFakemonDexInfo)
        case 6:
            showmonpic(SPECIES_JARDINO, 10, 3)
            setvar(VAR_0x8004, SPECIES_JARDINO)
            call(Lobby_EventScript_ShowFakemonDexInfo)
        case 7:
            showmonpic(SPECIES_OCEADINO, 10, 3)
            setvar(VAR_0x8004, SPECIES_OCEADINO)
            call(Lobby_EventScript_ShowFakemonDexInfo)
        case 8:
            showmonpic(SPECIES_TYRADINO, 10, 3)
            setvar(VAR_0x8004, SPECIES_TYRADINO)
            call(Lobby_EventScript_ShowFakemonDexInfo)
        case 9:
            showmonpic(SPECIES_ELECTRODES, 10, 3)
            setvar(VAR_0x8004, SPECIES_ELECTRODES)
            call(Lobby_EventScript_ShowFakemonDexInfo)
        case 10:
            showmonpic(SPECIES_EING, 10, 3)
            setvar(VAR_0x8004, SPECIES_EING)
            call(Lobby_EventScript_ShowFakemonDexInfo)
        case 11:
            showmonpic(SPECIES_MICAEL, 10, 3)
            setvar(VAR_0x8004, SPECIES_MICAEL)
            call(Lobby_EventScript_ShowFakemonDexInfo)
        case 12:
            showmonpic(SPECIES_MOLIKAI, 10, 3)
            setvar(VAR_0x8004, SPECIES_MOLIKAI)
            call(Lobby_EventScript_ShowFakemonDexInfo)
        case 13:
            showmonpic(SPECIES_DIRAEI, 10, 3)
            setvar(VAR_0x8004, SPECIES_DIRAEI)
            call(Lobby_EventScript_ShowFakemonDexInfo)
        case 14:
            showmonpic(SPECIES_LUGIA_SHADOW, 10, 3)
            setvar(VAR_0x8004, SPECIES_LUGIA_SHADOW)
            call(Lobby_EventScript_ShowFakemonDexInfo)
    }
    goto(Lobby_EventScript_FakemonDexMenu_ChooseSpecies)
}

script Lobby_EventScript_ShowFakemonDexInfo {
    special(BufferSpeciesDexDescriptionForTextbox)
    msgbox(format("Ya que no tienes una Pokédex, su descripción es:{FONT_SMALL}\p“{STR_VAR_1}”"))
    special(BufferSpeciesTypeNames)
    if(var(VAR_RESULT) == 1) {
        msgbox("Su tipo es: {STR_VAR_2}.")
    } else {
        msgbox("Sus tipos son: {STR_VAR_2} y {STR_VAR_3}.")
    }
    msgbox("¡Y esto seguramente no lo sabías!\nSus habilidades son:")
    setvar(VAR_0x8005, 0)
    special(BufferSpeciesAbilityNameAndDescription)
    if(var(VAR_RESULT) != 0) {
        msgbox(format("{STR_VAR_1}:\n{FONT_SMALL}“{STR_VAR_2}”"))
    }
    setvar(VAR_0x8005, 1)
    special(BufferSpeciesAbilityNameAndDescription)
    if(var(VAR_RESULT) != 0) {
        msgbox(format("{STR_VAR_1}:\n{FONT_SMALL}“{STR_VAR_2}”"))
    }
    setvar(VAR_0x8005, 2)
    special(BufferSpeciesAbilityNameAndDescription)
    if(var(VAR_RESULT) != 0) {
        msgbox(format("{STR_VAR_1}:\n{FONT_SMALL}“{STR_VAR_2}”"))
    }
    special(BufferSpeciesStats)
    msgbox(format("¡Último dato! ¿Qué tan buenos son sus stats base?\p{FONT_SMALL}{STR_VAR_1}"))
    hidemonpic()
    bufferspeciesname(STR_VAR_1, VAR_0x8004)
    msgbox("Y eso es todo sobre {STR_VAR_1}.\nEspero que te haya resultado útil.")
    return
}

script Lobby_EventScript_TrainerCardGirl {
    msgbox(format("¿Sabías que en la parte de atrás de tu tarjeta de entrenador puedes ver tus logros?\p¡También puedes ver los requerimientos para obtener cada uno!"), MSGBOX_NPC)
    end
}

script Lobby_EventScript_Cope {
    lock
    faceplayer
    checkitem(ITEM_DEVON_SCOPE)
    if(var(VAR_RESULT))
    {
        msgbox(format("¡Hola {PLAYER}!\p¿Estás list{OA} para intentar el desafío?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
        playse(SE_PIN)
        applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_SmileWithDelay48)
        msgbox(format("¿Y ya has podido encontrar a Tile?\pDebe encontrarse en alguna sala... ¡Es tan escurridizo!\pRecuerda que puedes usar el Detector Devon para encontrarlo.\p¡Seguro cada vez que lo encuentres te dará un premio!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
    }
    else
    {
        msgbox(format("¡Hola {PLAYER}!\p¿Has visto a Tile?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
        playse(SE_PIN)
        applymovementandwait(LOCALID_PLAYER, moves(emote_question_mark))
        waitse
        msgbox(format("¿Cómo? ¿No sabes quién es?\nEs mi famoso Kecleon.\pLo he perdido de vista y no sé por dónde se ha metido...\pAdemás, ¡me ha robado el kit de objetos que le doy a los entrenadores del desafío!\pHazme un favor y búscale por mí.\nToma, llévate esto."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
        delay(10)
        giveitem(ITEM_DEVON_SCOPE)
        closemessage
        delay(20)
        msgbox(format("Con el Detector Devon podrás ver dónde se esconde Tile.\pLe he agregado una nueva característica que permite saber si hay un Pokémon invisible cerca.\p¡Espero lo encuentres!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
    }
    release
    end
}

script Lobby_EventScript_QREventInfoKid {
    lock
    faceplayer
    msgbox(format("Un chico de la zona creativa te da un regalo por completar un evento especial.\pEs imposible adivinar lo que hay que hacer sin mirar el vídeo.\p¡Incluso tuve que cambiar de orden a dos de los Pokémon de mi equipo!\pEso sí, me gustó el premio por completar el evento, ¡valió la pena!"), MSGBOX_AUTOCLOSE)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_HappyWithDelay48)
    release
    end
}

script Lobby_EventScript_BetaMonQuestionnaire {
    lock
    faceplayer
    msgbox(format("¡Buenas! Soy el maestro de los cuestionarios."), MSGBOX_AUTOCLOSE)
    special(Special_BufferBetaMonQuestionnaireCounters)
    if(var(VAR_WAH_CHALLENGE_COMPLETION_COUNT) == 0) {
        playse(SE_PIN)
        applymovementandwait(VAR_LAST_TALKED, Common_Movement_Surprise)
        msgbox(format("Así que aún no has completado el desafío.\l...\l...\pCuando lo superes, vuelve y te haré un cuestionario especial."), MSGBOX_AUTOCLOSE)
        release
        end
    }
    delay(20)
    setvar(VAR_TEMP_0, 0)
    specialvar(VAR_RESULT, Special_TryPickBetaMonQuestion)
    switch(var(VAR_RESULT)) {
        case BETA_MON_QUESTION_PICK_QUESTION:
            msgbox(format("Te haré una pregunta por cada vez que hayas completado el desafío.\pHas completado el desafío {STR_VAR_1} veces.\pYa te hice {STR_VAR_2} preguntas.\pTe quedan {STR_VAR_3} intentos disponibles.\p¿Quieres que te haga una pregunta?"), MSGBOX_YESNO)
            if(var(VAR_RESULT) == YES) {
                goto(Lobby_EventScript_BetaMonQuestionnaire_AskPickedQuestion)
            } else {
                goto(Lobby_EventScript_BetaMonQuestionnaire_SeeYouLater)
            }
        case BETA_MON_QUESTION_PICK_ALL_UNLOCKED:
           goto(Lobby_EventScript_BetaMonQuestionnaire_NoMoreQuestions)
        default:
           goto(Lobby_EventScript_BetaMonQuestionnaire_NoAttemptsLeft)
    }
}

script Lobby_EventScript_BetaMonQuestionnaire_NoAttemptsLeft {
     msgbox(format("Has completado el desafío {STR_VAR_1} veces.\pYa te hice {STR_VAR_2} preguntas.\pTe quedan {STR_VAR_3} intentos disponibles.\pCompleta el desafío otra vez y vuelve por aquí."), MSGBOX_AUTOCLOSE)
    release
    end
}

script Lobby_EventScript_BetaMonQuestionnaire_NoMoreQuestions {
     msgbox(format("¡Ya has respondido todas mis preguntas! ¿Qué te parecen los Pokémon que has conseguido?"), MSGBOX_AUTOCLOSE)
    release
    end
}

script Lobby_EventScript_BetaMonQuestionnaire_SeeYouLater {
    msgbox(format("De acuerdo. Puedes volver cuando quieras."), MSGBOX_AUTOCLOSE)
    release
    end
}

script Lobby_EventScript_BetaMonQuestionnaire_NextQuestion {
    special(Special_BufferBetaMonQuestionnaireCounters)
    specialvar(VAR_RESULT, Special_TryPickBetaMonQuestion)
    switch(var(VAR_RESULT)) {
        case BETA_MON_QUESTION_PICK_QUESTION:
            msgbox(format("Has completado el desafío {STR_VAR_1} veces.\pYa te hice {STR_VAR_2} preguntas.\pTe quedan {STR_VAR_3} intentos disponibles.\p¿Quieres seguir respondiendo?"), MSGBOX_YESNO)
            if(var(VAR_RESULT) == YES) {
                goto(Lobby_EventScript_BetaMonQuestionnaire_AskPickedQuestion)
            }
            goto(Lobby_EventScript_BetaMonQuestionnaire_SeeYouLater)
        case BETA_MON_QUESTION_PICK_ALL_UNLOCKED:
            goto(Lobby_EventScript_BetaMonQuestionnaire_NoMoreQuestions)
        case BETA_MON_QUESTION_PICK_NONE_THIS_TALK:
            msgbox(format("Has completado el desafío {STR_VAR_1} veces.\pYa te hice {STR_VAR_2} preguntas.\pTe quedan {STR_VAR_3} intentos disponibles.\pPor ahora no tengo más preguntas distintas para hacerte.\pVuelve a hablarme en otro momento."), MSGBOX_AUTOCLOSE)
            release
            end
        default:
            goto(Lobby_EventScript_BetaMonQuestionnaire_NoAttemptsLeft)
    }
}

script Lobby_EventScript_BetaMonQuestionnaire_AskPickedQuestion {
    addvar(VAR_BETA_MON_QUESTIONNAIRE_ASK_COUNT, 1)
    switch(var(VAR_0x8004)) {
        case BETA_MON_QUESTION_GOROCHU:
            call(Lobby_EventScript_BetaMonQuestionnaire_Gorochu)
            break
        case BETA_MON_QUESTION_TAABAN:
            call(Lobby_EventScript_BetaMonQuestionnaire_Taaban)
            break
        case BETA_MON_QUESTION_BOMUSHIKAA:
            call(Lobby_EventScript_BetaMonQuestionnaire_Bomushikaa)
            break
        case BETA_MON_QUESTION_MADAAMU:
            call(Lobby_EventScript_BetaMonQuestionnaire_Madaamu)
            break
        case BETA_MON_QUESTION_AKUERIA:
            call(Lobby_EventScript_BetaMonQuestionnaire_Akueria)
            break
        case BETA_MON_QUESTION_LATIKEN:
            call(Lobby_EventScript_BetaMonQuestionnaire_Latiken)
            break
    }
    goto(Lobby_EventScript_BetaMonQuestionnaire_NextQuestion)
}

script Lobby_EventScript_BetaMonQuestionnaire_Gorochu {
    message(format("¿Qué Pokémon es naranja, tiene una cola larga y a todo el mundo le encanta el que evoluciona en él?"))
    waitmessage
    dynmultipush(format("Raichu"), 0)
    dynmultipush(format("Arcanine"), 1)
    dynmultipush(format("Floatzel"), 2)
    dynmultipush(format("Simisear"), 3)
    dynmultistack(0, 0, FALSE, 4, 0, 0, DYN_MULTICHOICE_CB_NONE)
    closemessage
    if(var(VAR_RESULT) == 0) {
        setflag(FLAG_POKEBOX_UNLOCK_BETA_GOROCHU)
        msgbox(format("Pues con este Pokémon te encontrarás."), MSGBOX_AUTOCLOSE)
        call(Pokebox_EventScript_ShowUnlocks)
    } else {
        msgbox(Lobby_Text_FailedToUnlock, MSGBOX_AUTOCLOSE)
    }
    return
}

