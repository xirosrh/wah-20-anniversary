            setvar(VAR_0x8004, SPECIES_AYEWIRAZ)
            call(Lobby_EventScript_ShowFakemonDexInfo)
        case 6:
            showmonpic(SPECIES_JARDINO, 10, 3)
            setvar(VAR_0x8004, SPECIES_JARDINO)
            call(Lobby_EventScript_ShowFakemonDexInfo)
        case 7:
            showmonpic(SPECIES_OCEADINO, 10, 3)
            setvar(VAR_0x8004, SPECIES_OCEADINO)
            call(Lobby_EventScript_ShowFakemonDexInfo)
        case 8:
            showmonpic(SPECIES_TYRADINO, 10, 3)
            setvar(VAR_0x8004, SPECIES_TYRADINO)
            call(Lobby_EventScript_ShowFakemonDexInfo)
        case 9:
            showmonpic(SPECIES_ELECTRODES, 10, 3)
            setvar(VAR_0x8004, SPECIES_ELECTRODES)
            call(Lobby_EventScript_ShowFakemonDexInfo)
        case 10:
            showmonpic(SPECIES_EING, 10, 3)
            setvar(VAR_0x8004, SPECIES_EING)
            call(Lobby_EventScript_ShowFakemonDexInfo)
        case 11:
            showmonpic(SPECIES_MICAEL, 10, 3)
            setvar(VAR_0x8004, SPECIES_MICAEL)
            call(Lobby_EventScript_ShowFakemonDexInfo)
        case 12:
            showmonpic(SPECIES_MOLIKAI, 10, 3)
            setvar(VAR_0x8004, SPECIES_MOLIKAI)
            call(Lobby_EventScript_ShowFakemonDexInfo)
        case 13:
            showmonpic(SPECIES_DIRAEI, 10, 3)
            setvar(VAR_0x8004, SPECIES_DIRAEI)
            call(Lobby_EventScript_ShowFakemonDexInfo)
        case 14:
            showmonpic(SPECIES_LUGIA_SHADOW, 10, 3)
            setvar(VAR_0x8004, SPECIES_LUGIA_SHADOW)
            call(Lobby_EventScript_ShowFakemonDexInfo)
    }
    goto(Lobby_EventScript_FakemonDexMenu_ChooseSpecies)
}

script Lobby_EventScript_ShowFakemonDexInfo {
    special(BufferSpeciesDexDescriptionForTextbox)
    msgbox(format("Since you don't have a Pokédex, its description is:{FONT_SMALL}\p“{STR_VAR_1}”"))
    special(BufferSpeciesTypeNames)
    if(var(VAR_RESULT) == 1) {
        msgbox("Its type is: {STR_VAR_2}.")
    } else {
        msgbox("Its types are: {STR_VAR_2} and {STR_VAR_3}.")
    }
    msgbox("And I bet you didn't know this!\nIts abilities are:")
    setvar(VAR_0x8005, 0)
    special(BufferSpeciesAbilityNameAndDescription)
    if(var(VAR_RESULT) != 0) {
        msgbox(format("{STR_VAR_1}:\n{FONT_SMALL}“{STR_VAR_2}”"))
    }
    setvar(VAR_0x8005, 1)
    special(BufferSpeciesAbilityNameAndDescription)
    if(var(VAR_RESULT) != 0) {
        msgbox(format("{STR_VAR_1}:\n{FONT_SMALL}“{STR_VAR_2}”"))
    }
    setvar(VAR_0x8005, 2)
    special(BufferSpeciesAbilityNameAndDescription)
    if(var(VAR_RESULT) != 0) {
        msgbox(format("{STR_VAR_1}:\n{FONT_SMALL}“{STR_VAR_2}”"))
    }
    special(BufferSpeciesStats)
    msgbox(format("One last fact! How good are its base stats?\p{FONT_SMALL}{STR_VAR_1}"))
    hidemonpic()
    bufferspeciesname(STR_VAR_1, VAR_0x8004)
    msgbox("And that's all about {STR_VAR_1}.\nHope you found it useful.")
    return
}

script Lobby_EventScript_TrainerCardGirl {
    msgbox(format("Did you know that on the back of your Trainer Card you can see your achievements?\pYou can also see the requirements for earning each one!"), MSGBOX_NPC)
    end
}

script Lobby_EventScript_Cope {
    lock
    faceplayer
    checkitem(ITEM_DEVON_SCOPE)
    if(var(VAR_RESULT))
    {
        msgbox(format("Hi {PLAYER}!\pAre you ready to take on the challenge?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
        playse(SE_PIN)
        applymovementandwait(LOCALID_LOBBY_COPE, Common_Movement_SmileWithDelay48)
        msgbox(format("Have you managed to find Tile yet?\pHe must be in one of the rooms... He's so slippery!\pRemember you can use the Devon Detector to find him.\pI bet every time you find him he'll give you a prize!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
    }
    else
    {
        msgbox(format("Hi {PLAYER}!\pHave you seen Tile?"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
        playse(SE_PIN)
        applymovementandwait(LOCALID_PLAYER, moves(emote_question_mark))
        waitse
        msgbox(format("What? You don't know who he is?\nHe's my famous Kecleon.\pI've lost sight of him and have no idea where he's gotten to...\pOn top of that, he stole the item kit I give to the challenge's trainers!\pDo me a favor and look for him.\nHere, take this."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
        delay(10)
        giveitem(ITEM_DEVON_SCOPE)
        closemessage
        delay(20)
        msgbox(format("With the Devon Scope you can see where Tile is hiding.\pI've added a new feature that tells you if there's an invisible Pokémon nearby.\pHope you find him!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_COPE)
    }
    release
    end
}

script Lobby_EventScript_QREventInfoKid {
    lock
    faceplayer
    msgbox(format("A guy in the Creative Zone gives you a gift for completing a special event.\pThere's no way to guess what you have to do without watching the video.\pI even had to reorder two of the Pokémon on my team!\pThat said, I liked the reward for the event, it was worth it!"), MSGBOX_AUTOCLOSE)
    playse(SE_PIN)
    applymovementandwait(VAR_LAST_TALKED, Common_Movement_HappyWithDelay48)
    release
    end
}

script Lobby_EventScript_BetaMonQuestionnaire {
    lock
    faceplayer
    msgbox(format("Hey there! I'm the quiz master."), MSGBOX_AUTOCLOSE)
    special(Special_BufferBetaMonQuestionnaireCounters)
    if(var(VAR_WAH_CHALLENGE_COMPLETION_COUNT) == 0) {
        playse(SE_PIN)
        applymovementandwait(VAR_LAST_TALKED, Common_Movement_Surprise)
        msgbox(format("So you haven't completed the challenge yet.\l...\l...\pWhen you beat it, come back and I'll give you a special quiz."), MSGBOX_AUTOCLOSE)
        release
        end
    }
    delay(20)
    setvar(VAR_TEMP_0, 0)
    specialvar(VAR_RESULT, Special_TryPickBetaMonQuestion)
    switch(var(VAR_RESULT)) {
        case BETA_MON_QUESTION_PICK_QUESTION:
            msgbox(format("I'll ask one question for each time you've completed the challenge.\pYou've completed the challenge {STR_VAR_1} times.\pI've already asked you {STR_VAR_2} questions.\pYou have {STR_VAR_3} attempts left.\pWant me to ask you a question?"), MSGBOX_YESNO)
            if(var(VAR_RESULT) == YES) {
                goto(Lobby_EventScript_BetaMonQuestionnaire_AskPickedQuestion)
            } else {
                goto(Lobby_EventScript_BetaMonQuestionnaire_SeeYouLater)
            }
        case BETA_MON_QUESTION_PICK_ALL_UNLOCKED:
           goto(Lobby_EventScript_BetaMonQuestionnaire_NoMoreQuestions)
        default:
           goto(Lobby_EventScript_BetaMonQuestionnaire_NoAttemptsLeft)
    }
}

script Lobby_EventScript_BetaMonQuestionnaire_NoAttemptsLeft {
     msgbox(format("You've completed the challenge {STR_VAR_1} times.\pI've already asked you {STR_VAR_2} questions.\pYou have {STR_VAR_3} attempts left.\pComplete the challenge again and come back here."), MSGBOX_AUTOCLOSE)
    release
    end
}

script Lobby_EventScript_BetaMonQuestionnaire_NoMoreQuestions {
     msgbox(format("You've already answered all my questions! What do you think of the Pokémon you've gotten?"), MSGBOX_AUTOCLOSE)
    release
    end
}

script Lobby_EventScript_BetaMonQuestionnaire_SeeYouLater {
    msgbox(format("All right. Come back whenever you like."), MSGBOX_AUTOCLOSE)
    release
    end
}

script Lobby_EventScript_BetaMonQuestionnaire_NextQuestion {
    special(Special_BufferBetaMonQuestionnaireCounters)
    specialvar(VAR_RESULT, Special_TryPickBetaMonQuestion)
    switch(var(VAR_RESULT)) {
        case BETA_MON_QUESTION_PICK_QUESTION:
            msgbox(format("You've completed the challenge {STR_VAR_1} times.\pI've already asked you {STR_VAR_2} questions.\pYou have {STR_VAR_3} attempts left.\pWant to keep answering?"), MSGBOX_YESNO)
            if(var(VAR_RESULT) == YES) {
                goto(Lobby_EventScript_BetaMonQuestionnaire_AskPickedQuestion)
            }
            goto(Lobby_EventScript_BetaMonQuestionnaire_SeeYouLater)
        case BETA_MON_QUESTION_PICK_ALL_UNLOCKED:
            goto(Lobby_EventScript_BetaMonQuestionnaire_NoMoreQuestions)
        case BETA_MON_QUESTION_PICK_NONE_THIS_TALK:
            msgbox(format("You've completed the challenge {STR_VAR_1} times.\pI've already asked you {STR_VAR_2} questions.\pYou have {STR_VAR_3} attempts left.\pFor now I don't have any more new questions for you.\pCome talk to me another time."), MSGBOX_AUTOCLOSE)
            release
            end
        default:
            goto(Lobby_EventScript_BetaMonQuestionnaire_NoAttemptsLeft)
    }
}

script Lobby_EventScript_BetaMonQuestionnaire_AskPickedQuestion {
    addvar(VAR_BETA_MON_QUESTIONNAIRE_ASK_COUNT, 1)
    switch(var(VAR_0x8004)) {
        case BETA_MON_QUESTION_GOROCHU:
            call(Lobby_EventScript_BetaMonQuestionnaire_Gorochu)
            break
        case BETA_MON_QUESTION_TAABAN:
            call(Lobby_EventScript_BetaMonQuestionnaire_Taaban)
            break
        case BETA_MON_QUESTION_BOMUSHIKAA:
            call(Lobby_EventScript_BetaMonQuestionnaire_Bomushikaa)
            break
        case BETA_MON_QUESTION_MADAAMU:
            call(Lobby_EventScript_BetaMonQuestionnaire_Madaamu)
            break
        case BETA_MON_QUESTION_AKUERIA:
            call(Lobby_EventScript_BetaMonQuestionnaire_Akueria)
            break
        case BETA_MON_QUESTION_LATIKEN:
            call(Lobby_EventScript_BetaMonQuestionnaire_Latiken)
            break
    }
    goto(Lobby_EventScript_BetaMonQuestionnaire_NextQuestion)
}

script Lobby_EventScript_BetaMonQuestionnaire_Gorochu {
    message(format("Which Pokémon is orange, has a long tail, and everyone loves the one it evolves into?"))
    waitmessage
    dynmultipush(format("Raichu"), 0)
    dynmultipush(format("Arcanine"), 1)
    dynmultipush(format("Floatzel"), 2)
    dynmultipush(format("Simisear"), 3)
    dynmultistack(0, 0, FALSE, 4, 0, 0, DYN_MULTICHOICE_CB_NONE)
    closemessage
    if(var(VAR_RESULT) == 0) {
        setflag(FLAG_POKEBOX_UNLOCK_BETA_GOROCHU)
        msgbox(format("Well, this is the Pokémon you'll meet."), MSGBOX_AUTOCLOSE)
        call(Pokebox_EventScript_ShowUnlocks)
    } else {
        msgbox(Lobby_Text_FailedToUnlock, MSGBOX_AUTOCLOSE)
    }
    return
}

