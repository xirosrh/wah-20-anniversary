script Lobby_EventScript_BetaMonQuestionnaire_Madaamu {
    message(format("El Capitán Puerro blande su espada en el bosque.\p¿Quién es realmente el Capitán Puerro?"))
    waitmessage
    dynmultipush(format("Kartana"), 0)
    dynmultipush(format("Gallade"), 1)
    dynmultipush(format("Farfetch'd"), 2)
    dynmultipush(format("Scyther"), 3)
