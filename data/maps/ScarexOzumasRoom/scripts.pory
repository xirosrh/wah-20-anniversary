const VAR_TEMP_0_ADMINS_IN_ROOM = VAR_TEMP_0

mapscripts ScarexOzumasRoom_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: ScarexOzumasRoom_OnTransition
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_8, 0: ScarexOzumasRoom_OnWarp_PlayerTurnNorth
    ]
    MAP_SCRIPT_ON_LOAD: ScarexOzumasRoom_OnLoad
}


script ScarexOzumasRoom_OnLoad {
    if(flag(FLAG_DEFEATED_ADMIN_OZUMAS) && flag(FLAG_DEFEATED_ADMIN_SCAREX)){
        call(WahRoomsShared_SetDoorAsOpen)
    }
    end
}

script ScarexOzumasRoom_OnWarp_PlayerTurnNorth {
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    end
}
script ScarexOzumasRoom_OnTransition {
    call(WahRoomsShared_Kecleon_SetSala_ScarexOzumas)
    if(var(VAR_TEMP_0_ADMINS_IN_ROOM) == 1) {
        setobjectmovementtype(LOCALID_SCAREXOZUROOM_OZUMAS, MOVEMENT_TYPE_FACE_DOWN)
        setobjectmovementtype(LOCALID_SCAREXOZUROOM_SCAREX, MOVEMENT_TYPE_FACE_DOWN)
        setobjectxy(LOCALID_SCAREXOZUROOM_OZUMAS, 8, 5)
        setobjectxyperm(LOCALID_SCAREXOZUROOM_OZUMAS, 8, 5)
    }
    end
}

script ScarexOzumasRoom_EventScript_EnterRoom {
    lock
    getplayerxy(VAR_TEMP_A, VAR_TEMP_B)
    special(SpawnCameraObject)
    directcameramovementtopos(6,5)
    waitmovement(0)
    call(WahRoomsShared_OpenDoor)
    delay(20)
    showobjectat(LOCALID_SCAREXOZUROOM_OZUMAS, MAP_SCAREX_OZUMAS_ROOM)
    setobjectmovementtype(LOCALID_SCAREXOZUROOM_OZUMAS, MOVEMENT_TYPE_FACE_DOWN)
    setobjectmovementtype2(LOCALID_SCAREXOZUROOM_OZUMAS, MOVEMENT_TYPE_FACE_DOWN)
    applymovementandwait(LOCALID_SCAREXOZUROOM_OZUMAS, Common_Movement_WalkDown)
    delay(20)
    call(WahRoomsShared_CloseDoor)
    applymovementandwait(LOCALID_SCAREXOZUROOM_OZUMAS, moves(
        walk_down
        walk_right
        walk_down
        walk_right 
        face_down
        delay_8
        face_right
        delay_8
        face_up
        delay_8
        face_left
        delay_8
        face_down
    ))
    setobjectxyperm(LOCALID_SCAREXOZUROOM_OZUMAS, 8, 5)
    playse(SE_PIN)
    applymovementandwait(LOCALID_SCAREXOZUROOM_OZUMAS, Common_Movement_QuestionMark)
    msgbox(format("Where's Scarex? He should already be here."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_OZUMAS)
    delay(48)
    waitse
    playse(SE_FALL)
    applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, moves(
        fly_up
        set_visible
        fall_down
    ))
    waitse
    playse(SE_WALL_HIT)
    waitse
    playse(SE_PIN)
    applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, moves(emote_x))
    waitse
    applymovementandwait(LOCALID_SCAREXOZUROOM_OZUMAS, Common_Movement_FaceLeft)
    applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, moves(
        delay_16 * 3
    ))
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, moves(
        jump_in_place_down_up
        delay_4
    ))
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, moves(
        jump_in_place_up_down
        delay_4
        walk_in_place_down * 2
    ))
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, moves(
        jump_in_place_right_left
        delay_4
    ))
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, moves(
        jump_in_place_left_right
        delay_4
        walk_in_place_right * 2
    ))
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, moves(
        jump_in_place_right_left
        delay_4
        walk_in_place_left * 2
    ))
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, moves(
        jump_in_place_down_up
        delay_4
        walk_in_place_up
    ))
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, moves(
        jump_in_place_up_down
        walk_in_place_down * 2
    ))
    waitse
    playse(SE_PIN)
    applymovementandwait(LOCALID_SCAREXOZUROOM_OZUMAS, Common_Movement_SweatDropWithDelay48)
    delay(20)
    setobjectmovementtype(LOCALID_SCAREXOZUROOM_SCAREX, MOVEMENT_TYPE_FACE_DOWN)
    setobjectmovementtype2(LOCALID_SCAREXOZUROOM_SCAREX, MOVEMENT_TYPE_FACE_DOWN)
    turnobject(LOCALID_SCAREXOZUROOM_OZUMAS, DIR_SOUTH)
    directcameramovementtoposwithvars(VAR_TEMP_A, VAR_TEMP_B)
    waitmovement(0)
    special(RemoveCameraObject)
    setvar(VAR_TEMP_0_ADMINS_IN_ROOM, 1)
    release
    end

}

script ScarexOzumasRoom_EventScript_WalkInPlaceOzumasFacingPlayer {
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    switch(var(VAR_RESULT)) {
        case DIR_NORTH:
            applymovementandwait(LOCALID_SCAREXOZUROOM_OZUMAS, Common_Movement_WalkInPlaceDown)
            break
        case DIR_SOUTH:
            applymovementandwait(LOCALID_SCAREXOZUROOM_OZUMAS, Common_Movement_WalkInPlaceUp)
            break
        case DIR_WEST:
            applymovementandwait(LOCALID_SCAREXOZUROOM_OZUMAS,Common_Movement_WalkInPlaceRight)
            break
        case DIR_EAST:
            applymovementandwait(LOCALID_SCAREXOZUROOM_OZUMAS, Common_Movement_WalkInPlaceLeft)
            break
    }
    return
}

script ScarexOzumasRoom_EventScript_Ozumas {
    if(flag(FLAG_DEFEATED_ADMIN_OZUMAS)){
        lock
        faceplayer
        msgbox(format("Hey, I've been replaying our battle in my head, and I can't lie: you gave me a real thrashing."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_OZUMAS)
        playse(SE_PIN)
        applymovementandwait(LOCALID_SCAREXOZUROOM_OZUMAS, Common_Movement_SweatDropWithDelay48)
        if(!flag(FLAG_DEFEATED_ADMIN_SCAREX)){
            delay(20)
            msgbox(format("You've proven your strength. Now go face Scarex."), speaker = SP_NAME_OZUMAS)
        }
        release
        end
    }
    lock
    faceplayer
    msgbox(format("Well, it seems the moment we had pending has arrived.\pI'm Ozumas, of the blood of the legendary Mendrax dynasty.\pLong ago, we were well known, above all for never backing down from a challenge."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_OZUMAS)
    applymovementandwait(LOCALID_SCAREXOZUROOM_OZUMAS, moves(lock_facing_direction))
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_SCAREXOZUROOM_OZUMAS, moves(jump_in_place_down, unlock_facing_direction, face_player))
    waitse
    delay(20)
    msgbox(format("So you don't know me? Well, don't worry, many years have passed now."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_OZUMAS)
    playse(SE_PIN)
    applymovementandwait(LOCALID_SCAREXOZUROOM_OZUMAS, Common_Movement_SmileWithDelay48)
    msgbox(format("If you want to know something about me, I'll say I've always been drawn to the legends of Johto.\pI spent years trying to tell the world its tales."), MSGBOX_AUTOCLOSE speaker = SP_NAME_OZUMAS)
    call(ScarexOzumasRoom_EventScript_WalkInPlaceOzumasFacingPlayer)
    delay(20)
    if(flag(FLAG_DEFEATED_ADMIN_SCAREX)) {
        msgbox(format("It seems you've already beaten Scarex, so if you manage to defeat me, you can advance."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_OZUMAS)
    } else {
        msgbox(format("If you want to advance, first you'll have to beat both Scarex and me.\pIt seems I'll be your first opponent."), MSGBOX_AUTOCLOSE, speaker = SP_NAME_OZUMAS)
    }
    delay(20)
    msgbox(format("Let's see what story comes out of this battle."), speaker = SP_NAME_OZUMAS)
    call(ScarexOzumasRoom_EventScript_WalkInPlaceOzumasFacingPlayer)
    playse(SE_PIN)
    applymovementandwait(LOCALID_SCAREXOZUROOM_OZUMAS, moves(emote_versus))
    waitse
    call(ScarexOzumasRoom_EventScript_OzumasBattle)
    msgbox(format("You've shown that you have strength and conviction… I congratulate you!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_OZUMAS)
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    playse(SE_PIN)
    if(var(VAR_RESULT) == DIR_NORTH || var(VAR_RESULT) == DIR_SOUTH){
        applymovementandwait(LOCALID_SCAREXOZUROOM_OZUMAS, moves(emote_thinking, walk_left * 2, walk_right * 3, walk_left, face_player))
    } else {
        applymovementandwait(LOCALID_SCAREXOZUROOM_OZUMAS, moves(emote_thinking, walk_up * 2, walk_down * 3, walk_up, face_player))
    }
    msgbox(format("But if you want to win, there's still a long road ahead…"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_OZUMAS)
    call(ScarexOzumasRoom_EventScript_WalkInPlaceOzumasFacingPlayer)
    delay(20)
    if(!flag(FLAG_DEFEATED_ADMIN_SCAREX)) {
        msgbox(format("First, you'll have to face Scarex to advance to the next room."), MSGBOX_AUTOCLOSE,speaker = SP_NAME_OZUMAS)
        call(ScarexOzumasRoom_EventScript_WalkInPlaceOzumasFacingPlayer)

    }
    delay(20)
    msgbox(format("Further on, a battle awaits against someone very close to me.\pHe's a great friend and rival. Maybe you know him - his name is Xiros.\pIt'll be that test that determines whether you can truly win the challenge."), MSGBOX_AUTOCLOSE,speaker = SP_NAME_OZUMAS)
    delay(20)
    applymovementandwait(LOCALID_SCAREXOZUROOM_OZUMAS, moves(lock_facing_direction))
    playse(SE_LEDGE)
    applymovement(LOCALID_SCAREXOZUROOM_OZUMAS, moves(jump_in_place_down))
    waitmovement(0)
    waitse
    playse(SE_LEDGE)
    applymovement(LOCALID_SCAREXOZUROOM_OZUMAS, moves(jump_in_place_down))
    waitmovement(0)
    waitse
    applymovementandwait(LOCALID_SCAREXOZUROOM_OZUMAS, moves(unlock_facing_direction, face_player))
    msgbox(format("I'm sure you'll do great. Good luck!"), MSGBOX_AUTOCLOSE, speaker = SP_NAME_OZUMAS)
    if(flag(FLAG_DEFEATED_ADMIN_SCAREX)) {
        call(WahRoomsShared_OpenDoor)
    }
    setflag(FLAG_DEFEATED_ADMIN_OZUMAS)
    call(WahRoomsShared_EventScript_AfterBattle)
    release
    end
}

script ScarexOzumasRoom_EventScript_OzumasBattle {
    if (!flag(FLAG_WAH_CHALLENGE_COMPLETED)) {
        trainerbattle_no_intro(TRAINER_WAH_ADMIN_OZUMAS_MAIN, ScarexOzumasRoom_Text_OzumasDefeated)
    } else {
        setvar(VAR_0x8004, TEAM_INDEX_OZUMAS)
        special(ShouldUseAlternativeTeam)
        if (var(VAR_RESULT) == 0) {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_OZUMAS_MAIN, ScarexOzumasRoom_Text_OzumasDefeated)
        } else {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_OZUMAS_ALTERNATIVE, ScarexOzumasRoom_Text_OzumasDefeated)
        }
    }
    return
}

text ScarexOzumasRoom_Text_OzumasDefeated {
    format("That was really cool!")
}

script ScarexOzumasRoom_EventScript_Scarex {
    lock
    faceplayer
    if(flag(FLAG_DEFEATED_ADMIN_SCAREX)){
        random(10)
        playse(SE_PIN)
        switch(var(VAR_RESULT)) {
            case 0:
                applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, Common_Movement_SurpriseWithDelay48)
            case 1:
                applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, Common_Movement_SmileWithDelay48)
            case 2:
                applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, Common_Movement_HappyWithDelay48)
            case 3:
                applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, Common_Movement_AngryWithDelay48)
            case 4:
                applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, Common_Movement_HeartWithDelay48)
            case 5:
                applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, Common_Movement_SweatDropWithDelay48)
            case 6:
                applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, Common_Movement_CryWithDelay48)
            case 7:
                applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, Common_Movement_VWithDelay48)
            case 8:
                applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, Common_Movement_ThinkingWithDelay48)
            case 9:
                applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, Common_Movement_SadWithDelay48)
        }
        waitse
        release
        end

    }
    playse(SE_PIN)
    applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, Common_Movement_SurpriseWithDelay48)
    waitse
    delay(20)
    playse(SE_PIN)
    applymovement(LOCALID_SCAREXOZUROOM_SCAREX, Common_Movement_HeartWithDelay48)
    waitmovement(0)
    waitse
    delay(10)
    applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, moves(lock_facing_direction))
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, moves(jump_in_place_down))
    waitse
    playse(SE_LEDGE)
    applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, moves(
        jump_in_place_down
        unlock_facing_direction
    ))
    waitse
    playse(SE_PIN)
    applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, Common_Movement_HappyWithDelay48)
    waitse
    delay(30)
    playse(SE_PIN)
    applymovementandwait(LOCALID_PLAYER, Common_Movement_QuestionMarkWithDelay48)
    waitse
    delay(20)
    playse(SE_PIN)
    applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, Common_Movement_VersusWithDelay48)
    applymovement(LOCALID_SCAREXOZUROOM_SCAREX, moves(lock_facing_direction))
    applymovement(LOCALID_PLAYER, moves(lock_facing_direction))
    waitmovement(0)
    playse(SE_LEDGE)
    applymovement(LOCALID_SCAREXOZUROOM_SCAREX, moves(jump_in_place_down))
    applymovement(LOCALID_PLAYER, moves(jump_in_place_down))
    waitmovement(0)
    waitse
    playse(SE_LEDGE)
    applymovement(LOCALID_SCAREXOZUROOM_SCAREX, moves(
        jump_in_place_down
        unlock_facing_direction
    ))
    applymovement(LOCALID_PLAYER, moves(
        jump_in_place_down
        unlock_facing_direction
    ))
    waitmovement(0)
    waitse
    getdirectiontoface(VAR_RESULT,  LOCALID_PLAYER, LOCALID_SCAREXOZUROOM_SCAREX)
    switch(var(VAR_RESULT)){
        case DIR_NORTH:
            turnobject(LOCALID_PLAYER, DIR_NORTH)
            break
        case DIR_SOUTH:
            turnobject(LOCALID_PLAYER, DIR_SOUTH)
            break
        case DIR_EAST:
            turnobject(LOCALID_PLAYER, DIR_EAST)
            break
        case DIR_WEST:
            turnobject(LOCALID_PLAYER, DIR_WEST)
            break
    }
    call(ScarexOzumasRoom_EventScript_ScarexBattle)
    playse(SE_PIN)
    applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, Common_Movement_VWithDelay48)
    waitse
    if(flag(FLAG_DEFEATED_ADMIN_OZUMAS)) {
        applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, Common_Movement_FaceRight)
        call(WahRoomsShared_OpenDoor)
        delay(20)
        applymovementandwait(LOCALID_SCAREXOZUROOM_SCAREX, Common_Movement_FacePlayer)
    }
    setflag(FLAG_DEFEATED_ADMIN_SCAREX)
    call(WahRoomsShared_EventScript_AfterBattle)
    release
    end
}

script ScarexOzumasRoom_EventScript_ScarexBattle {
    if (!flag(FLAG_WAH_CHALLENGE_COMPLETED)) {
        trainerbattle_no_intro(TRAINER_WAH_ADMIN_SCAREX_MAIN, ScarexOzumasRoom_Text_ScarexDefeated)
    } else {
        setvar(VAR_0x8004, TEAM_INDEX_SCAREX)
        special(ShouldUseAlternativeTeam)
        if (var(VAR_RESULT) == 0) {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_SCAREX_MAIN, ScarexOzumasRoom_Text_ScarexDefeated)
        } else {
            trainerbattle_no_intro(TRAINER_WAH_ADMIN_SCAREX_ALTERNATIVE, ScarexOzumasRoom_Text_ScarexDefeated)
        }
    }
    return
}

text ScarexOzumasRoom_Text_ScarexDefeated {
    format("…")
}

script ScarexOzumasRoom_EventScript_Bellsprout {
    msgbox(format("It looks like a statue stolen from Sprout Tower."), MSGBOX_SIGN)
    end
}